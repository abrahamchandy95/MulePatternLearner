USE GRAPH Mule_Pattern_Learner

/* read_counterparties (B2): who pays each account and whom it pays, how new they are, and
   where its money goes.

   Inputs: t_ms, a Monday at 00:00 UTC; account_ids, the accounts to read, each once;
   hub_accounts, read_hubs' account hubs of the same t.
   Prints: accounts, per account its 12 counterparty columns (docs/features.md, "Account
   node", columns 22 to 33).
   Refuses: invalid_parameters, duplicate_account, unknown_account, invisible_account, and
   invisible_hub (a hub that does not exist at t).

   Victims are first-time payers, and a mule forwards to one fixed account, so the query
   counts the account's counterparties and how new each one is (docs/design.md,
   "read_counterparties (B2): who pays it and whom it pays"):
   - A payer or payee is the account at the other end of a payment in [t - 90 days, t), but
     self-payments. It is new over w (7 or 30 days) when its earliest payment with the
     account in the lookback is in the last w, so a payer older than 90 days that pays again
     reads new, for every account alike. New payers split by is_external, what a bank knows
     about a payer.
   - Every amount is integer cents, floor(amount x 100 + 0.5), summed in INT. Every share is
     0 with an empty denominator, which payers_30d or payees_30d shows.
   - hub_accounts is the only reading of hubs. An installed query drops an id the graph lacks
     from a SET<VERTEX> parameter without a word; such an id can be no payee, so it changes
     nothing. The accounts come as ids, as read_money_flow explains.
   - No value reads the order in which FOREACH walks a heap, so neither an id nor the walk
     decides a value. */
CREATE OR REPLACE QUERY read_counterparties(
    UINT t_ms,
    LIST<STRING> account_ids,
    SET<VERTEX<Account>> hub_accounts
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    /* A payer new over 30 days: the time of its first payment in the lookback, and its id. */
    TYPEDEF TUPLE<UINT ts, STRING id> NewPayer;
    /* The account hubs of t. */
    OrAccum @hub;
    /* Per payer and per payee, by id: its earliest payment with the account in the lookback,
       and its cents over the last 30 days; the payers that are other banks' accounts. */
    MapAccum<STRING, MinAccum<UINT>> @payer_first, @payee_first;
    MapAccum<STRING, SumAccum<INT>> @payer_cents, @payee_cents;
    SetAccum<STRING> @external_payers;
    /* The cents received and sent over the last 30 days, and those sent to account hubs. */
    SumAccum<INT> @received_30d, @sent_30d, @sent_to_hubs_30d;
    /* The first-payment times of the payers new over 30 days, the newest 256 and one more. */
    HeapAccum<NewPayer>(257, ts DESC, id DESC) @new_payers;
    /* The row. */
    SumAccum<INT> @payers_30d, @payees_30d, @new_internal_payers_7d, @new_internal_payers_30d,
      @new_external_payers_7d, @new_external_payers_30d, @new_payees_7d, @new_payees_30d,
      @max_new_payers_24h;
    SumAccum<DOUBLE> @new_payer_share_30d, @top_payee_share_30d, @hub_payee_share_30d;
    /* The request's ids, each once, and how many it gave. */
    SetAccum<STRING> @@ids;
    SumAccum<INT> @@given;
    UINT lookback_ms = 7776000000;

    /* Mondays are 4 days after the Thursday of 1970-01-01, modulo a week. */
    IF t_ms <= lookback_ms OR t_ms % 604800000 != 345600000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    /* The ids: at least one; none twice, which a list keeps and a set would drop; each an
       account of the graph, since to_vertex_set drops an unknown id; each existing at t. Then
       the hubs, which must exist at t too. */
    FOREACH account_id IN account_ids DO
        @@ids += account_id;
        @@given += 1;
    END;
    IF @@given == 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF @@ids.size() != @@given THEN
        PRINT "duplicate_account" AS status;
        RETURN;
    END;
    Requested = to_vertex_set(@@ids, "Account");
    IF Requested.size() != @@ids.size() THEN
        PRINT "unknown_account" AS status;
        RETURN;
    END;
    Scored = SELECT s FROM Requested:s WHERE s.opened_ms < t_ms;
    IF Scored.size() != Requested.size() THEN
        PRINT "invisible_account" AS status;
        RETURN;
    END;
    Hubs = {hub_accounts};
    HubAccounts = SELECT h FROM Hubs:h WHERE h.opened_ms < t_ms;
    IF HubAccounts.size() != Hubs.size() THEN
        PRINT "invisible_hub" AS status;
        RETURN;
    END;
    Marked = SELECT h FROM HubAccounts:h POST-ACCUM h.@hub += TRUE;

    /* The payments of the lookback, each way, but self-payments: per payer and per payee its
       earliest payment and its cents of the last 30 days. */
    Received = SELECT a FROM Scored:a
      -((Account_Received_Transaction>|Account_Received_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
      ACCUM
        INT cents = floor(p.amount * 100 + 0.5),
        a.@payer_first += (b.id -> p.event_ts_ms),
        IF b.is_external THEN a.@external_payers += b.id END,
        IF p.event_ts_ms >= t_ms - 2592000000 THEN
            a.@payer_cents += (b.id -> cents),
            a.@received_30d += cents
        END;
    Sent = SELECT a FROM Scored:a
      -((Account_Initiated_Transaction>|Account_Sent_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_To_Account>|Transfer_To_Account>):f)- Account:b
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
      ACCUM
        INT cents = floor(p.amount * 100 + 0.5),
        a.@payee_first += (b.id -> p.event_ts_ms),
        IF p.event_ts_ms >= t_ms - 2592000000 THEN
            a.@payee_cents += (b.id -> cents),
            a.@sent_30d += cents,
            IF b.@hub THEN a.@sent_to_hubs_30d += cents END
        END;

    /* The new payers, by is_external, and the new payees; each payer new over 30 days goes
       into the heap with its first-payment time. Then the shares: new_payer_share_30d, the
       cents of the last 30 days from payers new over 30 days, who paid nothing before them;
       top_payee_share_30d, the most cents sent to one payee; hub_payee_share_30d, the cents
       sent to account hubs, where ordinary money goes. */
    Counted = SELECT a FROM Scored:a
      POST-ACCUM
        INT new_cents = 0, INT top_cents = 0,
        FOREACH (payer, first_ms) IN a.@payer_first DO
            IF first_ms >= t_ms - 2592000000 THEN
                a.@new_payers += NewPayer(first_ms, payer),
                new_cents = new_cents + a.@payer_cents.get(payer),
                IF a.@external_payers.contains(payer) THEN
                    a.@new_external_payers_30d += 1,
                    IF first_ms >= t_ms - 604800000 THEN a.@new_external_payers_7d += 1 END
                ELSE
                    a.@new_internal_payers_30d += 1,
                    IF first_ms >= t_ms - 604800000 THEN a.@new_internal_payers_7d += 1 END
                END
            END
        END,
        FOREACH (payee, first_ms) IN a.@payee_first DO
            IF first_ms >= t_ms - 2592000000 THEN a.@new_payees_30d += 1 END,
            IF first_ms >= t_ms - 604800000 THEN a.@new_payees_7d += 1 END
        END,
        FOREACH (payee, cents) IN a.@payee_cents DO
            IF cents > top_cents THEN top_cents = cents END
        END,
        a.@payers_30d += a.@payer_cents.size(),
        a.@payees_30d += a.@payee_cents.size(),
        IF a.@received_30d > 0 THEN
            a.@new_payer_share_30d += new_cents * 1.0 / a.@received_30d
        END,
        IF a.@sent_30d > 0 THEN
            a.@top_payee_share_30d += top_cents * 1.0 / a.@sent_30d,
            a.@hub_payee_share_30d += a.@sent_to_hubs_30d * 1.0 / a.@sent_30d
        END;

    /* max_new_payers_24h: the most first-payment times of new payers in [x, x + 24 hours), x
       one of them, so a window is anchored at a payment and never at a clock hour. The heap
       keeps the newest 256 and one more: when it holds 257, only the times after the second
       of its oldest are kept, so the payers of one second are kept or dropped together. With
       no cut, the cut is -1, below every second. */
    Rows = SELECT a FROM Scored:a
      POST-ACCUM
        INT cut = -1, INT within = 0, INT most = 0,
        IF a.@new_payers.size() > 256 THEN
            FOREACH x IN a.@new_payers DO
                IF cut < 0 OR floor(x.ts / 1000) < cut THEN cut = floor(x.ts / 1000) END
            END
        END,
        FOREACH x IN a.@new_payers DO
            IF floor(x.ts / 1000) > cut THEN
                within = 0,
                FOREACH y IN a.@new_payers DO
                    IF floor(y.ts / 1000) > cut AND y.ts >= x.ts AND y.ts < x.ts + 86400000
                    THEN
                        within = within + 1
                    END
                END,
                IF within > most THEN most = within END
            END
        END,
        a.@max_new_payers_24h += most;

    PRINT "ok" AS status, "read_counterparties-07a31e72fd65" AS version;
    PRINT Rows[Rows.id AS account_id, Rows.@payers_30d AS payers_30d,
      Rows.@payees_30d AS payees_30d, Rows.@new_internal_payers_7d AS new_internal_payers_7d,
      Rows.@new_internal_payers_30d AS new_internal_payers_30d,
      Rows.@new_external_payers_7d AS new_external_payers_7d,
      Rows.@new_external_payers_30d AS new_external_payers_30d,
      Rows.@new_payees_7d AS new_payees_7d, Rows.@new_payees_30d AS new_payees_30d,
      Rows.@new_payer_share_30d AS new_payer_share_30d,
      Rows.@max_new_payers_24h AS max_new_payers_24h,
      Rows.@top_payee_share_30d AS top_payee_share_30d,
      Rows.@hub_payee_share_30d AS hub_payee_share_30d] AS accounts;
}

USE GRAPH Mule_Pattern_Learner

/* read_activity_change (B3): each account's recent activity against its own past.

   Inputs: t_ms, a whole second in UTC epoch milliseconds after the 90-day lookback; account_ids,
   the accounts to read, each once.
   Prints: accounts, per account its 13 activity columns (docs/features.md, "Account node",
   columns 34 to 46), each duration as presence and milliseconds.
   Refuses: invalid_parameters, duplicate_account, unknown_account and invisible_account (an
   account that does not exist at t).

   A mule account wakes suddenly, with victims minutes to hours apart, so the query sets the
   account's last 7 days against its own 90 (docs/design.md, "read_activity_change (B3): the
   account against its own past"):
   - in_7d to out_90d count every payment received or sent in [t - w, t), but self-payments.
   - The bursts and the shortest gap read the newest 256 payments of the last 30 days each
     way, as kept by the whole-second rule, and every window is anchored at a payment, never
     at a clock hour.
   - since_last_in and since_last_out are t minus the latest payment of the lookback each
     way, absent with none.
   - No hub is read: a hub that is not the scored account is never requested. The accounts
     come as ids, as read_money_flow explains.
   - No value reads the order in which FOREACH walks a heap, so neither an id nor the walk
     decides a value. */
CREATE OR REPLACE QUERY read_activity_change(
    UINT t_ms,
    LIST<STRING> account_ids
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    /* A payment of a time-ordered list: its time and id. */
    TYPEDEF TUPLE<UINT ts, STRING id> Paid;
    /* The payments received and sent over the last 7, 30 and 90 days, and the latest each
       way. */
    SumAccum<INT> @in_7d, @in_30d, @in_90d, @out_7d, @out_30d, @out_90d;
    MaxAccum<UINT> @last_in, @last_out;
    /* The payments received and sent in the last 30 days, the newest 256 and one more. */
    HeapAccum<Paid>(257, ts DESC, id DESC) @inflows, @outflows;
    /* The row. */
    SumAccum<INT> @burst_in_1h, @burst_in_24h, @burst_out_1h, @burst_out_24h;
    OrAccum @shortest_in_gap_present, @since_last_in_present, @since_last_out_present;
    SumAccum<UINT> @shortest_in_gap_ms, @since_last_in_ms, @since_last_out_ms;
    /* The request's ids, each once, and how many it gave. */
    SetAccum<STRING> @@ids;
    SumAccum<INT> @@given;
    UINT lookback_ms = 7776000000;

    IF t_ms <= lookback_ms OR t_ms % 1000 != 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    /* The ids: at least one; none twice, which a list keeps and a set would drop; each an
       account of the graph, since to_vertex_set drops an unknown id; each existing at t. */
    FOREACH account_id IN account_ids DO
        @@ids += account_id;
        @@given += 1;
    END;
    IF @@given == 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF @@ids.size() != @@given THEN
        PRINT "duplicate_account" AS status;
        RETURN;
    END;
    Requested = to_vertex_set(@@ids, "Account");
    IF Requested.size() != @@ids.size() THEN
        PRINT "unknown_account" AS status;
        RETURN;
    END;
    Scored = SELECT s FROM Requested:s WHERE s.opened_ms < t_ms;
    IF Scored.size() != Requested.size() THEN
        PRINT "invisible_account" AS status;
        RETURN;
    END;

    /* The payments of the lookback, each way, but self-payments: the counts, the latest, and
       the last 30 days' payments into the heaps. */
    Received = SELECT a FROM Scored:a
      -((Account_Received_Transaction>|Account_Received_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
      ACCUM
        a.@in_90d += 1,
        a.@last_in += p.event_ts_ms,
        IF p.event_ts_ms >= t_ms - 2592000000 THEN
            a.@in_30d += 1,
            a.@inflows += Paid(p.event_ts_ms, p.id)
        END,
        IF p.event_ts_ms >= t_ms - 604800000 THEN a.@in_7d += 1 END;
    Sent = SELECT a FROM Scored:a
      -((Account_Initiated_Transaction>|Account_Sent_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_To_Account>|Transfer_To_Account>):f)- Account:b
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
      ACCUM
        a.@out_90d += 1,
        a.@last_out += p.event_ts_ms,
        IF p.event_ts_ms >= t_ms - 2592000000 THEN
            a.@out_30d += 1,
            a.@outflows += Paid(p.event_ts_ms, p.id)
        END,
        IF p.event_ts_ms >= t_ms - 604800000 THEN a.@out_7d += 1 END;

    /* Each heap keeps the newest 256 and one more: when it holds 257, only the payments after
       the second of its oldest are kept, so the payments of one second are kept or dropped
       together; with no cut, the cut is -1, below every second. Over the kept payments of
       each way: the most in [x, x + 1 hour) and in [x, x + 24 hours), x the time of one of
       them, so payments of one time all count. Over the kept inflows: the shortest gap from
       one to the latest strictly before it, which is the smallest difference of two distinct
       times. Then the time since the latest payment each way. */
    Rows = SELECT a FROM Scored:a
      POST-ACCUM
        INT cut_in = -1, INT cut_out = -1, INT within_1h = 0, INT within_24h = 0,
        INT most_1h = 0, INT most_24h = 0, UINT shortest = 0, BOOL gap_found = FALSE,
        IF a.@inflows.size() > 256 THEN
            FOREACH x IN a.@inflows DO
                IF cut_in < 0 OR floor(x.ts / 1000) < cut_in THEN
                    cut_in = floor(x.ts / 1000)
                END
            END
        END,
        IF a.@outflows.size() > 256 THEN
            FOREACH x IN a.@outflows DO
                IF cut_out < 0 OR floor(x.ts / 1000) < cut_out THEN
                    cut_out = floor(x.ts / 1000)
                END
            END
        END,
        FOREACH x IN a.@inflows DO
            IF floor(x.ts / 1000) > cut_in THEN
                within_1h = 0, within_24h = 0,
                FOREACH y IN a.@inflows DO
                    IF floor(y.ts / 1000) > cut_in THEN
                        IF y.ts >= x.ts AND y.ts < x.ts + 3600000 THEN
                            within_1h = within_1h + 1
                        END,
                        IF y.ts >= x.ts AND y.ts < x.ts + 86400000 THEN
                            within_24h = within_24h + 1
                        END,
                        IF y.ts < x.ts THEN
                            IF NOT gap_found OR x.ts - y.ts < shortest THEN
                                shortest = x.ts - y.ts, gap_found = TRUE
                            END
                        END
                    END
                END,
                IF within_1h > most_1h THEN most_1h = within_1h END,
                IF within_24h > most_24h THEN most_24h = within_24h END
            END
        END,
        a.@burst_in_1h += most_1h, a.@burst_in_24h += most_24h,
        IF gap_found THEN
            a.@shortest_in_gap_present += TRUE, a.@shortest_in_gap_ms += shortest
        END,
        most_1h = 0, most_24h = 0,
        FOREACH x IN a.@outflows DO
            IF floor(x.ts / 1000) > cut_out THEN
                within_1h = 0, within_24h = 0,
                FOREACH y IN a.@outflows DO
                    IF floor(y.ts / 1000) > cut_out THEN
                        IF y.ts >= x.ts AND y.ts < x.ts + 3600000 THEN
                            within_1h = within_1h + 1
                        END,
                        IF y.ts >= x.ts AND y.ts < x.ts + 86400000 THEN
                            within_24h = within_24h + 1
                        END
                    END
                END,
                IF within_1h > most_1h THEN most_1h = within_1h END,
                IF within_24h > most_24h THEN most_24h = within_24h END
            END
        END,
        a.@burst_out_1h += most_1h, a.@burst_out_24h += most_24h,
        IF a.@in_90d > 0 THEN
            a.@since_last_in_present += TRUE, a.@since_last_in_ms += t_ms - a.@last_in
        END,
        IF a.@out_90d > 0 THEN
            a.@since_last_out_present += TRUE, a.@since_last_out_ms += t_ms - a.@last_out
        END;

    PRINT "ok" AS status, "read_activity_change-1615ec14e0f2" AS version;
    PRINT Rows[Rows.id AS account_id, Rows.@in_7d AS in_7d, Rows.@in_30d AS in_30d,
      Rows.@in_90d AS in_90d, Rows.@out_7d AS out_7d, Rows.@out_30d AS out_30d,
      Rows.@out_90d AS out_90d, Rows.@burst_in_1h AS burst_in_1h,
      Rows.@burst_in_24h AS burst_in_24h, Rows.@burst_out_1h AS burst_out_1h,
      Rows.@burst_out_24h AS burst_out_24h,
      Rows.@shortest_in_gap_present AS shortest_in_gap_present,
      Rows.@shortest_in_gap_ms AS shortest_in_gap_ms,
      Rows.@since_last_in_present AS since_last_in_present,
      Rows.@since_last_in_ms AS since_last_in_ms,
      Rows.@since_last_out_present AS since_last_out_present,
      Rows.@since_last_out_ms AS since_last_out_ms] AS accounts;
}

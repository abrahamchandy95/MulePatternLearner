USE GRAPH Mule_Pattern_Learner

/* The leaves of one date (docs/design.md, "Hubs, crowds and leaves"), which fetch_subgraphs
   receives for every request of the date: the accounts that are counterparty hubs, the
   devices and IPs that are hubs, and the observed-only devices and IPs that are crowds.

   Visibility follows docs/design.md, "Time": a payment counts when window_start <=
   event_ts_ms < t; a link when it began before t and had not ended by window_start. A
   customer has left by t when every account it owns closed by t, at the latest of those
   closes, and a link end at or after that is hidden: the link reads as never ended. A
   customer owns the accounts of its visible ownership links. */
CREATE OR REPLACE QUERY read_leaves(
    UINT as_of_ms,
    INT lookback_days,
    INT hub_threshold,
    INT observed_threshold
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MaxAccum<UINT> @last_close;
    OrAccum @stays, @linked;
    SumAccum<UINT> @left_ms;
    SetAccum<VERTEX<Party>> @customers;
    SetAccum<STRING> @@hub_accounts, @@hub_devices, @@crowd_devices, @@hub_ips, @@crowd_ips;
    UINT day_ms = 86400000;
    UINT window_start = 0;

    IF lookback_days < 30 OR lookback_days > 3650 OR as_of_ms <= lookback_days * day_ms
       OR hub_threshold < 1 OR observed_threshold < 1 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    window_start = as_of_ms - lookback_days * day_ms;

    /* Exits count every account whose ownership began before t, whatever its end. */
    Customers = SELECT q FROM Party:q -(Party_Owns_Account>:o)- Account:b
      WHERE o.valid_from_ms < as_of_ms
      ACCUM q.@last_close += b.closed_ms,
        IF b.closed_ms == 0 OR b.closed_ms > as_of_ms THEN q.@stays += TRUE END
      POST-ACCUM IF NOT q.@stays THEN q.@left_ms = q.@last_close END;

    /* An account is a hub when more than hub_threshold customers own the other accounts of
       its payments. One with no more payments than that in all time cannot be one. */
    Busy = SELECT a FROM Account:a
      WHERE a.outdegree("Account_Initiated_Transaction")
        + a.outdegree("Account_Received_Transaction")
        + a.outdegree("Account_Sent_Zelle_Transfer")
        + a.outdegree("Account_Received_Zelle_Transfer") > hub_threshold;
    HubAccounts = SELECT a FROM Busy:a
      -((Account_Initiated_Transaction>|Account_Received_Transaction>
        |Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transaction_To_Account>
        |Transfer_From_Account>|Transfer_To_Account>):f)-
      Account:b -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= window_start AND p.event_ts_ms < as_of_ms AND b != a
        AND o.valid_from_ms < as_of_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND o.valid_to_ms >= q.@left_ms))
      ACCUM a.@customers += q
      POST-ACCUM IF a.@customers.size() > hub_threshold THEN @@hub_accounts += a.id END;

    /* A device's or IP's customers are those with a visible link to it and the owners of
       the accounts observed sending from it. One a customer links to is a hub with more than
       hub_threshold of them; one none links to (observed-only) is a crowd with more than
       observed_threshold. */
    Nodes = {Device.*, IP.*};
    Linked = SELECT n FROM Nodes:n -((Device_Used_By_Party>|IP_Used_By_Party>):l)- Party:q
      WHERE l.valid_from_ms < as_of_ms
        AND (l.valid_to_ms == 0 OR l.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND l.valid_to_ms >= q.@left_ms))
      ACCUM n.@customers += q, n.@linked += TRUE;
    Observed = SELECT n FROM Nodes:n
      -((Device_Used_By_Transaction>|Device_Used_By_Transfer>
        |IP_Observed_In_Transaction>|IP_Used_By_Transfer>):u)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
      -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= window_start AND p.event_ts_ms < as_of_ms
        AND o.valid_from_ms < as_of_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND o.valid_to_ms >= q.@left_ms))
      ACCUM n.@customers += q;
    Counted = Linked UNION Observed;
    Counted = SELECT n FROM Counted:n
      POST-ACCUM
        IF n.@linked AND n.@customers.size() > hub_threshold THEN
            IF n.type == "Device" THEN @@hub_devices += n.id ELSE @@hub_ips += n.id END
        ELSE IF NOT n.@linked AND n.@customers.size() > observed_threshold THEN
            IF n.type == "Device" THEN @@crowd_devices += n.id ELSE @@crowd_ips += n.id END
        END;

    PRINT "ok" AS status, "read_leaves-8cb6142273f7" AS version,
      @@hub_accounts AS hub_accounts, @@hub_devices AS hub_devices,
      @@crowd_devices AS crowd_devices, @@hub_ips AS hub_ips, @@crowd_ips AS crowd_ips;
}

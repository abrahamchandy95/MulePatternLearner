USE GRAPH Mule_Pattern_Learner

/* list_accounts: which accounts are scored on Monday t, and who owns each.

   Inputs: t_ms, a Monday at 00:00 UTC; after_id and page, to read the accounts a page at a
   time by increasing id, 1 to 10,000 a page.
   Prints: accounts, the account_id and owner_id of the scorable accounts with an id above
   after_id, at most page of them.
   Refuses: invalid_parameters, for a t that is not a Monday after the 90-day lookback or a
   page out of range.

   A scorable account is an internal deposit account that exists at t (opened_ms < t), is
   still open at t, and has a visible ownership link: one that began before t and had not
   ended by t - 90 days (docs/design.md, "The scored population"). An account that did not
   exist at t would let the future in. opened_ms is not printed: a date of record in every
   world's cache is one edit away from a feature. The loader checks that every account has at
   most one owner. */
CREATE OR REPLACE QUERY list_accounts(
    UINT t_ms,
    STRING after_id,
    INT page
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MaxAccum<STRING> @owner_id;
    UINT lookback_ms = 7776000000;

    /* Mondays are 4 days after the Thursday of 1970-01-01, modulo a week. */
    IF t_ms <= lookback_ms OR t_ms % 604800000 != 345600000 OR page < 1 OR page > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Page = SELECT a FROM Account:a -(Account_Owned_By_Party>:o)- Party:q
      WHERE a.id > after_id
        AND NOT a.is_external AND a.account_type == "deposit"
        AND a.opened_ms < t_ms
        AND (a.closed_ms == 0 OR a.closed_ms >= t_ms)
        AND o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
      ACCUM a.@owner_id += q.id
      ORDER BY a.id ASC
      LIMIT page;
    PRINT "ok" AS status, "list_accounts-a270fbdf9620" AS version;
    PRINT Page[Page.id AS account_id, Page.@owner_id AS owner_id] AS accounts;
}

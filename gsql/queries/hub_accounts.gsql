USE GRAPH Mule_Pattern_Learner

/* Read-only registry of Accounts whose child contexts are replaced by client-side stubs.
   A row (account_id, cutoff_seq, visibility_phase, max_visible) means that one of the
   account's four payment relations has more than `threshold` events with event_seq <
   cutoff_seq visible in that phase, so no post-cutoff or hidden event can create a row.
   by_phase = FALSE counts every event, at phase 0. by_phase = TRUE needs the ready split:
   in phase p an event counts when every Account endpoint has partition <= p, the endpoint
   rule of fetch_training_context, and the hub itself must have partition <= p. Rows are
   unordered. No labels are read. */
CREATE OR REPLACE QUERY list_hub_accounts(
    LIST<UINT> cutoff_seqs,
    UINT threshold = 2048,
    BOOL by_phase = FALSE
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    TYPEDEF TUPLE<
        STRING account_id,
        UINT cutoff_seq,
        INT visibility_phase,
        UINT max_visible
    > HubRow;
    ListAccum<UINT> @@requested;
    SetAccum<UINT> @@cutoffs;
    MaxAccum<UINT> @@last_cutoff;
    SetAccum<INT> @@phases;
    MaxAccum<INT> @partition, @event_phase;
    /* relation -> cutoff -> phase -> its events visible in that phase before the cutoff */
    MapAccum<STRING, MapAccum<UINT, MapAccum<INT, SumAccum<UINT>>>> @events;
    MapAccum<UINT, MapAccum<INT, MaxAccum<UINT>>> @visible;
    ListAccum<HubRow> @@hubs;
    SumAccum<INT> @@invalid;
    @@requested = cutoff_seqs;
    FOREACH cutoff IN @@requested DO
        IF cutoff == 0 THEN @@invalid += 1; END;
        @@cutoffs += cutoff;
        @@last_cutoff += cutoff;
    END;
    IF @@requested.size() < 1 OR @@requested.size() > 24 OR @@invalid > 0 OR threshold < 1 THEN
        PRINT "invalid_parameters" AS status; RETURN;
    END;
    IF NOT by_phase THEN
        @@phases += 0;
    ELSE
        Scopes = {Temporal_Training_Scope.*};
        ReadyScope = SELECT r FROM Scopes:r WHERE r.ready;
        IF ReadyScope.size() != 1 THEN PRINT "scope_not_ready" AS status; RETURN; END;
        /* One membership edge per Account: its partition, read once. */
        Members = SELECT a FROM ReadyScope:r -(Training_Scope_Has_Entity>:m)- Account:a
          ACCUM a.@partition += m.partition;
        @@phases += 1;
        @@phases += 2;
        @@phases += 3;
    END;
    Accounts = {Account.*};
    Candidates = SELECT a FROM Accounts:a
      WHERE a.outdegree("Account_Initiated_Transaction") > threshold
         OR a.outdegree("Account_Received_Transaction") > threshold
         OR a.outdegree("Account_Sent_Zelle_Transfer") > threshold
         OR a.outdegree("Account_Received_Zelle_Transfer") > threshold;
    IF by_phase THEN
      /* Every event a count below can reach, marked with the phase it is first visible in. */
        Payments = SELECT t FROM Candidates:a
          -((Account_Initiated_Transaction>|Account_Received_Transaction>):e)- Payment_Transaction:t
          WHERE e.event_seq < @@last_cutoff;
        Transfers = SELECT t FROM Candidates:a
          -((Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)- Zelle_Transfer:t
          WHERE e.event_seq < @@last_cutoff;
        PaymentPhases = SELECT t FROM Payments:t
          -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
          ACCUM t.@event_phase += a.@partition;
        TransferPhases = SELECT t FROM Transfers:t
          -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
          ACCUM t.@event_phase += a.@partition;
    END;
    /* An event visible from phase q counts in every phase p >= q; phase 0 counts every event. */
    Counted = SELECT a FROM Candidates:a
      -((Account_Initiated_Transaction>|Account_Received_Transaction>|Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)- :t
      ACCUM FOREACH cutoff IN @@cutoffs DO
        IF e.event_seq < cutoff THEN
          FOREACH p IN @@phases DO
            IF NOT by_phase OR t.@event_phase <= p THEN
              a.@events += (e.type -> (cutoff -> (p -> 1)))
            END
          END
        END
      END;
    Visible = SELECT a FROM Candidates:a
      POST-ACCUM FOREACH (relation, counts) IN a.@events DO
        FOREACH cutoff IN @@cutoffs DO
          FOREACH p IN @@phases DO
            a.@visible += (cutoff -> (p -> counts.get(cutoff).get(p)))
          END
        END
      END;
    Rows = SELECT a FROM Candidates:a
      POST-ACCUM FOREACH cutoff IN @@cutoffs DO
        FOREACH p IN @@phases DO
          IF a.@visible.get(cutoff).get(p) > threshold AND (NOT by_phase OR a.@partition <= p) THEN
            @@hubs += HubRow(a.id, cutoff, p, a.@visible.get(cutoff).get(p))
          END
        END
      END;
    PRINT "ok" AS status, @@hubs AS hubs;
}

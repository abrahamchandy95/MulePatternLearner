              @@features += ("30d_out_count" -> 1),
              @@features += ("30d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_out_missing" -> 1) END,
              @@features += ("30d_out_zelle" -> 0)
            END,
            IF include_decayed_activity THEN
              @@features += ("decay_1d_out_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)),
              @@features += ("decay_1d_out_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_7d_out_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)),
              @@features += ("decay_7d_out_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_30d_out_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)),
              @@features += ("decay_30d_out_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_90d_out_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)),
              @@features += ("decay_90d_out_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)) END
          POST-ACCUM t.@from_accounts = 0, t.@to_accounts = 0, t.@to_tokens = 0,
            t.@role_invalid = FALSE, t.@peer_key = "";
      END;
      Roles_payment_out_From_Account = SELECT t
        FROM Events_payment_out:t -(Transaction_From_Account>:e)- Account:a
        ACCUM t.@from_accounts += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms);
      Roles_payment_out_To_Account = SELECT t
        FROM Events_payment_out:t -(Transaction_To_Account>:e)- Account:a
        ACCUM t.@to_accounts += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms),
          IF e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms THEN
            t.@peer_key = "Account:" + a.id,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@distinct += ("1h_out_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@distinct += ("1d_out_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@distinct += ("7d_out_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@distinct += ("30d_out_unique" -> "Account:" + a.id) END
          END;
      Roles_payment_out_To_Token = SELECT t
        FROM Events_payment_out:t -(Transaction_To_Token>:e)- Token:a
        ACCUM t.@to_tokens += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms),
          IF e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transaction_To_Account") == 0 THEN
            t.@peer_key = "Token:" + a.token_id,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@distinct += ("1h_out_unique" -> "Token:" + a.token_id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@distinct += ("1d_out_unique" -> "Token:" + a.token_id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@distinct += ("7d_out_unique" -> "Token:" + a.token_id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@distinct += ("30d_out_unique" -> "Token:" + a.token_id) END
          END;
      Retain_payment_out = SELECT t FROM Events_payment_out:t
        ACCUM @@invalid += (t.@role_invalid OR t.@from_accounts != 1 OR t.@to_accounts > 1
            OR t.@to_tokens > 1 OR (t.@to_accounts == 0 AND t.@to_tokens == 0)),
          @@payment_out += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
            "payment_out", t.payment_rail, t.amount, t.amount_present, t.channel, t.@peer_key);
      @@ordered.clear(); @@selected.clear(); @@selected_peers.clear();
      WHILE @@payment_out.size() > 0 DO
        @@ordered += @@payment_out.pop();
      END;
      rank = 0;
      FOREACH entry IN @@ordered DO
        IF keep_history THEN @@history += entry; END;
        IF use_chronology THEN @@chronology += entry; END;
        IF include_identity_order THEN @@last_ten += entry; END;
        sample_key = entry.relation + ":" + entry.event_id;
        IF rank < per_relation THEN
          @@events += entry; @@strata += (sample_key -> "recent");
          @@selected += entry.event_id; @@selected_peers += entry.peer_key;
        END;
        rank = rank + 1;
      END;
      @@older_ranks.clear();
      IF k_old > 0 AND @@ordered.size() > per_relation THEN
        FOREACH j IN RANGE[1, k_old] DO
          older_rank = per_relation + floor((@@ordered.size() - per_relation - 1) * j / (k_old + 1.0));
          @@older_ranks += older_rank;
        END;
        rank = 0;
        FOREACH entry IN @@ordered DO
          IF @@older_ranks.contains(rank) AND NOT @@selected.contains(entry.event_id) THEN
            @@events += entry; @@strata += (entry.relation + ":" + entry.event_id -> "older");
            @@selected += entry.event_id; @@selected_peers += entry.peer_key;
          END;
          rank = rank + 1;
        END;
      END;
      diverse_taken = 0;
      FOREACH entry IN @@ordered DO
        IF diverse_taken < k_div AND NOT @@selected.contains(entry.event_id)
          AND NOT @@selected_peers.contains(entry.peer_key) THEN
          @@events += entry; @@strata += (entry.relation + ":" + entry.event_id -> "distinct");
          @@selected += entry.event_id; @@selected_peers += entry.peer_key;
          diverse_taken = diverse_taken + 1;
        END;
      END;
      pass_stamp = pass_stamp + 1;
      Candidates_payment_in = SELECT t FROM Visible:s -((Account_Received_Transaction>|Token_Received_Transaction>):e)- Payment_Transaction:t
        WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
        ACCUM IF e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms THEN
          t.@clock_mismatch += pass_stamp END;
      IF scope_id != "" THEN
        Endpoints_payment_in = SELECT a FROM Candidates_payment_in:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
          WHERE NOT a.@scope_checked
          POST-ACCUM a.@scope_checked = TRUE;
        Scope_payment_in = SELECT v FROM Endpoints_payment_in:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
            AND membership.partition <= visibility_phase
          ACCUM v.@scope_allowed += TRUE;
        Blocked_payment_in = SELECT t FROM Candidates_payment_in:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
          WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
      END;
      @@relation_count = 0;
      Currency_payment_in = SELECT t FROM Candidates_payment_in:t WHERE NOT t.@scope_blocked
        ACCUM IF t.currency == "USD" THEN @@relation_count += 1 ELSE @@excluded_currency += 1 END;
      IF @@relation_count > max_history THEN
        PRINT "history_capacity_exceeded" AS status, i AS request_index, @@relation_count AS visible_relation_events;
        CONTINUE;
      END;
      IF include_rolling_windows OR include_decayed_activity THEN
        Events_payment_in = SELECT t FROM Visible:s -((Account_Received_Transaction>|Token_Received_Transaction>):e)- Payment_Transaction:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
            AND NOT t.@scope_blocked AND t.currency == "USD"
          ACCUM @@invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0)),
            @@visible_count += 1,
            @@in_last += t.event_ts_ms,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_in_count" -> 1),
              @@features += ("1h_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_in_missing" -> 1) END,
              @@features += ("1h_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_in_count" -> 1),
              @@features += ("1d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_in_missing" -> 1) END,
              @@features += ("1d_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_in_count" -> 1),
              @@features += ("7d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_in_missing" -> 1) END,
              @@features += ("7d_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_in_count" -> 1),
              @@features += ("30d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_in_missing" -> 1) END,
              @@features += ("30d_in_zelle" -> 0)
            END,
            IF include_decayed_activity THEN
              @@features += ("decay_1d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)),
              @@features += ("decay_1d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_7d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)),
              @@features += ("decay_7d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_30d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)),
              @@features += ("decay_30d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_90d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)),
              @@features += ("decay_90d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)) END
          POST-ACCUM t.@from_accounts = 0, t.@to_accounts = 0, t.@to_tokens = 0,
            t.@role_invalid = FALSE, t.@peer_key = "";
      ELSE
        Events_payment_in = SELECT t FROM Candidates_payment_in:t
          WHERE NOT t.@scope_blocked AND t.currency == "USD"
          ACCUM @@invalid += (t.@clock_mismatch == pass_stamp
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0)),
            @@visible_count += 1,
            @@in_last += t.event_ts_ms,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_in_count" -> 1),
              @@features += ("1h_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_in_missing" -> 1) END,
              @@features += ("1h_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_in_count" -> 1),
              @@features += ("1d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_in_missing" -> 1) END,
              @@features += ("1d_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_in_count" -> 1),
              @@features += ("7d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_in_missing" -> 1) END,
              @@features += ("7d_in_zelle" -> 0)
            END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_in_count" -> 1),
              @@features += ("30d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_in_missing" -> 1) END,
              @@features += ("30d_in_zelle" -> 0)
            END,
            IF include_decayed_activity THEN
              @@features += ("decay_1d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)),
              @@features += ("decay_1d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 86400000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_7d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)),
              @@features += ("decay_7d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 604800000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_30d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)),
              @@features += ("decay_30d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 2592000000.0)) END,
            IF include_decayed_activity THEN
              @@features += ("decay_90d_in_count" -> exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)),
              @@features += ("decay_90d_in_amount" -> t.amount * exp(-0.6931471805599453 * (seed_ts_ms - t.event_ts_ms) / 7776000000.0)) END
          POST-ACCUM t.@from_accounts = 0, t.@to_accounts = 0, t.@to_tokens = 0,
            t.@role_invalid = FALSE, t.@peer_key = "";
      END;
      Roles_payment_in_From_Account = SELECT t
        FROM Events_payment_in:t -(Transaction_From_Account>:e)- Account:a
        ACCUM t.@from_accounts += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms),
          IF e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms THEN
            t.@peer_key = "Account:" + a.id,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@distinct += ("1h_in_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@distinct += ("1d_in_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@distinct += ("7d_in_unique" -> "Account:" + a.id) END,
            IF include_rolling_windows AND seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@distinct += ("30d_in_unique" -> "Account:" + a.id) END
          END;
      Roles_payment_in_To_Account = SELECT t
        FROM Events_payment_in:t -(Transaction_To_Account>:e)- Account:a
        ACCUM t.@to_accounts += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms);
      Roles_payment_in_To_Token = SELECT t
        FROM Events_payment_in:t -(Transaction_To_Token>:e)- Token:a
        ACCUM t.@to_tokens += 1, t.@role_invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
          OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms);
      Retain_payment_in = SELECT t FROM Events_payment_in:t
        ACCUM @@invalid += (t.@role_invalid OR t.@from_accounts != 1 OR t.@to_accounts > 1
            OR t.@to_tokens > 1 OR (t.@to_accounts == 0 AND t.@to_tokens == 0)),
          @@payment_in += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
            "payment_in", t.payment_rail, t.amount, t.amount_present, t.channel, t.@peer_key);
      @@ordered.clear(); @@selected.clear(); @@selected_peers.clear();
      WHILE @@payment_in.size() > 0 DO
        @@ordered += @@payment_in.pop();
      END;
      rank = 0;
      FOREACH entry IN @@ordered DO
        IF keep_history THEN @@history += entry; END;
        IF use_chronology THEN @@chronology += entry; END;
        IF include_identity_order THEN @@last_ten += entry; END;
        sample_key = entry.relation + ":" + entry.event_id;
        IF rank < per_relation THEN
          @@events += entry; @@strata += (sample_key -> "recent");
          @@selected += entry.event_id; @@selected_peers += entry.peer_key;
        END;
        rank = rank + 1;
      END;
      @@older_ranks.clear();
      IF k_old > 0 AND @@ordered.size() > per_relation THEN
        FOREACH j IN RANGE[1, k_old] DO
          older_rank = per_relation + floor((@@ordered.size() - per_relation - 1) * j / (k_old + 1.0));
          @@older_ranks += older_rank;
        END;
        rank = 0;
        FOREACH entry IN @@ordered DO
          IF @@older_ranks.contains(rank) AND NOT @@selected.contains(entry.event_id) THEN
            @@events += entry; @@strata += (entry.relation + ":" + entry.event_id -> "older");
            @@selected += entry.event_id; @@selected_peers += entry.peer_key;
          END;
          rank = rank + 1;
        END;
      END;
      diverse_taken = 0;
      FOREACH entry IN @@ordered DO
        IF diverse_taken < k_div AND NOT @@selected.contains(entry.event_id)
          AND NOT @@selected_peers.contains(entry.peer_key) THEN
          @@events += entry; @@strata += (entry.relation + ":" + entry.event_id -> "distinct");
          @@selected += entry.event_id; @@selected_peers += entry.peer_key;
          diverse_taken = diverse_taken + 1;
        END;
      END;
    END;
    IF use_chronology THEN
      request_failed = FALSE;
      WHILE @@chronology.size() > 0 DO @@ascending += @@chronology.pop(); END;
      FOREACH chronological_entry IN @@ascending DO
        pair_key = PairKey(chronological_entry.relation, chronological_entry.rail, chronological_entry.peer_key);
        event_key = chronological_entry.relation + ":" + chronological_entry.event_id;
        IF @@pair_counts.containsKey(pair_key) THEN
          IF chronological_entry.ts < @@pair_last_times.get(pair_key) OR chronological_entry.seq <= @@pair_last_seqs.get(pair_key) THEN
            request_failed = TRUE;
            BREAK;
          END;
          @@event_counts += (event_key -> @@pair_counts.get(pair_key));
          @@event_first_times += (event_key -> @@pair_first_times.get(pair_key));
          @@event_previous_times += (event_key -> @@pair_last_times.get(pair_key));
          @@pair_counts += (pair_key -> 1);
        ELSE
          @@pair_counts += (pair_key -> 1);
          @@pair_first_times += (pair_key -> chronological_entry.ts);
        END;
        @@pair_last_times += (pair_key -> chronological_entry.ts);
        @@pair_last_seqs += (pair_key -> chronological_entry.seq);
      END;
      IF request_failed THEN
        PRINT "nonmonotonic_pair_clock" AS status, i AS request_index;
        CONTINUE;
      END;
    END;
    FOREACH (key, peers) IN @@distinct DO
      @@features += (key -> peers.size());
    END;
    IF include_recency AND @@out_last > 0 THEN
      @@features += ("out_recency_days" -> (seed_ts_ms - @@out_last) / 86400000.0);
      @@features += ("out_recency_present" -> 1);
    END;
    IF include_recency AND @@in_last > 0 THEN
      @@features += ("in_recency_days" -> (seed_ts_ms - @@in_last) / 86400000.0);
      @@features += ("in_recency_present" -> 1);
    END;
    IF include_amount_ratios THEN
    incoming_amount = 0.0; outgoing_amount = 0.0;
    IF @@features.containsKey("1d_in_amount") THEN
      incoming_amount = @@features.get("1d_in_amount");
    END;
    IF @@features.containsKey("1d_out_amount") THEN
      outgoing_amount = @@features.get("1d_out_amount");
    END;
    IF incoming_amount < 1.0 THEN incoming_amount = 1.0; END;
    amount_ratio = outgoing_amount / incoming_amount;
    IF amount_ratio > 100.0 THEN amount_ratio = 100.0; END;
    @@features += ("1d_out_in_amount_ratio" -> amount_ratio);
    END;
    IF include_amount_ratios THEN
    incoming_amount = 0.0; outgoing_amount = 0.0;
    IF @@features.containsKey("7d_in_amount") THEN
      incoming_amount = @@features.get("7d_in_amount");
    END;
    IF @@features.containsKey("7d_out_amount") THEN
      outgoing_amount = @@features.get("7d_out_amount");
    END;
    IF incoming_amount < 1.0 THEN incoming_amount = 1.0; END;
    amount_ratio = outgoing_amount / incoming_amount;
    IF amount_ratio > 100.0 THEN amount_ratio = 100.0; END;
    @@features += ("7d_out_in_amount_ratio" -> amount_ratio);
    END;
    IF include_history_support THEN
      @@features += ("visible_event_count" -> @@visible_count);
      IF @@visible_count < 5 THEN @@features += ("history_lt_5_events" -> 1); END;
    END;
    IF @@last_ten.size() > 0 THEN
      FOREACH entry IN @@last_ten DO tenth_seq = entry.seq; END;
    END;
    IF root_type == "Party" THEN
      IF scope_id != "" THEN
        CandidateAssoc_Party_Owns_Account = SELECT t FROM Visible:s -(Party_Owns_Account>:e)- Account:t
          WHERE e.valid_from_seq <= state_seq
            AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms;
      END;
      IF scope_id != "" THEN
        Scope_Party_Owns_Account = SELECT v FROM CandidateAssoc_Party_Owns_Account:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
            AND membership.partition <= visibility_phase
          ACCUM v.@scope_allowed += TRUE;
      END;
      @@association.clear(); @@associations.clear();
      Assoc_Party_Owns_Account = SELECT t FROM Visible:s -(Party_Owns_Account>:e)- Account:t
        WHERE e.valid_from_seq <= state_seq
          AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
          AND (scope_id == "" OR t.@scope_allowed)
        ACCUM IF e.valid_to_seq == 0 OR state_seq < e.valid_to_seq THEN
          IF include_association_counts THEN @@features += ("Party_Owns_Account_active" -> 1) END,
          @@association += AssociationRow(e.valid_from_seq, t.id, t.first_seen_ts_ms, t.is_external, (t.account_type == "deposit"))
        ELSE IF include_association_counts THEN @@features += ("Party_Owns_Account_ended" -> 1) END END;
      taken = 0;
      WHILE @@association.size() > 0 AND taken < k_assoc DO
        @@associations += @@association.pop();
        taken = taken + 1;
      END;
      FOREACH entry IN @@associations DO

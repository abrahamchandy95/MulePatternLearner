        @@sender_deposit += ("Zelle_Transfer:" + t.transfer_id -> (a.account_type == "deposit")),
        @@event_role_invalid += ("Zelle_Transfer:" + t.transfer_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms)),
        IF use_prior_scan THEN
          @@prior_senders_Transfer += a,
          @@prior_seq_bound_Transfer += (a.id -> t.event_seq),
          @@prior_ts_bound_Transfer += (a.id -> t.event_ts_ms)
        END;
    Recipients_Transfer = SELECT t FROM Selected_Transfer:t -(Transfer_To_Account>:e)- Account:a
      ACCUM @@event_recipients += ("Zelle_Transfer:" + t.transfer_id -> 1), @@recipient_ids += ("Zelle_Transfer:" + t.transfer_id -> a.id),
        @@recipient_first_ms += ("Zelle_Transfer:" + t.transfer_id -> a.first_seen_ts_ms),
        @@recipient_external += ("Zelle_Transfer:" + t.transfer_id -> a.is_external),
        @@recipient_deposit += ("Zelle_Transfer:" + t.transfer_id -> (a.account_type == "deposit")),
        @@event_role_invalid += ("Zelle_Transfer:" + t.transfer_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms));
    Tokens_Transfer = SELECT t FROM Selected_Transfer:t -(Transfer_To_Token>:e)- Token:a
      ACCUM @@event_tokens += ("Zelle_Transfer:" + t.transfer_id -> 1), @@token_ids += ("Zelle_Transfer:" + t.transfer_id -> a.token_id),
        @@token_first_ms += ("Zelle_Transfer:" + t.transfer_id -> a.first_seen_ts_ms),
        @@event_role_invalid += ("Zelle_Transfer:" + t.transfer_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms));
    IF include_device_ip_context THEN
      EventIdentity_Transfer_Device = SELECT t FROM Selected_Transfer:t -(Transfer_Used_Device>:e)- Device:a
        WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          AND a.first_seen_seq <= t.event_seq AND a.first_seen_ts_ms > 0 AND a.first_seen_ts_ms <= t.event_ts_ms
        ACCUM @@device_first_ms += ("Zelle_Transfer:" + t.transfer_id -> a.first_seen_ts_ms);
      EventIdentity_Transfer_IP = SELECT t FROM Selected_Transfer:t -(Transfer_Used_IP>:e)- IP:a
        WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          AND a.first_seen_seq <= t.event_seq AND a.first_seen_ts_ms > 0 AND a.first_seen_ts_ms <= t.event_ts_ms
        ACCUM @@ip_first_ms += ("Zelle_Transfer:" + t.transfer_id -> a.first_seen_ts_ms);
    END;
    Senders_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_From_Account>:e)- Account:a
      ACCUM @@event_senders += ("Payment_Transaction:" + t.transaction_id -> 1), @@sender_ids += ("Payment_Transaction:" + t.transaction_id -> a.id),
        @@sender_first_ms += ("Payment_Transaction:" + t.transaction_id -> a.first_seen_ts_ms),
        @@sender_external += ("Payment_Transaction:" + t.transaction_id -> a.is_external),
        @@sender_deposit += ("Payment_Transaction:" + t.transaction_id -> (a.account_type == "deposit")),
        @@event_role_invalid += ("Payment_Transaction:" + t.transaction_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms)),
        IF use_prior_scan THEN
          @@prior_senders_Transaction += a,
          @@prior_seq_bound_Transaction += (a.id -> t.event_seq),
          @@prior_ts_bound_Transaction += (a.id -> t.event_ts_ms)
        END;
    Recipients_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_To_Account>:e)- Account:a
      ACCUM @@event_recipients += ("Payment_Transaction:" + t.transaction_id -> 1), @@recipient_ids += ("Payment_Transaction:" + t.transaction_id -> a.id),
        @@recipient_first_ms += ("Payment_Transaction:" + t.transaction_id -> a.first_seen_ts_ms),
        @@recipient_external += ("Payment_Transaction:" + t.transaction_id -> a.is_external),
        @@recipient_deposit += ("Payment_Transaction:" + t.transaction_id -> (a.account_type == "deposit")),
        @@event_role_invalid += ("Payment_Transaction:" + t.transaction_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms));
    Tokens_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_To_Token>:e)- Token:a
      ACCUM @@event_tokens += ("Payment_Transaction:" + t.transaction_id -> 1), @@token_ids += ("Payment_Transaction:" + t.transaction_id -> a.token_id),
        @@token_first_ms += ("Payment_Transaction:" + t.transaction_id -> a.first_seen_ts_ms),
        @@event_role_invalid += ("Payment_Transaction:" + t.transaction_id -> (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
            OR a.first_seen_seq > t.event_seq OR a.first_seen_ts_ms > t.event_ts_ms));
    IF include_device_ip_context THEN
      EventIdentity_Transaction_Device = SELECT t FROM Selected_Transaction:t -(Transaction_Used_Device>:e)- Device:a
        WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          AND a.first_seen_seq <= t.event_seq AND a.first_seen_ts_ms > 0 AND a.first_seen_ts_ms <= t.event_ts_ms
        ACCUM @@device_first_ms += ("Payment_Transaction:" + t.transaction_id -> a.first_seen_ts_ms);
      EventIdentity_Transaction_IP = SELECT t FROM Selected_Transaction:t -(Transaction_Used_IP>:e)- IP:a
        WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          AND a.first_seen_seq <= t.event_seq AND a.first_seen_ts_ms > 0 AND a.first_seen_ts_ms <= t.event_ts_ms
        ACCUM @@ip_first_ms += ("Payment_Transaction:" + t.transaction_id -> a.first_seen_ts_ms);
    END;
    request_failed = FALSE;
    FOREACH item IN @@events DO
      event_ref = item.event_type + ":" + item.event_id;
      IF @@event_role_invalid.get(event_ref) OR @@event_senders.get(event_ref) != 1
         OR @@event_recipients.get(event_ref) > 1 OR @@event_tokens.get(event_ref) > 1
         OR (@@event_recipients.get(event_ref) == 0 AND @@event_tokens.get(event_ref) == 0) THEN
        request_failed = TRUE;
        BREAK;
      END;
      IF use_prior_scan THEN
        recipient_type = "Account"; recipient_key = @@recipient_ids.get(event_ref);
        IF @@event_recipients.get(event_ref) == 0 THEN
          recipient_type = "Token"; recipient_key = @@token_ids.get(event_ref);
        END;
        @@pair_items += (@@sender_ids.get(event_ref) + "|" + item.event_type + "|" + recipient_type + ":" + recipient_key
          -> PairItem(item.relation + ":" + item.event_id, item.seq, item.ts, item.rail));
      END;
    END;
    IF request_failed THEN
      PRINT "invalid_event_roles" AS status, i AS request_index;
      CONTINUE;
    END;
    IF use_prior_scan THEN
      PriorSenders_Transfer = {@@prior_senders_Transfer};
      PriorCandidates_Transfer = SELECT t FROM PriorSenders_Transfer:s -(Account_Sent_Zelle_Transfer>:e)- Zelle_Transfer:t
        WHERE t.event_seq < @@prior_seq_bound_Transfer.get(s.id) AND t.event_ts_ms <= @@prior_ts_bound_Transfer.get(s.id)
          AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.currency == "USD"
        ACCUM t.@prior_senders += s.id;
      IF scope_id != "" THEN
        Endpoints_prior_Transfer = SELECT a FROM PriorCandidates_Transfer:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
          WHERE NOT a.@scope_checked
          POST-ACCUM a.@scope_checked = TRUE;
        Scope_prior_Transfer = SELECT v FROM Endpoints_prior_Transfer:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
            AND membership.partition <= visibility_phase
          ACCUM v.@scope_allowed += TRUE;
        Blocked_prior_Transfer = SELECT t FROM PriorCandidates_Transfer:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
          WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
      END;
      Pair_Transfer_Account = SELECT t FROM PriorCandidates_Transfer:t -(Transfer_To_Account>:e)- Account:a
        WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
        ACCUM FOREACH sender IN t.@prior_senders DO
            FOREACH pair_item IN @@pair_items.get(sender + "|Zelle_Transfer|Account:" + a.id) DO
              IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts THEN
                @@prior_counts += (pair_item.event_key -> 1),
                @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms),
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 3600000 THEN
                  @@prior_1h += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 86400000 THEN
                  @@prior_1d += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 604800000 THEN
                  @@prior_7d += (pair_item.event_key -> 1) END
              END
            END
          END;
      Pair_Transfer_Token = SELECT t FROM PriorCandidates_Transfer:t -(Transfer_To_Token>:e)- Token:a
        WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transfer_To_Account") == 0
        ACCUM FOREACH sender IN t.@prior_senders DO
            FOREACH pair_item IN @@pair_items.get(sender + "|Zelle_Transfer|Token:" + a.token_id) DO
              IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts THEN
                @@prior_counts += (pair_item.event_key -> 1),
                @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms),
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 3600000 THEN
                  @@prior_1h += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 86400000 THEN
                  @@prior_1d += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 604800000 THEN
                  @@prior_7d += (pair_item.event_key -> 1) END
              END
            END
          END;
      Release_Transfer = SELECT t FROM PriorCandidates_Transfer:t
        POST-ACCUM t.@prior_senders.clear();
      PriorSenders_Transaction = {@@prior_senders_Transaction};
      PriorCandidates_Transaction = SELECT t FROM PriorSenders_Transaction:s -(Account_Initiated_Transaction>:e)- Payment_Transaction:t
        WHERE t.event_seq < @@prior_seq_bound_Transaction.get(s.id) AND t.event_ts_ms <= @@prior_ts_bound_Transaction.get(s.id)
          AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.currency == "USD"
        ACCUM t.@prior_senders += s.id;
      IF scope_id != "" THEN
        Endpoints_prior_Transaction = SELECT a FROM PriorCandidates_Transaction:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
          WHERE NOT a.@scope_checked
          POST-ACCUM a.@scope_checked = TRUE;
        Scope_prior_Transaction = SELECT v FROM Endpoints_prior_Transaction:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
            AND membership.partition <= visibility_phase
          ACCUM v.@scope_allowed += TRUE;
        Blocked_prior_Transaction = SELECT t FROM PriorCandidates_Transaction:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
          WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
      END;
      Pair_Transaction_Account = SELECT t FROM PriorCandidates_Transaction:t -(Transaction_To_Account>:e)- Account:a
        WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
        ACCUM FOREACH sender IN t.@prior_senders DO
            FOREACH pair_item IN @@pair_items.get(sender + "|Payment_Transaction|Account:" + a.id) DO
              IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts AND t.payment_rail == pair_item.rail THEN
                @@prior_counts += (pair_item.event_key -> 1),
                @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms),
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 3600000 THEN
                  @@prior_1h += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 86400000 THEN
                  @@prior_1d += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 604800000 THEN
                  @@prior_7d += (pair_item.event_key -> 1) END
              END
            END
          END;
      Pair_Transaction_Token = SELECT t FROM PriorCandidates_Transaction:t -(Transaction_To_Token>:e)- Token:a
        WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transaction_To_Account") == 0
        ACCUM FOREACH sender IN t.@prior_senders DO
            FOREACH pair_item IN @@pair_items.get(sender + "|Payment_Transaction|Token:" + a.token_id) DO
              IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts AND t.payment_rail == pair_item.rail THEN
                @@prior_counts += (pair_item.event_key -> 1),
                @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms),
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 3600000 THEN
                  @@prior_1h += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 86400000 THEN
                  @@prior_1d += (pair_item.event_key -> 1) END,
                IF include_pair_window_counts AND pair_item.ts - t.event_ts_ms < 604800000 THEN
                  @@prior_7d += (pair_item.event_key -> 1) END
              END
            END
          END;
      Release_Transaction = SELECT t FROM PriorCandidates_Transaction:t
        POST-ACCUM t.@prior_senders.clear();
    END;
    FOREACH item IN @@events DO
      event_ref = item.event_type + ":" + item.event_id;
      event_key = item.relation + ":" + item.event_id;
      recipient_type = "Account"; recipient_key = @@recipient_ids.get(event_ref);
      peer_first_ms = @@recipient_first_ms.get(event_ref);
      peer_external = @@recipient_external.get(event_ref);
      peer_deposit = @@recipient_deposit.get(event_ref);
      IF @@event_recipients.get(event_ref) == 0 THEN
        recipient_type = "Token"; recipient_key = @@token_ids.get(event_ref);
        peer_first_ms = @@token_first_ms.get(event_ref); peer_external = FALSE; peer_deposit = FALSE;
      END;
      peer_type = recipient_type; peer_id = recipient_key;
      IF item.relation == "zelle_in" OR item.relation == "payment_in" THEN
        peer_type = "Account"; peer_id = @@sender_ids.get(event_ref);
        peer_first_ms = @@sender_first_ms.get(event_ref);
        peer_external = @@sender_external.get(event_ref);
        peer_deposit = @@sender_deposit.get(event_ref);
      END;
      previous_ts = 0; previous_seq = 0;
      pair_1h = 0; pair_1d = 0; pair_7d = 0; pair_prior = 0; pair_first = seed_ts_ms;
      IF root_type == "Account" AND @@event_counts.containsKey(event_key) THEN
        pair_prior = @@event_counts.get(event_key);
        pair_first = @@event_first_times.get(event_key);
        previous_ts = @@event_previous_times.get(event_key);
        previous_seq = 1;
      END;
      IF use_prior_scan THEN
        pair_prior = 0; pair_first = seed_ts_ms; previous_ts = 0; previous_seq = 0;
        IF @@prior_counts.containsKey(event_key) THEN
          pair_prior = @@prior_counts.get(event_key);
          previous_ts = @@prior_last_ts.get(event_key);
          previous_seq = @@prior_last_seq.get(event_key);
          IF @@prior_first_ts.get(event_key) < pair_first THEN pair_first = @@prior_first_ts.get(event_key); END;
          pair_1h = @@prior_1h.get(event_key); pair_1d = @@prior_1d.get(event_key); pair_7d = @@prior_7d.get(event_key);
        END;
      END;
      pair_first_age = 0.0;
      IF include_pair_history AND pair_prior > 0 THEN pair_first_age = (item.ts - pair_first) / 1000.0; END;
      flow_seq = 0; flow_ts = 0; flow_amount = 0.0; flow_amount_present = FALSE; flow_rail = "";
      flow_delay = 0.0; flow_ratio = 0.0; flow_ratio_present = FALSE; flow_present = FALSE;
      flow_censored = FALSE; observation_seconds = 0.0;
      IF include_flow_timing AND root_type == "Account" THEN
        FOREACH other IN @@history DO
          IF (item.relation == "zelle_in" OR item.relation == "payment_in")
            AND (other.relation == "zelle_out" OR other.relation == "payment_out")
            AND other.seq > item.seq AND other.ts >= item.ts
            AND (flow_seq == 0 OR other.seq < flow_seq) THEN
            flow_seq = other.seq; flow_ts = other.ts; flow_amount = other.amount;
            flow_amount_present = other.amount_present; flow_rail = other.rail;
          END;
          IF (item.relation == "zelle_out" OR item.relation == "payment_out")
            AND (other.relation == "zelle_in" OR other.relation == "payment_in")
            AND other.seq < item.seq AND other.ts <= item.ts AND other.seq > flow_seq THEN
            flow_seq = other.seq; flow_ts = other.ts; flow_amount = other.amount;
            flow_amount_present = other.amount_present; flow_rail = other.rail;
          END;
        END;
        flow_present = flow_seq > 0;
        IF item.relation == "zelle_in" OR item.relation == "payment_in" THEN
          observation_seconds = (seed_ts_ms - item.ts) / 1000.0;
          flow_censored = NOT flow_present;
          IF flow_present THEN flow_delay = (flow_ts - item.ts) / 1000.0; END;
          incoming_amount = item.amount; outgoing_amount = flow_amount;
        ELSE
          IF flow_present THEN flow_delay = (item.ts - flow_ts) / 1000.0; END;
          incoming_amount = flow_amount; outgoing_amount = item.amount;
        END;
        IF flow_present AND item.amount_present AND flow_amount_present THEN
          flow_ratio_present = TRUE;
          IF incoming_amount < 1.0 THEN incoming_amount = 1.0; END;
          flow_ratio = outgoing_amount / incoming_amount;
          IF flow_ratio > 100.0 THEN flow_ratio = 100.0; END;
        END;
      END;
      gap_ms = 0;
      age_ms = seed_ts_ms - item.ts;
      IF include_time_encoding AND emit_encodings THEN
        @@age_encoding += (event_key -> temporal_fourier64_values(age_ms));
      END;
      IF previous_seq > 0 THEN
        gap_ms = item.ts - previous_ts;
        IF include_time_encoding AND emit_encodings THEN
          @@gap_encoding += (event_key -> temporal_fourier64_values(gap_ms));
        END;
      END;
      device_seen = FALSE; ip_seen = FALSE; device_age = 0.0; ip_age = 0.0;
      IF @@device_first_ms.containsKey(event_ref) THEN
        device_seen = TRUE; device_age = (item.ts - @@device_first_ms.get(event_ref)) / 1000.0;
      END;
      IF @@ip_first_ms.containsKey(event_ref) THEN
        ip_seen = TRUE; ip_age = (item.ts - @@ip_first_ms.get(event_ref)) / 1000.0;
      END;
      @@messages += MessageRow(peer_type, peer_id, item.relation, item.rail,
        item.event_id, item.seq, item.ts,
        item.amount, item.amount_present,
        age_ms, gap_ms, previous_seq > 0, pair_1h, pair_1d, pair_7d,
        peer_first_ms, peer_external, peer_deposit, item.channel, @@strata.get(event_key),
        pair_prior, pair_first_age, include_pair_history AND pair_prior > 0,
        flow_delay, flow_present, flow_censored, observation_seconds, flow_ratio,
        flow_ratio_present, flow_present AND flow_rail == item.rail, device_age, device_seen, ip_age, ip_seen);
    END;
    @@diagnostics += ("excluded_non_usd_events" -> @@excluded_currency);
    @@diagnostics += ("visible_payment_participations" -> @@visible_count);
    PRINT "ok" AS status, i AS request_index,
      "temporal_live_v5_candidate_pools" AS contract_version, @@diagnostics AS diagnostics,
      root_type AS node_type, root_id AS node_id,
      seed_seq AS cutoff_seq, seed_ts_ms AS cutoff_ms,
      scope_id AS scope_id, visibility_phase AS visibility_phase,
      "log1p_s_400d_32x_sincos_v1" AS basis_id,
      @@features AS features, @@messages AS messages,
      @@age_encoding AS age_encoding, @@gap_encoding AS gap_encoding;
  END;
}

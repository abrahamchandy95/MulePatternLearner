USE GRAPH Mule_Pattern_Learner

/* The model's input: each entity's payments, counterparties and associations before its
   cutoff, never a label. One status row per request; callers keep hub accounts out. */
CREATE OR REPLACE QUERY fetch_training_context(
    LIST<STRING> node_types,
    LIST<STRING> node_ids,
    LIST<UINT> cutoff_seqs,
    LIST<UINT> cutoff_times,
    INT per_relation = 2,
    INT visibility_phase = 0,
    INT k_old = 0,
    INT k_div = 0,
    INT k_assoc = 2,
    INT max_history = 2048,
    BOOL emit_encodings = FALSE
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    TYPEDEF TUPLE<
        UINT seq,
        UINT ts,
        STRING event_id,
        STRING event_type,
        STRING relation,
        STRING rail,
        DOUBLE amount,
        BOOL amount_present,
        STRING peer_type,
        STRING peer_id,
        UINT peer_first_ms,
        BOOL peer_external,
        BOOL peer_deposit
    > EventRow;
    TYPEDEF TUPLE<
        STRING node_type,
        STRING node_id,
        STRING relation,
        STRING rail,
        STRING event_id,
        UINT event_seq,
        UINT event_ts_ms,
        DOUBLE amount,
        BOOL amount_present,
        UINT age_ms,
        UINT gap_ms,
        BOOL gap_present,
        UINT peer_first_ms,
        BOOL peer_external,
        BOOL peer_deposit,
        INT pair_prior_count,
        DOUBLE pair_first_age_seconds,
        BOOL pair_first_present,
        DOUBLE flow_delay_seconds,
        BOOL flow_present,
        BOOL flow_censored,
        DOUBLE flow_observation_seconds,
        DOUBLE flow_amount_ratio,
        BOOL flow_ratio_present,
        BOOL flow_same_rail
    > MessageRow;
    TYPEDEF TUPLE<STRING relation, STRING rail, STRING peer_key> PairKey;
    TYPEDEF TUPLE<
        UINT seq,
        STRING node_type,
        STRING node_id,
        STRING relation,
        UINT first_ms,
        BOOL external,
        BOOL deposit
    > AssociationRow;
    TYPEDEF TUPLE<STRING event_key, UINT seq, UINT ts, STRING rail> PairItem;
    /* Every payment candidate: relation DESC orders zelle_out, zelle_in, payment_out and
       payment_in, each of at most max_history (4096) events. */
    HeapAccum<EventRow>(16384, relation DESC, seq DESC, event_id ASC) @@candidates;
    HeapAccum<EventRow>(16384, seq ASC, event_id ASC, relation ASC) @@chronology;
    HeapAccum<AssociationRow>(8, seq DESC, node_id ASC) @@association;
    ListAccum<EventRow> @@ordered, @@events, @@distinct, @@ascending;
    ListAccum<AssociationRow> @@associations;
    ListAccum<MessageRow> @@messages;
    MapAccum<STRING, SumAccum<INT>> @@relation_sizes;
    SetAccum<INT> @@older_ranks;
    SetAccum<STRING> @@selected, @@selected_peers;
    MapAccum<PairKey, UINT> @@pair_counts, @@pair_first_times;
    MapAccum<PairKey, MaxAccum<UINT>> @@pair_last_times;
    MapAccum<STRING, UINT> @@event_counts, @@event_first_times, @@event_previous_times;
    MapAccum<STRING, SumAccum<DOUBLE>> @@features;
    MapAccum<STRING, ListAccum<DOUBLE>> @@age_encoding, @@gap_encoding;
    ListAccum<STRING> @@request_types, @@request_ids;
    ListAccum<UINT> @@request_seqs, @@request_times;
    SetAccum<STRING> @@requested_Account, @@requested_Token, @@requested_Party,
      @@requested_Device, @@requested_IP, @@requested_Address;
    MapAccum<STRING, MaxAccum<UINT>> @@root_first_seq, @@root_first_ms;
    MapAccum<STRING, OrAccum<BOOL>> @@root_external, @@root_deposit;
    SetAccum<STRING> @@root_allowed;
    SetAccum<STRING> @@selected_zelle, @@selected_payment;
    MapAccum<STRING, MaxAccum<STRING>> @@sender_ids, @@recipient_keys;
    SetAccum<VERTEX<Account>> @@prior_senders_Transfer, @@prior_senders_Transaction;
    MapAccum<STRING, MaxAccum<UINT>> @@prior_seq_bound_Transfer, @@prior_ts_bound_Transfer,
      @@prior_seq_bound_Transaction, @@prior_ts_bound_Transaction;
    MapAccum<STRING, ListAccum<PairItem>> @@pair_items;
    MapAccum<STRING, SumAccum<INT>> @@prior_counts;
    MapAccum<STRING, MaxAccum<UINT>> @@prior_last_ts, @@prior_last_seq;
    MapAccum<STRING, MinAccum<UINT>> @@prior_first_ts;
    SetAccum<STRING> @prior_senders;
    OrAccum @scope_allowed, @scope_blocked, @scope_checked;
    PairKey pair_key;
    VERTEX root;
    STRING root_type = "";
    STRING root_id = "";
    STRING root_key = "";
    UINT seed_seq = 0;
    UINT seed_ts_ms = 0;
    UINT state_seq = 0;
    BOOL use_chronology = FALSE;
    BOOL use_prior_scan = FALSE;
    STRING relation = "";
    STRING sample_key = "";
    STRING peer_key = "";
    INT relation_size = 0;
    INT rank = 0;
    INT older_rank = 0;
    INT diverse_taken = 0;
    INT taken = 0;
    UINT flow_seq = 0;
    UINT flow_ts = 0;
    DOUBLE flow_amount = 0.0;
    BOOL flow_amount_present = FALSE;
    STRING flow_rail = "";
    DOUBLE flow_delay = 0.0;
    DOUBLE flow_ratio = 0.0;
    DOUBLE observation_seconds = 0.0;
    BOOL flow_present = FALSE;
    BOOL flow_censored = FALSE;
    BOOL flow_ratio_present = FALSE;
    STRING event_key = "";
    STRING event_ref = "";
    DOUBLE pair_first_age = 0.0;
    INT pair_prior = 0;
    UINT pair_first = 0;
    UINT previous_ts = 0;
    BOOL gap_present = FALSE;
    UINT age_ms = 0;
    UINT gap_ms = 0;
    DOUBLE incoming_amount = 0.0;
    DOUBLE outgoing_amount = 0.0;

    @@request_ids = node_ids;
    @@request_types = node_types;
    @@request_seqs = cutoff_seqs;
    @@request_times = cutoff_times;
    /* visibility_phase 0 sees every entity and event, 1 to 3 only those of the graph's one
       ready split in partitions up to the phase. */
    IF @@request_ids.size() < 1 OR @@request_ids.size() > 64 OR
       @@request_types.size() != @@request_ids.size() OR @@request_seqs.size() != @@request_ids.size()
       OR @@request_times.size() != @@request_ids.size() OR per_relation < 1 OR per_relation > 32
       OR k_old < 0 OR k_old > 16 OR k_div < 0 OR k_div > 16 OR k_assoc < 0 OR k_assoc > 8
       OR max_history < 32 OR max_history > 4096 OR visibility_phase < 0 OR visibility_phase > 3 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF visibility_phase > 0 THEN
        ScopeCatalog = {Temporal_Training_Scope.*};
        RequestedScope = SELECT r FROM ScopeCatalog:r WHERE r.ready;
        IF RequestedScope.size() != 1 THEN PRINT "scope_not_ready" AS status; RETURN; END;
    END;
    FOREACH i IN RANGE[0, @@request_ids.size()-1] DO
        IF @@request_types.get(i) == "Account" THEN
            @@requested_Account += @@request_ids.get(i);
        END;
        IF @@request_types.get(i) == "Token" THEN
            @@requested_Token += @@request_ids.get(i);
        END;
        IF @@request_types.get(i) == "Party" THEN
            @@requested_Party += @@request_ids.get(i);
        END;
        IF @@request_types.get(i) == "Device" THEN
            @@requested_Device += @@request_ids.get(i);
        END;
        IF @@request_types.get(i) == "IP" THEN
            @@requested_IP += @@request_ids.get(i);
        END;
        IF @@request_types.get(i) == "Address" THEN
            @@requested_Address += @@request_ids.get(i);
        END;
    END;
    Requested_Account = to_vertex_set(@@requested_Account, "Account");
    Catalog_Account = SELECT s FROM Requested_Account:s
      ACCUM @@root_first_seq += ("Account:" + s.id -> s.first_seen_seq),
        @@root_first_ms += ("Account:" + s.id -> s.first_seen_ts_ms),
        @@root_external += ("Account:" + s.id -> s.is_external),
        @@root_deposit += ("Account:" + s.id -> (s.account_type == "deposit"));
    Requested_Token = to_vertex_set(@@requested_Token, "Token");
    Catalog_Token = SELECT s FROM Requested_Token:s
      ACCUM @@root_first_seq += ("Token:" + s.token_id -> s.first_seen_seq),
        @@root_first_ms += ("Token:" + s.token_id -> s.first_seen_ts_ms);
    Requested_Party = to_vertex_set(@@requested_Party, "Party");
    Catalog_Party = SELECT s FROM Requested_Party:s
      ACCUM @@root_first_seq += ("Party:" + s.id -> s.first_seen_seq),
        @@root_first_ms += ("Party:" + s.id -> s.first_seen_ts_ms);
    Requested_Device = to_vertex_set(@@requested_Device, "Device");
    Catalog_Device = SELECT s FROM Requested_Device:s
      ACCUM @@root_first_seq += ("Device:" + s.id -> s.first_seen_seq),
        @@root_first_ms += ("Device:" + s.id -> s.first_seen_ts_ms);
    Requested_IP = to_vertex_set(@@requested_IP, "IP");
    Catalog_IP = SELECT s FROM Requested_IP:s
      ACCUM @@root_first_seq += ("IP:" + s.id -> s.first_seen_seq),
        @@root_first_ms += ("IP:" + s.id -> s.first_seen_ts_ms);
    Requested_Address = to_vertex_set(@@requested_Address, "Address");
    Catalog_Address = SELECT s FROM Requested_Address:s
      ACCUM @@root_first_seq += ("Address:" + s.address_id -> s.first_seen_seq),
        @@root_first_ms += ("Address:" + s.address_id -> s.first_seen_ts_ms);
    IF visibility_phase > 0 THEN
        RootScope_Account = SELECT s FROM Requested_Account:s -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.ready AND membership.partition >= 1 AND membership.partition <= visibility_phase
          ACCUM s.@scope_allowed += TRUE, @@root_allowed += "Account:" + s.id;
        RootScope_Party = SELECT s FROM Requested_Party:s -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
          WHERE r.ready AND membership.partition >= 1 AND membership.partition <= visibility_phase
          ACCUM s.@scope_allowed += TRUE, @@root_allowed += "Party:" + s.id;
    END;
    FOREACH i IN RANGE[0, @@request_ids.size()-1] DO
        root_type = @@request_types.get(i);
        root_id = @@request_ids.get(i);
        root_key = root_type + ":" + root_id;
        seed_seq = @@request_seqs.get(i);
        seed_ts_ms = @@request_times.get(i);
        IF NOT @@root_first_seq.containsKey(root_key) THEN
            PRINT "missing_entity" AS status, i AS request_index;
            CONTINUE;
        END;
        /* A child's cutoff is the event that links it to its root, where it may first
           appear, so an entity first seen at its cutoff is visible: hence >. */
        IF @@root_first_seq.get(root_key) > seed_seq OR @@root_first_ms.get(root_key) > seed_ts_ms
           OR (visibility_phase > 0 AND (root_type == "Account" OR root_type == "Party")
               AND NOT @@root_allowed.contains(root_key)) THEN
            PRINT "invisible_entity" AS status, i AS request_index;
            CONTINUE;
        END;
        state_seq = seed_seq - 1;
        root = to_vertex(root_id, root_type);
        Visible = {root};
        @@features.clear(); @@messages.clear(); @@events.clear(); @@distinct.clear();
        @@candidates.clear(); @@ordered.clear(); @@relation_sizes.clear();
        @@selected.clear(); @@selected_peers.clear();
        @@chronology.clear(); @@ascending.clear();
        @@pair_counts.clear(); @@pair_first_times.clear(); @@pair_last_times.clear();
        @@event_counts.clear(); @@event_first_times.clear(); @@event_previous_times.clear();
        @@age_encoding.clear(); @@gap_encoding.clear(); @@associations.clear();
        @@selected_zelle.clear(); @@selected_payment.clear();
        @@sender_ids.clear(); @@recipient_keys.clear();
        @@prior_senders_Transfer.clear(); @@prior_senders_Transaction.clear();
        @@prior_seq_bound_Transfer.clear(); @@prior_ts_bound_Transfer.clear();
        @@prior_seq_bound_Transaction.clear(); @@prior_ts_bound_Transaction.clear();
        @@pair_items.clear(); @@prior_counts.clear();
        @@prior_last_ts.clear(); @@prior_last_seq.clear(); @@prior_first_ts.clear();
        use_chronology = root_type == "Account";
        use_prior_scan = root_type == "Token";
        IF root_type == "Account" THEN
            IF @@root_external.get(root_key) THEN @@features += ("is_external" -> 1); END;
            IF @@root_deposit.get(root_key) THEN @@features += ("is_deposit" -> 1); END;
        END;
        IF root_type == "Account" OR root_type == "Token" THEN
            Candidates_zelle_out = SELECT t FROM Visible:s -((Account_Sent_Zelle_Transfer>|Token_Sent_Transfer>):e)- Zelle_Transfer:t
              WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms AND t.currency == "USD";
            Candidates_zelle_in = SELECT t FROM Visible:s -((Account_Received_Zelle_Transfer>|Token_Received_Transfer>):e)- Zelle_Transfer:t
              WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms AND t.currency == "USD";
            Candidates_payment_out = SELECT t FROM Visible:s -((Account_Initiated_Transaction>|Token_Sent_Transaction>):e)- Payment_Transaction:t
              WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms AND t.currency == "USD";
            Candidates_payment_in = SELECT t FROM Visible:s -((Account_Received_Transaction>|Token_Received_Transaction>):e)- Payment_Transaction:t
              WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms AND t.currency == "USD";
            /* An event is blocked when the phase does not see one of its accounts; scope marks
               are the same in every request, so each account is looked up once. */
            IF visibility_phase > 0 THEN
                Candidates = Candidates_zelle_out UNION Candidates_zelle_in
                  UNION Candidates_payment_out UNION Candidates_payment_in;
                Endpoints = SELECT a FROM Candidates:t -((Transfer_From_Account>|Transfer_To_Account>|Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
                  WHERE NOT a.@scope_checked
                  POST-ACCUM a.@scope_checked = TRUE;
                EndpointScope = SELECT v FROM Endpoints:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
                  WHERE r.ready AND membership.partition >= 1 AND membership.partition <= visibility_phase
                  ACCUM v.@scope_allowed += TRUE;
                Blocked = SELECT t FROM Candidates:t -((Transfer_From_Account>|Transfer_To_Account>|Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
                  WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
            END;
            Events_zelle_out = SELECT t FROM Candidates_zelle_out:t WHERE NOT t.@scope_blocked;
            Events_zelle_in = SELECT t FROM Candidates_zelle_in:t WHERE NOT t.@scope_blocked;
            Events_payment_out = SELECT t FROM Candidates_payment_out:t WHERE NOT t.@scope_blocked;
            Events_payment_in = SELECT t FROM Candidates_payment_in:t WHERE NOT t.@scope_blocked;
            IF Events_zelle_out.size() > max_history OR Events_zelle_in.size() > max_history
               OR Events_payment_out.size() > max_history OR Events_payment_in.size() > max_history THEN
                PRINT "history_capacity_exceeded" AS status, i AS request_index;
                CONTINUE;
            END;
            /* One row per event with its peer: the account paid, or else the token paid
               (out), and the paying account (in). */
            Peers_zelle_out = SELECT t FROM Events_zelle_out:t -(Transfer_To_Account>:e)- Account:a
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transfer_id, "Zelle_Transfer",
                "zelle_out", "zelle", t.amount, t.amount_present, "Account", a.id,
                a.first_seen_ts_ms, a.is_external, (a.account_type == "deposit"));
            Tokens_zelle_out = SELECT t FROM Events_zelle_out:t -(Transfer_To_Token>:e)- Token:a
              WHERE t.outdegree("Transfer_To_Account") == 0
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transfer_id, "Zelle_Transfer",
                "zelle_out", "zelle", t.amount, t.amount_present, "Token", a.token_id,
                a.first_seen_ts_ms, FALSE, FALSE);
            Peers_zelle_in = SELECT t FROM Events_zelle_in:t -(Transfer_From_Account>:e)- Account:a
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transfer_id, "Zelle_Transfer",
                "zelle_in", "zelle", t.amount, t.amount_present, "Account", a.id,
                a.first_seen_ts_ms, a.is_external, (a.account_type == "deposit"));
            Peers_payment_out = SELECT t FROM Events_payment_out:t -(Transaction_To_Account>:e)- Account:a
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
                "payment_out", t.payment_rail, t.amount, t.amount_present, "Account", a.id,
                a.first_seen_ts_ms, a.is_external, (a.account_type == "deposit"));
            Tokens_payment_out = SELECT t FROM Events_payment_out:t -(Transaction_To_Token>:e)- Token:a
              WHERE t.outdegree("Transaction_To_Account") == 0
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
                "payment_out", t.payment_rail, t.amount, t.amount_present, "Token", a.token_id,
                a.first_seen_ts_ms, FALSE, FALSE);
            Peers_payment_in = SELECT t FROM Events_payment_in:t -(Transaction_From_Account>:e)- Account:a
              ACCUM @@candidates += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
                "payment_in", t.payment_rail, t.amount, t.amount_present, "Account", a.id,
                a.first_seen_ts_ms, a.is_external, (a.account_type == "deposit"));
            WHILE @@candidates.size() > 0 DO @@ordered += @@candidates.pop(); END;
            FOREACH entry IN @@ordered DO
                @@relation_sizes += (entry.relation -> 1);
                IF use_chronology THEN @@chronology += entry; END;
            END;
            /* Each relation's pool, newest first: its per_relation most recent events and
               k_old rank quantiles of the older ones, then k_div events of new peers. */
            relation = "";
            FOREACH entry IN @@ordered DO
                IF entry.relation != relation THEN
                    relation = entry.relation;
                    relation_size = @@relation_sizes.get(relation);
                    rank = 0;
                    @@older_ranks.clear();
                    IF k_old > 0 AND relation_size > per_relation THEN
                        FOREACH j IN RANGE[1, k_old] DO
                            older_rank = per_relation + floor((relation_size - per_relation - 1) * j / (k_old + 1.0));
                            @@older_ranks += older_rank;
                        END;
                    END;
                END;
                IF rank < per_relation OR @@older_ranks.contains(rank) THEN
                    @@selected += relation + ":" + entry.event_id;
                    @@selected_peers += relation + "|" + entry.peer_type + ":" + entry.peer_id;
                END;
                rank = rank + 1;
            END;
            /* Per relation, the recent and older events in rank order, then the distinct ones. */
            relation = "";
            FOREACH entry IN @@ordered DO
                IF entry.relation != relation THEN
                    FOREACH chosen IN @@distinct DO @@events += chosen; END;
                    @@distinct.clear();
                    relation = entry.relation;
                    diverse_taken = 0;
                END;
                sample_key = relation + ":" + entry.event_id;
                peer_key = relation + "|" + entry.peer_type + ":" + entry.peer_id;
                IF @@selected.contains(sample_key) THEN @@events += entry; END;
                IF diverse_taken < k_div AND NOT @@selected.contains(sample_key)
                   AND NOT @@selected_peers.contains(peer_key) THEN
                    @@distinct += entry;
                    @@selected_peers += peer_key;
                    diverse_taken = diverse_taken + 1;
                END;
            END;
            FOREACH chosen IN @@distinct DO @@events += chosen; END;
            /* Path A, for Account roots: an event's pair history is the earlier events of its
               relation, rail and peer, in chronological order. */
            IF use_chronology THEN
                WHILE @@chronology.size() > 0 DO @@ascending += @@chronology.pop(); END;
                FOREACH entry IN @@ascending DO
                    pair_key = PairKey(entry.relation, entry.rail, entry.peer_type + ":" + entry.peer_id);
                    event_key = entry.relation + ":" + entry.event_id;
                    IF @@pair_counts.containsKey(pair_key) THEN
                        @@event_counts += (event_key -> @@pair_counts.get(pair_key));
                        @@event_first_times += (event_key -> @@pair_first_times.get(pair_key));
                        @@event_previous_times += (event_key -> @@pair_last_times.get(pair_key));
                    ELSE
                        @@pair_first_times += (pair_key -> entry.ts);
                    END;
                    @@pair_counts += (pair_key -> 1);
                    @@pair_last_times += (pair_key -> entry.ts);
                END;
            END;
        END;
        /* Associations valid at state_seq, the newest k_assoc of each relation. A root has at
           most one relation to each target type, and e.type names it. */
        IF k_assoc > 0 THEN
            IF visibility_phase > 0 THEN
                Linked = SELECT t FROM Visible:s -((Account_Owned_By_Party>|Token_Used_By_Party>|Device_Used_By_Party>|IP_Used_By_Party>|Address_Used_By_Party>|Party_Owns_Account>|Token_Bound_To_Account>|Device_Used_By_Account>):e)- :t
                  WHERE e.valid_from_seq <= state_seq;
                LinkedScope = SELECT v FROM Linked:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
                  WHERE r.ready AND membership.partition >= 1 AND membership.partition <= visibility_phase
                  ACCUM v.@scope_allowed += TRUE;
            END;
            @@association.clear();
            Assoc_Party = SELECT t FROM Visible:s -((Account_Owned_By_Party>|Token_Used_By_Party>|Device_Used_By_Party>|IP_Used_By_Party>|Address_Used_By_Party>):e)- Party:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
                AND (visibility_phase == 0 OR t.@scope_allowed)
              ACCUM @@association += AssociationRow(e.valid_from_seq, "Party", t.id, e.type,
                t.first_seen_ts_ms, FALSE, FALSE);
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            @@association.clear();
            Assoc_Account = SELECT t FROM Visible:s -((Party_Owns_Account>|Token_Bound_To_Account>|Device_Used_By_Account>):e)- Account:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
                AND (visibility_phase == 0 OR t.@scope_allowed)
              ACCUM @@association += AssociationRow(e.valid_from_seq, "Account", t.id, e.type,
                t.first_seen_ts_ms, t.is_external, (t.account_type == "deposit"));
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            @@association.clear();
            Assoc_Token = SELECT t FROM Visible:s -((Party_Uses_Token>|Account_Bound_From_Token>):e)- Token:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
              ACCUM @@association += AssociationRow(e.valid_from_seq, "Token", t.token_id, e.type,
                t.first_seen_ts_ms, FALSE, FALSE);
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            @@association.clear();
            Assoc_Device = SELECT t FROM Visible:s -((Party_Uses_Device>|Account_Uses_Device>):e)- Device:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
              ACCUM @@association += AssociationRow(e.valid_from_seq, "Device", t.id, e.type,
                t.first_seen_ts_ms, FALSE, FALSE);
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            @@association.clear();
            Assoc_IP = SELECT t FROM Visible:s -((Party_Uses_IP>):e)- IP:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
              ACCUM @@association += AssociationRow(e.valid_from_seq, "IP", t.id, e.type,
                t.first_seen_ts_ms, FALSE, FALSE);
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            @@association.clear();
            Assoc_Address = SELECT t FROM Visible:s -((Party_Has_Address>):e)- Address:t
              WHERE e.valid_from_seq <= state_seq AND (e.valid_to_seq == 0 OR state_seq < e.valid_to_seq)
                AND t.first_seen_seq <= state_seq AND t.first_seen_ts_ms <= seed_ts_ms
              ACCUM @@association += AssociationRow(e.valid_from_seq, "Address", t.address_id, e.type,
                t.first_seen_ts_ms, FALSE, FALSE);
            taken = 0;
            WHILE @@association.size() > 0 AND taken < k_assoc DO
                @@associations += @@association.pop();
                taken = taken + 1;
            END;
            FOREACH entry IN @@associations DO
                @@messages += MessageRow(entry.node_type, entry.node_id, entry.relation, "unknown", "",
                  seed_seq, seed_ts_ms, 0.0, FALSE, 0, 0, FALSE, entry.first_ms, entry.external,
                  entry.deposit, 0, 0.0, FALSE, 0.0, FALSE, FALSE, 0.0, 0.0, FALSE, FALSE);
            END;
        END;
        /* Path B, for Token roots: a selected event's pair is its sender account and its
           recipient, and earlier payments of that sender to that recipient its history. */
        IF use_prior_scan THEN
            FOREACH item IN @@events DO
                IF item.event_type == "Zelle_Transfer" THEN @@selected_zelle += item.event_id;
                ELSE @@selected_payment += item.event_id; END;
            END;
            Selected_Transfer = to_vertex_set(@@selected_zelle, "Zelle_Transfer");
            Selected_Transaction = to_vertex_set(@@selected_payment, "Payment_Transaction");
            Senders_Transfer = SELECT t FROM Selected_Transfer:t -(Transfer_From_Account>:e)- Account:a
              ACCUM @@sender_ids += ("Zelle_Transfer:" + t.transfer_id -> a.id),
                @@prior_senders_Transfer += a,
                @@prior_seq_bound_Transfer += (a.id -> t.event_seq),
                @@prior_ts_bound_Transfer += (a.id -> t.event_ts_ms);
            Recipients_Transfer = SELECT t FROM Selected_Transfer:t -(Transfer_To_Account>:e)- Account:a
              ACCUM @@recipient_keys += ("Zelle_Transfer:" + t.transfer_id -> "Account:" + a.id);
            Tokens_Transfer = SELECT t FROM Selected_Transfer:t -(Transfer_To_Token>:e)- Token:a
              WHERE t.outdegree("Transfer_To_Account") == 0
              ACCUM @@recipient_keys += ("Zelle_Transfer:" + t.transfer_id -> "Token:" + a.token_id);
            Senders_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_From_Account>:e)- Account:a
              ACCUM @@sender_ids += ("Payment_Transaction:" + t.transaction_id -> a.id),
                @@prior_senders_Transaction += a,
                @@prior_seq_bound_Transaction += (a.id -> t.event_seq),
                @@prior_ts_bound_Transaction += (a.id -> t.event_ts_ms);
            Recipients_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_To_Account>:e)- Account:a
              ACCUM @@recipient_keys += ("Payment_Transaction:" + t.transaction_id -> "Account:" + a.id);
            Tokens_Transaction = SELECT t FROM Selected_Transaction:t -(Transaction_To_Token>:e)- Token:a
              WHERE t.outdegree("Transaction_To_Account") == 0
              ACCUM @@recipient_keys += ("Payment_Transaction:" + t.transaction_id -> "Token:" + a.token_id);
            FOREACH item IN @@events DO
                event_ref = item.event_type + ":" + item.event_id;
                @@pair_items += (@@sender_ids.get(event_ref) + "|" + item.event_type + "|"
                  + @@recipient_keys.get(event_ref)
                  -> PairItem(item.relation + ":" + item.event_id, item.seq, item.ts, item.rail));
            END;
            PriorSenders_Transfer = {@@prior_senders_Transfer};
            PriorCandidates_Transfer = SELECT t FROM PriorSenders_Transfer:s -(Account_Sent_Zelle_Transfer>:e)- Zelle_Transfer:t
              WHERE t.event_seq < @@prior_seq_bound_Transfer.get(s.id) AND t.event_ts_ms <= @@prior_ts_bound_Transfer.get(s.id)
                AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.currency == "USD"
              ACCUM t.@prior_senders += s.id;
            PriorSenders_Transaction = {@@prior_senders_Transaction};
            PriorCandidates_Transaction = SELECT t FROM PriorSenders_Transaction:s -(Account_Initiated_Transaction>:e)- Payment_Transaction:t
              WHERE t.event_seq < @@prior_seq_bound_Transaction.get(s.id) AND t.event_ts_ms <= @@prior_ts_bound_Transaction.get(s.id)
                AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.currency == "USD"
              ACCUM t.@prior_senders += s.id;
            PriorCandidates = PriorCandidates_Transfer UNION PriorCandidates_Transaction;
            IF visibility_phase > 0 THEN
                PriorEndpoints = SELECT a FROM PriorCandidates:t -((Transfer_From_Account>|Transfer_To_Account>|Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
                  WHERE NOT a.@scope_checked
                  POST-ACCUM a.@scope_checked = TRUE;
                PriorEndpointScope = SELECT v FROM PriorEndpoints:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
                  WHERE r.ready AND membership.partition >= 1 AND membership.partition <= visibility_phase
                  ACCUM v.@scope_allowed += TRUE;
                PriorBlocked = SELECT t FROM PriorCandidates:t -((Transfer_From_Account>|Transfer_To_Account>|Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
                  WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
            END;
            Pair_Transfer_Account = SELECT t FROM PriorCandidates_Transfer:t -(Transfer_To_Account>:e)- Account:a
              WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
              ACCUM FOREACH sender IN t.@prior_senders DO
                  FOREACH pair_item IN @@pair_items.get(sender + "|Zelle_Transfer|Account:" + a.id) DO
                    IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts THEN
                      @@prior_counts += (pair_item.event_key -> 1),
                      @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                      @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                      @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms)
                    END
                  END
              END;
            Pair_Transfer_Token = SELECT t FROM PriorCandidates_Transfer:t -(Transfer_To_Token>:e)- Token:a
              WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transfer_To_Account") == 0
              ACCUM FOREACH sender IN t.@prior_senders DO
                  FOREACH pair_item IN @@pair_items.get(sender + "|Zelle_Transfer|Token:" + a.token_id) DO
                    IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts THEN
                      @@prior_counts += (pair_item.event_key -> 1),
                      @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                      @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                      @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms)
                    END
                  END
              END;
            Pair_Transaction_Account = SELECT t FROM PriorCandidates_Transaction:t -(Transaction_To_Account>:e)- Account:a
              WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
              ACCUM FOREACH sender IN t.@prior_senders DO
                  FOREACH pair_item IN @@pair_items.get(sender + "|Payment_Transaction|Account:" + a.id) DO
                    IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts AND t.payment_rail == pair_item.rail THEN
                      @@prior_counts += (pair_item.event_key -> 1),
                      @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                      @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                      @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms)
                    END
                  END
              END;
            Pair_Transaction_Token = SELECT t FROM PriorCandidates_Transaction:t -(Transaction_To_Token>:e)- Token:a
              WHERE NOT t.@scope_blocked AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transaction_To_Account") == 0
              ACCUM FOREACH sender IN t.@prior_senders DO
                  FOREACH pair_item IN @@pair_items.get(sender + "|Payment_Transaction|Token:" + a.token_id) DO
                    IF t.event_seq < pair_item.seq AND t.event_ts_ms <= pair_item.ts AND t.payment_rail == pair_item.rail THEN
                      @@prior_counts += (pair_item.event_key -> 1),
                      @@prior_last_ts += (pair_item.event_key -> t.event_ts_ms),
                      @@prior_last_seq += (pair_item.event_key -> t.event_seq),
                      @@prior_first_ts += (pair_item.event_key -> t.event_ts_ms)
                    END
                  END
              END;
            Released = SELECT t FROM PriorCandidates:t
              POST-ACCUM t.@prior_senders.clear();
        END;
        FOREACH item IN @@events DO
            event_key = item.relation + ":" + item.event_id;
            previous_ts = 0; gap_present = FALSE;
            pair_prior = 0; pair_first = seed_ts_ms;
            IF use_chronology AND @@event_counts.containsKey(event_key) THEN
                pair_prior = @@event_counts.get(event_key);
                pair_first = @@event_first_times.get(event_key);
                previous_ts = @@event_previous_times.get(event_key);
                gap_present = TRUE;
            END;
            IF use_prior_scan AND @@prior_counts.containsKey(event_key) THEN
                pair_prior = @@prior_counts.get(event_key);
                previous_ts = @@prior_last_ts.get(event_key);
                gap_present = @@prior_last_seq.get(event_key) > 0;
                IF @@prior_first_ts.get(event_key) < pair_first THEN pair_first = @@prior_first_ts.get(event_key); END;
            END;
            pair_first_age = 0.0;
            IF pair_prior > 0 THEN pair_first_age = (item.ts - pair_first) / 1000.0; END;
            flow_seq = 0; flow_ts = 0; flow_amount = 0.0; flow_amount_present = FALSE; flow_rail = "";
            flow_delay = 0.0; flow_ratio = 0.0; flow_ratio_present = FALSE; flow_present = FALSE;
            flow_censored = FALSE; observation_seconds = 0.0;
            /* An Account root's flow: an inflow's next outflow, an outflow's last inflow. */
            IF root_type == "Account" THEN
                FOREACH other IN @@ordered DO
                    IF (item.relation == "zelle_in" OR item.relation == "payment_in")
                      AND (other.relation == "zelle_out" OR other.relation == "payment_out")
                      AND other.seq > item.seq AND other.ts >= item.ts
                      AND (flow_seq == 0 OR other.seq < flow_seq) THEN
                        flow_seq = other.seq; flow_ts = other.ts; flow_amount = other.amount;
                        flow_amount_present = other.amount_present; flow_rail = other.rail;
                    END;
                    IF (item.relation == "zelle_out" OR item.relation == "payment_out")
                      AND (other.relation == "zelle_in" OR other.relation == "payment_in")
                      AND other.seq < item.seq AND other.ts <= item.ts AND other.seq > flow_seq THEN
                        flow_seq = other.seq; flow_ts = other.ts; flow_amount = other.amount;
                        flow_amount_present = other.amount_present; flow_rail = other.rail;
                    END;
                END;
                flow_present = flow_seq > 0;
                IF item.relation == "zelle_in" OR item.relation == "payment_in" THEN
                    observation_seconds = (seed_ts_ms - item.ts) / 1000.0;
                    flow_censored = NOT flow_present;
                    IF flow_present THEN flow_delay = (flow_ts - item.ts) / 1000.0; END;
                    incoming_amount = item.amount; outgoing_amount = flow_amount;
                ELSE
                    IF flow_present THEN flow_delay = (item.ts - flow_ts) / 1000.0; END;
                    incoming_amount = flow_amount; outgoing_amount = item.amount;
                END;
                IF flow_present AND item.amount_present AND flow_amount_present THEN
                    flow_ratio_present = TRUE;
                    IF incoming_amount < 1.0 THEN incoming_amount = 1.0; END;
                    flow_ratio = outgoing_amount / incoming_amount;
                    IF flow_ratio > 100.0 THEN flow_ratio = 100.0; END;
                END;
            END;
            gap_ms = 0;
            age_ms = seed_ts_ms - item.ts;
            IF emit_encodings THEN
                @@age_encoding += (event_key -> encode_fourier64(age_ms));
            END;
            IF gap_present THEN
                gap_ms = item.ts - previous_ts;
                IF emit_encodings THEN
                    @@gap_encoding += (event_key -> encode_fourier64(gap_ms));
                END;
            END;
            @@messages += MessageRow(item.peer_type, item.peer_id, item.relation, item.rail,
              item.event_id, item.seq, item.ts, item.amount, item.amount_present,
              age_ms, gap_ms, gap_present, item.peer_first_ms, item.peer_external, item.peer_deposit,
              pair_prior, pair_first_age, pair_prior > 0,
              flow_delay, flow_present, flow_censored, observation_seconds, flow_ratio,
              flow_ratio_present, flow_present AND flow_rail == item.rail);
        END;
        PRINT "ok" AS status, i AS request_index,
          "context_d7ea81aac6e7" AS contract_version,
          root_type AS node_type, root_id AS node_id,
          seed_seq AS cutoff_seq, seed_ts_ms AS cutoff_ms,
          visibility_phase AS visibility_phase,
          "log1p_s_400d_32x_sincos_v1" AS basis_id,
          @@features AS features, @@messages AS messages,
          @@age_encoding AS age_encoding, @@gap_encoding AS gap_encoding;
    END;
}

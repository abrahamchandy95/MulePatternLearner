USE GRAPH Mule_Pattern_Learner

/* Writes party_ids[i]'s split, splits[i], on the party and on every account it owns: 0 for
   a customer used in training, 1 for one held out. Refuses, writing nothing, a list with a
   repeated or unknown party or another split. The only query that writes. */
CREATE OR REPLACE QUERY write_split(
    LIST<STRING> party_ids,
    LIST<INT> splits
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    ListAccum<STRING> @@ids;
    ListAccum<INT> @@values;
    SetAccum<STRING> @@distinct;
    MapAccum<STRING, MaxAccum<INT>> @@split_of;
    SumAccum<INT> @@invalid, @@accounts;
    MaxAccum<INT> @split;
    @@ids = party_ids;
    @@values = splits;
    IF @@ids.size() < 1 OR @@values.size() != @@ids.size() THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    FOREACH i IN RANGE[0, @@ids.size() - 1] DO
        @@distinct += @@ids.get(i);
        @@split_of += (@@ids.get(i) -> @@values.get(i));
        IF @@values.get(i) != 0 AND @@values.get(i) != 1 THEN
            @@invalid += 1;
        END;
    END;
    IF @@invalid > 0 OR @@distinct.size() != @@ids.size() THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Parties = to_vertex_set(@@distinct, "Party");
    IF Parties.size() != @@distinct.size() THEN
        PRINT "unknown_party" AS status;
        RETURN;
    END;
    Written = SELECT p FROM Parties:p
      POST-ACCUM p.split = @@split_of.get(p.id);
    Owned = SELECT a FROM Parties:p -(Party_Owns_Account>:o)- Account:a
      ACCUM a.@split += @@split_of.get(p.id)
      POST-ACCUM a.split = a.@split, @@accounts += 1;
    PRINT "ok" AS status, Parties.size() AS parties, @@accounts AS accounts;
}

USE GRAPH Mule_Pattern_Learner

/* The leaves of one Monday t (docs/design.md, "Shared rules" and "read_hubs"): the accounts,
   devices and IPs too connected to expand, each with its measure, the distinct customers
   over the 90 days before t.

   - An account hub: more than 200 distinct customers own the other accounts of its payments
     in [t - 90 days, t), through a visible ownership link; an ownerless counterparty is not
     counted, and a self-payment has no other account. An account with at most 200 payments
     in all time cannot be one, so it skips the test: that prefilter reads all-time degrees,
     which changes the cost and never an answer.
   - A crowd: a device or IP with more than 8 distinct customers, registered or not: those
     with a visible enrolment link to it, and the owners, through a visible ownership link, of
     deposit accounts that exist at t and sent a payment seen on it in the lookback. A device
     or IP hub has more than 200 of them.

   Every account hub, crowd and device or IP hub is printed with its measure; a device or IP
   also with observed_only (no customer has a visible enrolment link to it) and hub. B5 and B6
   test leaves inline by the same crowd rule, and the batch builder joins these rows by id.
   Reads no label. t must be a Monday at 00:00 UTC after the lookback's length. */
CREATE OR REPLACE QUERY read_hubs(
    UINT t_ms
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    SetAccum<VERTEX<Party>> @hub_customers, @crowd_customers, @crowd_enrolled;
    SumAccum<INT> @customers_90d;
    OrAccum @observed_only, @hub;
    UINT lookback_ms = 7776000000;
    UINT crowd_threshold = 8;
    UINT hub_threshold = 200;

    /* Mondays are 4 days after the Thursday of 1970-01-01, modulo a week. */
    IF t_ms <= lookback_ms OR t_ms % 604800000 != 345600000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;

    /* Account hubs. */
    Busy = SELECT a FROM Account:a
      WHERE a.opened_ms < t_ms
        AND a.outdegree("Account_Initiated_Transaction")
          + a.outdegree("Account_Received_Transaction")
          + a.outdegree("Account_Sent_Zelle_Transfer")
          + a.outdegree("Account_Received_Zelle_Transfer") > hub_threshold;
    Counted = SELECT a FROM Busy:a
      -((Account_Initiated_Transaction>|Account_Received_Transaction>
        |Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transaction_To_Account>
        |Transfer_From_Account>|Transfer_To_Account>):f)-
      Account:b -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms
        AND b != a AND b.opened_ms < t_ms
        AND o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
      ACCUM a.@hub_customers += q;
    HubAccounts = SELECT a FROM Counted:a
      WHERE a.@hub_customers.size() > hub_threshold
      POST-ACCUM a.@customers_90d += a.@hub_customers.size();

    /* Crowds and device and IP hubs: the customers of each device and IP, through a visible
       enrolment link and through payments seen on it. */
    Nodes = {Device.*, IP.*};
    Enrolled = SELECT d FROM Nodes:d -((Device_Used_By_Party>|IP_Used_By_Party>):l)- Party:q
      WHERE l.valid_from_ms < t_ms
        AND (l.valid_to_ms == 0 OR l.valid_to_ms > t_ms - lookback_ms)
      ACCUM d.@crowd_customers += q, d.@crowd_enrolled += q;
    Seen = SELECT d FROM Nodes:d
      -((Device_Used_By_Transaction>|IP_Observed_In_Transaction>
        |Device_Used_By_Transfer>|IP_Used_By_Transfer>):u)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
      -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms
        AND b.account_type == "deposit" AND b.opened_ms < t_ms
        AND o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
      ACCUM d.@crowd_customers += q;
    Leaves = SELECT d FROM Nodes:d
      WHERE d.@crowd_customers.size() > crowd_threshold
      POST-ACCUM d.@customers_90d += d.@crowd_customers.size(),
        d.@observed_only += d.@crowd_enrolled.size() == 0,
        d.@hub += d.@crowd_customers.size() > hub_threshold;
    DeviceLeaves = SELECT d FROM Leaves:d WHERE d.type == "Device";
    IpLeaves = SELECT d FROM Leaves:d WHERE d.type == "IP";

    PRINT "ok" AS status, "read_hubs-3b28b3433685" AS version;
    PRINT HubAccounts[HubAccounts.id AS account_id,
      HubAccounts.@customers_90d AS customers_90d] AS accounts;
    PRINT DeviceLeaves[DeviceLeaves.id AS node_id, DeviceLeaves.@customers_90d AS customers_90d,
      DeviceLeaves.@observed_only AS observed_only, DeviceLeaves.@hub AS hub] AS devices;
    PRINT IpLeaves[IpLeaves.id AS node_id, IpLeaves.@customers_90d AS customers_90d,
      IpLeaves.@observed_only AS observed_only, IpLeaves.@hub AS hub] AS ips;
}

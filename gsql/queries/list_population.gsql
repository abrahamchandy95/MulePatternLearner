USE GRAPH Mule_Pattern_Learner

/* The accounts on one date, a page at a time by id: every account open at as_of_ms
   (opened_ms <= as_of_ms, and closed_ms 0 or after it) of a customer the phase sees. A
   customer is a party write_split gave a split: 0, and 1 too when held_out_visible.
   Reads no label. */
CREATE OR REPLACE QUERY list_population(
    UINT as_of_ms,
    BOOL held_out_visible,
    STRING after_id,
    INT batch_size
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    IF as_of_ms == 0 OR batch_size < 1 OR batch_size > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Page = SELECT a FROM Account:a
      WHERE a.id > after_id
        AND (a.split == 0 OR (held_out_visible AND a.split == 1))
        AND a.opened_ms <= as_of_ms
        AND (a.closed_ms == 0 OR a.closed_ms > as_of_ms)
      ORDER BY a.id ASC
      LIMIT batch_size;
    PRINT "ok" AS status;
    PRINT Page[Page.id AS account_id, Page.account_type AS account_type,
      Page.opened_ms AS opened_ms, Page.split AS split] AS accounts;
}

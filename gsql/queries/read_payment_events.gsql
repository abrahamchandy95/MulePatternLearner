USE GRAPH Mule_Pattern_Learner

/* reads the payments around each scored account, as of time t.

   From the 90 days before t, for each scored account:
   - its newest 32 payments sent and 32 received;
   - for each account at their other end that is not a hub, that account's newest 16 each way;
   - up to 8 other accounts of the same customer, and the ownership links of these accounts.

   Inputs: t_ms; account_ids, the accounts being scored; hub_accounts, read_hubs' hubs at t.
   Prints: each payment once, with its amount, rail, sender, receiver and timing: its age at t;
   how many earlier payments the same pair made, and the time since the pair's first and last
   one; and the time since the sender's and the receiver's previous payments. Also each account
   once with is_external, and per scored account the ids of its accounts and payments and its
   ownership links.
   Refuses: invalid parameters; a repeated, unknown or not-yet-opened account; a not-yet-opened
   hub. */
CREATE OR REPLACE QUERY read_payment_events(
    UINT t_ms,
    LIST<STRING> account_ids,
    SET<VERTEX<Account>> hub_accounts
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    TYPEDEF TUPLE<INT sec, STRING id, STRING other> Picked;
    TYPEDEF TUPLE<INT sec, STRING id> Sibling;
    TYPEDEF TUPLE<STRING account_id, STRING customer_id> OwnedBy;
    /* The account hubs of t. */
    OrAccum @hub;
    /* A scored account's newest payments, counterparty payments. */
    HeapAccum<Picked>(32, sec DESC, id ASC) @scored_out, @scored_in;
    HeapAccum<Picked>(16, sec DESC, id ASC) @other_out, @other_in;
    /* An account's latest payment in the lookback; a scored account's other accounts of its
       customer, the newest 8. */
    MaxAccum<UINT> @last_active;
    HeapAccum<Sibling>(8, sec DESC, id ASC) @siblings;
    /* A payment's row, its ends and whether each is a hub, and its earlier payments. */
    SumAccum<INT> @amount, @pair_prior_count;
    MaxAccum<STRING> @rail, @sender_id, @receiver_id;
    OrAccum @sender_hub, @receiver_hub, @pair_gap_present, @pair_age_present,
        @sender_gap_present, @receiver_gap_present;
    MinAccum<UINT> @pair_first;
    MaxAccum<UINT> @pair_last, @sender_last, @receiver_last;
    SumAccum<UINT> @age_ms, @pair_gap_ms, @pair_age_ms, @sender_gap_ms, @receiver_gap_ms;
    /* Per scored account by id: its accounts, its payments and its ownership edges; per
       hop-1 account by id, the scored accounts it is a hop-1 account of. */
    MapAccum<STRING, SetAccum<STRING>> @@subgraph_accounts, @@subgraph_payments,
        @@reached_by;
    MapAccum<STRING, SetAccum<OwnedBy>> @@owned_by;
    /* The hop-1 accounts, the accounts and the payments of every subgraph, by id. */
    SetAccum<STRING> @@hop1_ids, @@account_ids, @@payment_ids;
    /* The request's ids, each once, and how many it gave. */
    SetAccum<STRING> @@ids;
    SumAccum<INT> @@given;
    UINT lookback_ms = 7776000000;

    IF t_ms <= lookback_ms OR t_ms % 1000 != 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    FOREACH account_id IN account_ids DO
        @@ids += account_id;
        @@given += 1;
    END;
    IF @@given == 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF @@ids.size() != @@given THEN
        PRINT "duplicate_account" AS status;
        RETURN;
    END;
    Requested = to_vertex_set(@@ids, "Account");
    IF Requested.size() != @@ids.size() THEN
        PRINT "unknown_account" AS status;
        RETURN;
    END;
    Scored = SELECT s FROM Requested:s WHERE s.opened_ms < t_ms;
    IF Scored.size() != Requested.size() THEN
        PRINT "invisible_account" AS status;
        RETURN;
    END;
    Hubs = {hub_accounts};
    HubAccounts = SELECT h FROM Hubs:h WHERE h.opened_ms < t_ms;
    IF HubAccounts.size() != Hubs.size() THEN
        PRINT "invisible_hub" AS status;
        RETURN;
    END;
    Marked = SELECT h FROM HubAccounts:h POST-ACCUM h.@hub += TRUE;

    /* Each scored account's newest 32 payments each way, but self-payments; they and the
       hop-1 accounts at their other ends join its subgraph. */
    ScoredSent = SELECT a FROM Scored:a
        -((Account_Initiated_Transaction>|Account_Sent_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):p
        -((Transaction_To_Account>|Transfer_To_Account>):f)- Account:b
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
        ACCUM
        a.@scored_out += Picked(floor(p.event_ts_ms / 1000), p.id, b.id);
    ScoredReceived = SELECT a FROM Scored:a
        -((Account_Received_Transaction>|Account_Received_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):p
        -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != a
        ACCUM
        a.@scored_in += Picked(floor(p.event_ts_ms / 1000), p.id, b.id);
    ScoredPicked = SELECT a FROM Scored:a
        POST-ACCUM
        @@subgraph_accounts += (a.id -> a.id),
        @@account_ids += a.id,
        FOREACH x IN a.@scored_out DO
            @@subgraph_payments += (a.id -> x.id),
            @@subgraph_accounts += (a.id -> x.other),
            @@account_ids += x.other,
            @@hop1_ids += x.other,
            @@reached_by += (x.other -> a.id),
            @@payment_ids += x.id
        END,
        FOREACH x IN a.@scored_in DO
            @@subgraph_payments += (a.id -> x.id),
            @@subgraph_accounts += (a.id -> x.other),
            @@account_ids += x.other,
            @@hop1_ids += x.other,
            @@reached_by += (x.other -> a.id),
            @@payment_ids += x.id
        END;

    /* The hop-1 accounts are expanded: their newest 16 payments each way,
       but self-payments, and the hop-2 accounts at their other ends join the subgraph of every
       scored account they are a hop-1 account of. */
    Hop1Listed = to_vertex_set(@@hop1_ids, "Account");
    Hop1 = SELECT c FROM Hop1Listed:c WHERE c.opened_ms < t_ms AND NOT c.@hub;
    Hop1Sent = SELECT c FROM Hop1:c
        -((Account_Initiated_Transaction>|Account_Sent_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):p
        -((Transaction_To_Account>|Transfer_To_Account>):f)- Account:b
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != c
        ACCUM
        c.@other_out += Picked(floor(p.event_ts_ms / 1000), p.id, b.id);
    Hop1Received = SELECT c FROM Hop1:c
        -((Account_Received_Transaction>|Account_Received_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):p
        -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND b != c
        ACCUM
        c.@other_in += Picked(floor(p.event_ts_ms / 1000), p.id, b.id);
    Hop1Picked = SELECT c FROM Hop1:c
        POST-ACCUM
        FOREACH x IN c.@other_out DO
            FOREACH i IN @@reached_by.get(c.id) DO
                @@subgraph_payments += (i -> x.id),
                @@subgraph_accounts += (i -> x.other)
            END,
            @@account_ids += x.other,
            @@payment_ids += x.id
        END,
        FOREACH x IN c.@other_in DO
            FOREACH i IN @@reached_by.get(c.id) DO
                @@subgraph_payments += (i -> x.id),
                @@subgraph_accounts += (i -> x.other)
            END,
            @@account_ids += x.other,
            @@payment_ids += x.id
        END;

    /* Other customer accounts */
    Siblings = SELECT b FROM Scored:a -(Account_Owned_By_Party>:o)- Party:q
        -(Party_Owns_Account>:w)- Account:b
        WHERE o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
        AND w.valid_from_ms < t_ms
        AND (w.valid_to_ms == 0 OR w.valid_to_ms > t_ms - lookback_ms)
        AND b.opened_ms < t_ms AND b != a;
    Active = SELECT b FROM Siblings:b
        -((Account_Initiated_Transaction>|Account_Received_Transaction>
        |Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):p
        -((Transaction_From_Account>|Transaction_To_Account>
        |Transfer_From_Account>|Transfer_To_Account>):f)- Account:x
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms AND x != b
        ACCUM b.@last_active += p.event_ts_ms;
    SiblingsRanked = SELECT a FROM Scored:a -(Account_Owned_By_Party>:o)- Party:q
        -(Party_Owns_Account>:w)- Account:b
        WHERE o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
        AND w.valid_from_ms < t_ms
        AND (w.valid_to_ms == 0 OR w.valid_to_ms > t_ms - lookback_ms)
        AND b.opened_ms < t_ms AND b != a
        ACCUM a.@siblings += Sibling(floor(b.@last_active / 1000), b.id);
    SiblingsPicked = SELECT a FROM Scored:a
        POST-ACCUM
        FOREACH x IN a.@siblings DO
            @@subgraph_accounts += (a.id -> x.id),
            @@account_ids += x.id
        END;

    /* The ownership edges: each expanded hop-1 account's to its customer, and that of every
       account of a subgraph that the scored account's customer owns, the scored account among
       them. Any other ownership edge would join two nodes two hops away. */
    ExpandedOwners = SELECT c FROM Hop1:c -(Account_Owned_By_Party>:o)- Party:q
        WHERE o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
        ACCUM
        FOREACH i IN @@reached_by.get(c.id) DO
            @@owned_by += (i -> OwnedBy(c.id, q.id))
        END;
    CustomerAccounts = SELECT a FROM Scored:a -(Account_Owned_By_Party>:o)- Party:q
        -(Party_Owns_Account>:w)- Account:b
        WHERE o.valid_from_ms < t_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - lookback_ms)
        AND w.valid_from_ms < t_ms
        AND (w.valid_to_ms == 0 OR w.valid_to_ms > t_ms - lookback_ms)
        AND b.opened_ms < t_ms
        ACCUM
        IF @@subgraph_accounts.get(a.id).contains(b.id) THEN
            @@owned_by += (a.id -> OwnedBy(b.id, q.id))
        END;

    /* The accounts of every subgraph. Each exists at t: a scored account by its check, a
       payment's end by the loader's, another account of a customer by its own test. */
    AccountsListed = to_vertex_set(@@account_ids, "Account");
    Accounts = SELECT a FROM AccountsListed:a WHERE a.opened_ms < t_ms;

    /* The payments of every subgraph, each with its cents, its rail (zelle for a Zelle
       transfer, which has no payment_rail) and its age; then its ends, and whether each is a
       hub. The ids of both kinds are one set, each resolved to its own kind: to_vertex_set
       drops an id the type lacks, and no id is of both kinds. */
    TransactionsListed = to_vertex_set(@@payment_ids, "Payment_Transaction");
    TransfersListed = to_vertex_set(@@payment_ids, "Zelle_Transfer");
    Transactions = SELECT p FROM TransactionsListed:p
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms
        POST-ACCUM
        INT cents = floor(p.amount * 100 + 0.5),
        p.@amount += cents,
        p.@rail += p.payment_rail,
        p.@age_ms += t_ms - p.event_ts_ms;
    Transfers = SELECT p FROM TransfersListed:p
        WHERE p.event_ts_ms >= t_ms - lookback_ms AND p.event_ts_ms < t_ms
        POST-ACCUM
        INT cents = floor(p.amount * 100 + 0.5),
        p.@amount += cents,
        p.@rail += "zelle",
        p.@age_ms += t_ms - p.event_ts_ms;
    Payments = Transactions UNION Transfers;
    Senders = SELECT p FROM Payments:p
        -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:a
        ACCUM p.@sender_id += a.id, p.@sender_hub += a.@hub;
    Receivers = SELECT p FROM Payments:p
        -((Transaction_To_Account>|Transfer_To_Account>):f)- Account:b
        ACCUM p.@receiver_id += b.id, p.@receiver_hub += b.@hub;

    /* Each payment's earlier payments in [t - 90 days, ts), ts its time, strictly earlier so
       that a payment never counts itself. The receiver's give its gap and the pair's, unless
       the receiver is a hub; the sender's give its gap unless it is a hub, and the pair's
       when the receiver is a hub, whose own 90 days are the longest to read. */
    ReceiverHistory = SELECT p FROM Payments:p
        -((Transaction_To_Account>|Transfer_To_Account>):g)- Account:b
        -((Account_Received_Transaction>|Account_Received_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):q
        -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:a
        WHERE NOT p.@receiver_hub
        AND q.event_ts_ms >= t_ms - lookback_ms AND q.event_ts_ms < p.event_ts_ms AND a != b
        ACCUM
        p.@receiver_last += q.event_ts_ms,
        IF a.id == p.@sender_id THEN
            p.@pair_prior_count += 1,
            p.@pair_first += q.event_ts_ms,
            p.@pair_last += q.event_ts_ms
        END;
    SenderHistory = SELECT p FROM Payments:p
        -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:a
        -((Account_Initiated_Transaction>|Account_Sent_Zelle_Transfer>):e)-
        (Payment_Transaction|Zelle_Transfer):q
        -((Transaction_To_Account>|Transfer_To_Account>):g)- Account:b
        WHERE (NOT p.@sender_hub OR p.@receiver_hub)
        AND q.event_ts_ms >= t_ms - lookback_ms AND q.event_ts_ms < p.event_ts_ms AND b != a
        ACCUM
        IF NOT p.@sender_hub THEN p.@sender_last += q.event_ts_ms END,
        IF p.@receiver_hub AND b.id == p.@receiver_id THEN
            p.@pair_prior_count += 1,
            p.@pair_first += q.event_ts_ms,
            p.@pair_last += q.event_ts_ms
        END;

    /* The gaps, each absent with no earlier payment; every subtraction is of an earlier
       time from a later one. */
    Rows = SELECT p FROM Payments:p
        POST-ACCUM
        IF p.@pair_prior_count > 0 THEN
            p.@pair_gap_present += TRUE,
            p.@pair_gap_ms += p.event_ts_ms - p.@pair_last,
            p.@pair_age_present += TRUE,
            p.@pair_age_ms += p.event_ts_ms - p.@pair_first
        END,
        IF p.@sender_last > 0 THEN
            p.@sender_gap_present += TRUE,
            p.@sender_gap_ms += p.event_ts_ms - p.@sender_last
        END,
        IF p.@receiver_last > 0 THEN
            p.@receiver_gap_present += TRUE,
            p.@receiver_gap_ms += p.event_ts_ms - p.@receiver_last
        END;

    PRINT "ok" AS status, "read_payment_events-011b7ee36654" AS version;
    PRINT Accounts[Accounts.id AS account_id, Accounts.is_external AS is_external] AS accounts;
    PRINT Rows[Rows.id AS payment_id, Rows.@sender_id AS sender_id,
        Rows.@receiver_id AS receiver_id, Rows.@amount AS amount, Rows.@rail AS rail,
        Rows.@age_ms AS age_ms, Rows.@pair_prior_count AS pair_prior_count,
        Rows.@pair_gap_present AS pair_gap_present, Rows.@pair_gap_ms AS pair_gap_ms,
        Rows.@pair_age_present AS pair_age_present, Rows.@pair_age_ms AS pair_age_ms,
        Rows.@sender_gap_present AS sender_gap_present, Rows.@sender_gap_ms AS sender_gap_ms,
        Rows.@receiver_gap_present AS receiver_gap_present,
        Rows.@receiver_gap_ms AS receiver_gap_ms] AS payments;
    PRINT @@subgraph_accounts AS subgraph_accounts;
    PRINT @@subgraph_payments AS subgraph_payments;
    PRINT @@owned_by AS owned_by;
}

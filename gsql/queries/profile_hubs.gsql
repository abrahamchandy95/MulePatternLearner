USE GRAPH Mule_Pattern_Learner

/* For the bench (docs/design.md, "Hubs, crowds and leaves"): histograms on one date of the
   exact measures behind read_leaves's tests, over every account, device and IP. An
   account's measure is the customers owning the other accounts of its payments, with no
   guard on its degree; a device's or IP's is its customers, counted apart for the nodes a
   customer links to (enrolled) and for the observed-only ones; a node neither linked nor
   observed is left out. buckets are ascending lower bounds: bucket j counts the measures from
   buckets[j] up to the next bound, and the last bucket has none. Visibility as in
   read_leaves. */
CREATE OR REPLACE QUERY profile_hubs(
    UINT as_of_ms,
    INT lookback_days,
    LIST<INT> buckets
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MaxAccum<UINT> @last_close;
    OrAccum @stays, @linked, @observed;
    SumAccum<UINT> @left_ms;
    SetAccum<VERTEX<Party>> @customers;
    ListAccum<INT> @@bounds;
    MapAccum<INT, SumAccum<INT>> @@account_hist, @@enrolled_device_hist,
      @@observed_device_hist, @@enrolled_ip_hist, @@observed_ip_hist;
    ListAccum<INT> @@accounts, @@enrolled_devices, @@observed_devices, @@enrolled_ips,
      @@observed_ips;
    UINT day_ms = 86400000;
    UINT window_start = 0;

    @@bounds = buckets;
    IF lookback_days < 30 OR lookback_days > 3650 OR as_of_ms <= lookback_days * day_ms
       OR @@bounds.size() < 1 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    window_start = as_of_ms - lookback_days * day_ms;

    /* Exits count every account whose ownership began before t, whatever its end. */
    Customers = SELECT q FROM Party:q -(Party_Owns_Account>:o)- Account:b
      WHERE o.valid_from_ms < as_of_ms
      ACCUM q.@last_close += b.closed_ms,
        IF b.closed_ms == 0 OR b.closed_ms > as_of_ms THEN q.@stays += TRUE END
      POST-ACCUM IF NOT q.@stays THEN q.@left_ms = q.@last_close END;

    Counterparties = SELECT a FROM Account:a
      -((Account_Initiated_Transaction>|Account_Received_Transaction>
        |Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transaction_To_Account>
        |Transfer_From_Account>|Transfer_To_Account>):f)-
      Account:b -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= window_start AND p.event_ts_ms < as_of_ms AND b != a
        AND o.valid_from_ms < as_of_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND o.valid_to_ms >= q.@left_ms))
      ACCUM a.@customers += q;
    Nodes = {Device.*, IP.*};
    Linked = SELECT n FROM Nodes:n -((Device_Used_By_Party>|IP_Used_By_Party>):l)- Party:q
      WHERE l.valid_from_ms < as_of_ms
        AND (l.valid_to_ms == 0 OR l.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND l.valid_to_ms >= q.@left_ms))
      ACCUM n.@customers += q, n.@linked += TRUE;
    Observed = SELECT n FROM Nodes:n
      -((Device_Used_By_Transaction>|Device_Used_By_Transfer>
        |IP_Observed_In_Transaction>|IP_Used_By_Transfer>):u)-
      (Payment_Transaction|Zelle_Transfer):p
      WHERE p.event_ts_ms >= window_start AND p.event_ts_ms < as_of_ms
      ACCUM n.@observed += TRUE;
    SenderOwners = SELECT n FROM Nodes:n
      -((Device_Used_By_Transaction>|Device_Used_By_Transfer>
        |IP_Observed_In_Transaction>|IP_Used_By_Transfer>):u)-
      (Payment_Transaction|Zelle_Transfer):p
      -((Transaction_From_Account>|Transfer_From_Account>):f)- Account:b
      -(Account_Owned_By_Party>:o)- Party:q
      WHERE p.event_ts_ms >= window_start AND p.event_ts_ms < as_of_ms
        AND o.valid_from_ms < as_of_ms
        AND (o.valid_to_ms == 0 OR o.valid_to_ms > window_start
             OR (q.@left_ms > 0 AND o.valid_to_ms >= q.@left_ms))
      ACCUM n.@customers += q;

    AccountProfiles = SELECT a FROM Account:a
      POST-ACCUM
        INT bucket = -1,
        FOREACH j IN RANGE[0, @@bounds.size() - 1] DO
            IF a.@customers.size() >= @@bounds.get(j) THEN bucket = j END
        END,
        IF bucket >= 0 THEN @@account_hist += (bucket -> 1) END;
    NodeProfiles = SELECT n FROM Nodes:n WHERE n.@linked OR n.@observed
      POST-ACCUM
        INT bucket = -1,
        FOREACH j IN RANGE[0, @@bounds.size() - 1] DO
            IF n.@customers.size() >= @@bounds.get(j) THEN bucket = j END
        END,
        IF bucket >= 0 AND n.type == "Device" AND n.@linked THEN
            @@enrolled_device_hist += (bucket -> 1)
        ELSE IF bucket >= 0 AND n.type == "Device" THEN
            @@observed_device_hist += (bucket -> 1)
        ELSE IF bucket >= 0 AND n.@linked THEN
            @@enrolled_ip_hist += (bucket -> 1)
        ELSE IF bucket >= 0 THEN
            @@observed_ip_hist += (bucket -> 1)
        END;

    FOREACH j IN RANGE[0, @@bounds.size() - 1] DO
        @@accounts += @@account_hist.get(j);
        @@enrolled_devices += @@enrolled_device_hist.get(j);
        @@observed_devices += @@observed_device_hist.get(j);
        @@enrolled_ips += @@enrolled_ip_hist.get(j);
        @@observed_ips += @@observed_ip_hist.get(j);
    END;
    PRINT "ok" AS status, "profile_hubs-6a163fb0e896" AS version, @@bounds AS buckets,
      @@accounts AS accounts, @@enrolled_devices AS enrolled_devices,
      @@observed_devices AS observed_devices, @@enrolled_ips AS enrolled_ips,
      @@observed_ips AS observed_ips;
}

USE GRAPH Mule_Pattern_Learner

/* Splits every Account and Party into train (1), validation (2) and test (3) by ownership
   group, so one owner's accounts never span two splits; a seeded hash of each group picks
   its split by the shares. A graph holds one split, the vertex "split". Reads no labels. */
CREATE OR REPLACE QUERY create_training_scope(
    DOUBLE train_share,
    DOUBLE validation_share,
    DOUBLE test_share,
    UINT split_seed = 42
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MinAccum<UINT> @component;
    OrAccum @shared;
    /* Linking: on an event, its owned deposit endpoints; on an unowned internal account,
       the union over its events. min == max means exactly one distinct counterparty. */
    OrAccum @link_found;
    MinAccum<INT> @link_min;
    MaxAccum<INT> @link_max;
    MinAccum<UINT> @link_component;
    SetAccum<UINT> @@party_components;
    OrAccum @@changed;
    INT iteration = 0;
    IF train_share <= 0 OR validation_share <= 0 OR test_share <= 0
       OR train_share + validation_share + test_share < 0.999999
       OR train_share + validation_share + test_share > 1.000001 THEN
        PRINT "invalid_parameters" AS status; RETURN;
    END;
    Scopes = {Temporal_Training_Scope.*};
    IF Scopes.size() > 0 THEN PRINT "scope_already_exists" AS status; RETURN; END;
    Entities = {Account.*, Party.*};
    Accounts = {Account.*};
    Init = SELECT s FROM Entities:s POST-ACCUM s.@component = getvid(s);
    @@changed = TRUE;
    WHILE @@changed AND iteration < 100 DO
        @@changed = FALSE;
        Propagate = SELECT t FROM Entities:s -((Party_Owns_Account>|Account_Owned_By_Party>):e)- :t
          ACCUM IF s.@component < t.@component THEN
            t.@component += s.@component, @@changed += TRUE
          END;
        iteration = iteration + 1;
    END;
    IF @@changed THEN PRINT "ownership_components_did_not_converge" AS status; RETURN; END;
    /* Unowned accounts: external and "gl" ledger ones are shared (partition 1); an internal
       one with one distinct owned internal deposit counterparty joins that account's group. */
    Parties = {Party.*};
    PartyComponents = SELECT p FROM Parties:p ACCUM @@party_components += p.@component;
    SharedAccounts = SELECT a FROM Accounts:a
      WHERE (a.is_external OR a.account_type == "gl")
        AND NOT @@party_components.contains(a.@component)
      ACCUM a.@shared += TRUE;
    Linkable = SELECT a FROM Accounts:a
      WHERE NOT a.is_external AND a.account_type != "gl"
        AND NOT @@party_components.contains(a.@component);
    LinkPayments = SELECT t FROM Linkable:a
      -((Account_Initiated_Transaction>|Account_Received_Transaction>):e)- Payment_Transaction:t;
    LinkTransfers = SELECT t FROM Linkable:a
      -((Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>):e)- Zelle_Transfer:t;
    PaymentHolders = SELECT t FROM LinkPayments:t
      -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:d
      WHERE d.account_type == "deposit" AND NOT d.is_external
        AND @@party_components.contains(d.@component)
      ACCUM t.@link_found += TRUE, t.@link_min += getvid(d), t.@link_max += getvid(d),
        t.@link_component += d.@component;
    TransferHolders = SELECT t FROM LinkTransfers:t
      -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:d
      WHERE d.account_type == "deposit" AND NOT d.is_external
        AND @@party_components.contains(d.@component)
      ACCUM t.@link_found += TRUE, t.@link_min += getvid(d), t.@link_max += getvid(d),
        t.@link_component += d.@component;
    PaymentLinks = SELECT a FROM PaymentHolders:t
      -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
      WHERE NOT a.is_external AND a.account_type != "gl"
        AND NOT @@party_components.contains(a.@component)
      ACCUM a.@link_found += TRUE, a.@link_min += t.@link_min, a.@link_max += t.@link_max,
        a.@link_component += t.@link_component;
    TransferLinks = SELECT a FROM TransferHolders:t
      -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
      WHERE NOT a.is_external AND a.account_type != "gl"
        AND NOT @@party_components.contains(a.@component)
      ACCUM a.@link_found += TRUE, a.@link_min += t.@link_min, a.@link_max += t.@link_max,
        a.@link_component += t.@link_component;
    Linked = SELECT a FROM Linkable:a
      WHERE a.@link_found AND a.@link_min == a.@link_max
      POST-ACCUM a.@component = a.@link_component;
    INSERT INTO Temporal_Training_Scope VALUES (
      "split", split_seed, train_share, validation_share, test_share, FALSE);
    Membership = SELECT s FROM Entities:s
      ACCUM INSERT INTO Entity_In_Training_Scope VALUES (
          s, "split" Temporal_Training_Scope,
          CASE WHEN s.@shared THEN 1
               WHEN ((((s.@component % 2147483647) * 1103515245 + split_seed) % 2147483647) % 10000 + 0.5) / 10000 < train_share THEN 1
               WHEN ((((s.@component % 2147483647) * 1103515245 + split_seed) % 2147483647) % 10000 + 0.5) / 10000 < train_share + validation_share THEN 2
               ELSE 3 END);
    PRINT "ok" AS status, Entities.size() AS expected_members;
}

/* The split's internal deposit accounts, by id. observed_positive and known_from_ms are
   the revealed label (pu_label 1) and its discovery time; no other label leaves. */
CREATE OR REPLACE QUERY list_scope_accounts(
    STRING after_id = "",
    INT batch_size = 10000
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MaxAccum<INT> @partition;
    OrAccum @positive;
    MaxAccum<UINT> @known_ms;
    IF batch_size < 1 OR batch_size > 10000 THEN PRINT "invalid_batch_size" AS status; RETURN; END;
    Scopes = {Temporal_Training_Scope.*};
    ReadyScope = SELECT r FROM Scopes:r WHERE r.ready;
    IF ReadyScope.size() != 1 THEN PRINT "scope_not_ready" AS status; RETURN; END;
    Accounts = SELECT a FROM ReadyScope:r -(Training_Scope_Has_Entity>:e)- Account:a
      WHERE a.id > after_id AND a.account_type == "deposit" AND NOT a.is_external
      ACCUM a.@partition += e.partition
      ORDER BY a.id ASC LIMIT batch_size;
    Labels = SELECT a FROM Accounts:a
      WHERE a.pu_label == 1
      ACCUM a.@positive += TRUE, a.@known_ms += a.mule_label_available_ts_ms;
    PRINT "ok" AS status;
    PRINT Accounts[Accounts.id AS account_id, Accounts.first_seen_ts_ms AS first_seen_ts_ms,
      Accounts.@partition AS partition, Accounts.@positive AS observed_positive,
      Accounts.@known_ms AS known_from_ms] AS accounts;
}

/* A separate query sees committed membership writes and verifies completeness. */
CREATE OR REPLACE QUERY finalize_training_scope(UINT expected_members)
    FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    SumAccum<UINT> @@members;
    SumAccum<UINT> @@invalid;
    Scopes = {Temporal_Training_Scope.*};
    IF Scopes.size() != 1 OR expected_members == 0 THEN PRINT "invalid_scope" AS status; RETURN; END;
    Members = SELECT a FROM Scopes:r -(Training_Scope_Has_Entity>:e)- :a
      ACCUM @@members += 1,
        IF e.partition < 1 OR e.partition > 3 THEN @@invalid += 1 END;
    IF @@members != expected_members OR @@invalid > 0 THEN
        PRINT "incomplete_membership" AS status, @@members AS members; RETURN;
    END;
    Mark = SELECT r FROM Scopes:r POST-ACCUM r.ready = TRUE;
    PRINT "ok" AS status, @@members AS members;
}

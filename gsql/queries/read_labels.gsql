USE GRAPH Mule_Pattern_Learner

/* read_labels: the mules the bank identified, and when each was active.

   Inputs: after_id and page, to read the accounts a page at a time by increasing id, 1 to
   10,000 a page.
   Prints: accounts, the account_id, mule_onset_ms and mule_last_ms of the accounts with
   pu_label 1 and an id above after_id, at most page of them.
   Refuses: invalid_parameters, for a page out of range; invalid_activity, naming the accounts
   of the page that lack 0 < mule_onset_ms <= mule_last_ms.

   These are the only training labels, and this is the only query that reads pu_label
   (docs/design.md, "read_labels"). The dates are read only from the accounts the pu_label 1
   selection keeps, so a hidden mule's dates never leave the graph. */
CREATE OR REPLACE QUERY read_labels(
    STRING after_id,
    INT page
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    SetAccum<STRING> @@invalid;

    IF page < 1 OR page > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Identified = SELECT a FROM Account:a
      WHERE a.pu_label == 1 AND a.id > after_id
      ORDER BY a.id ASC
      LIMIT page;
    Invalid = SELECT a FROM Identified:a
      WHERE a.mule_onset_ms == 0 OR a.mule_onset_ms > a.mule_last_ms
      POST-ACCUM @@invalid += a.id;
    IF Invalid.size() > 0 THEN
        PRINT "invalid_activity" AS status, @@invalid AS accounts;
        RETURN;
    END;
    PRINT "ok" AS status, "read_labels-e22e410b15e2" AS version;
    PRINT Identified[Identified.id AS account_id, Identified.mule_onset_ms AS mule_onset_ms,
      Identified.mule_last_ms AS mule_last_ms] AS accounts;
}

USE GRAPH Mule_Pattern_Learner

/* What identifies the loaded world (docs/design.md, "Extraction and caching"), all
   integers: the count of every vertex and edge type and of each account_type and
   payment_rail value, and the external accounts; sums in whole seconds of the times; sums
   of the amounts in cents; per edge type, reverse ones included, the sum over its source
   vertices of their squared degree; and the earliest joined_ms and the earliest and latest
   payment, which bound the data. Reads no label. */
CREATE OR REPLACE QUERY read_world() FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    MapAccum<STRING, SumAccum<INT>> @degree;
    MapAccum<STRING, SumAccum<INT>> @@vertices, @@edges, @@account_types, @@payment_rails,
      @@seconds, @@cents, @@squared_degrees;
    SumAccum<INT> @@external_accounts;
    MinAccum<UINT> @@first_joined_ms, @@first_event_ms;
    MaxAccum<UINT> @@last_event_ms;

    Parties = SELECT q FROM Party:q
      POST-ACCUM @@vertices += ("Party" -> 1),
        @@seconds += ("Party.joined_ms" -> floor(q.joined_ms / 1000)),
        @@first_joined_ms += q.joined_ms;
    Accounts = SELECT a FROM Account:a
      POST-ACCUM @@vertices += ("Account" -> 1),
        @@account_types += (a.account_type -> 1),
        IF a.is_external THEN @@external_accounts += 1 END,
        @@seconds += ("Account.opened_ms" -> floor(a.opened_ms / 1000)),
        @@seconds += ("Account.closed_ms" -> floor(a.closed_ms / 1000));
    Transactions = SELECT p FROM Payment_Transaction:p
      POST-ACCUM @@vertices += ("Payment_Transaction" -> 1),
        @@payment_rails += (p.payment_rail -> 1),
        @@seconds += ("Payment_Transaction.event_ts_ms" -> floor(p.event_ts_ms / 1000)),
        @@cents += ("Payment_Transaction" -> floor(p.amount * 100 + 0.5)),
        @@first_event_ms += p.event_ts_ms, @@last_event_ms += p.event_ts_ms;
    Transfers = SELECT p FROM Zelle_Transfer:p
      POST-ACCUM @@vertices += ("Zelle_Transfer" -> 1),
        @@seconds += ("Zelle_Transfer.event_ts_ms" -> floor(p.event_ts_ms / 1000)),
        @@cents += ("Zelle_Transfer" -> floor(p.amount * 100 + 0.5)),
        @@first_event_ms += p.event_ts_ms, @@last_event_ms += p.event_ts_ms;
    Others = SELECT v FROM (Token|Device|IP|Address):v
      POST-ACCUM @@vertices += (v.type -> 1);

    /* The link times. */
    PartyLinks = SELECT q FROM Party:q
      -((Party_Owns_Account>|Party_Uses_Token>|Party_Uses_Device>|Party_Uses_IP>
        |Party_Has_Address>):l)- (Account|Token|Device|IP|Address):x
      ACCUM @@seconds += (l.type + ".valid_from_ms" -> floor(l.valid_from_ms / 1000)),
        @@seconds += (l.type + ".valid_to_ms" -> floor(l.valid_to_ms / 1000));
    TokenLinks = SELECT k FROM Token:k -(Token_Bound_To_Account>:l)- Account:x
      ACCUM @@seconds += (l.type + ".valid_from_ms" -> floor(l.valid_from_ms / 1000)),
        @@seconds += (l.type + ".valid_to_ms" -> floor(l.valid_to_ms / 1000));
    AccountLinks = SELECT a FROM Account:a -(Account_Uses_Device>:l)- Device:x
      ACCUM @@seconds += (l.type + ".valid_from_ms" -> floor(l.valid_from_ms / 1000)),
        @@seconds += (l.type + ".valid_to_ms" -> floor(l.valid_to_ms / 1000));

    /* Every edge type's count and squared degrees, from each of its source types. */
    Degrees = SELECT v FROM (Party|Account|Token|Device|IP|Address):v
      -((Party_Owns_Account>|Party_Uses_Token>|Party_Uses_Device>|Party_Uses_IP>
        |Party_Has_Address>|Account_Owned_By_Party>|Account_Bound_From_Token>
        |Account_Uses_Device>|Account_Sent_Zelle_Transfer>|Account_Received_Zelle_Transfer>
        |Account_Initiated_Transaction>|Account_Received_Transaction>|Token_Used_By_Party>
        |Token_Bound_To_Account>|Token_Sent_Transfer>|Token_Received_Transfer>
        |Token_Sent_Transaction>|Token_Received_Transaction>|Device_Used_By_Party>
        |Device_Used_By_Account>|Device_Used_By_Transfer>|Device_Used_By_Transaction>
        |IP_Used_By_Party>|IP_Used_By_Transfer>|IP_Observed_In_Transaction>
        |Address_Used_By_Party>):e)-
      (Party|Account|Token|Device|IP|Address|Payment_Transaction|Zelle_Transfer):x
      ACCUM v.@degree += (e.type -> 1)
      POST-ACCUM
        FOREACH (kind, degree) IN v.@degree DO
            @@edges += (kind -> degree), @@squared_degrees += (kind -> degree * degree)
        END;
    PaymentDegrees = SELECT p FROM (Payment_Transaction|Zelle_Transfer):p
      -((Transfer_From_Account>|Transfer_To_Account>|Transfer_From_Token>|Transfer_To_Token>
        |Transfer_Used_Device>|Transfer_Used_IP>|Transaction_From_Account>
        |Transaction_To_Account>|Transaction_From_Token>|Transaction_To_Token>
        |Transaction_Used_Device>|Transaction_Used_IP>):e)-
      (Account|Token|Device|IP):x
      ACCUM p.@degree += (e.type -> 1)
      POST-ACCUM
        FOREACH (kind, degree) IN p.@degree DO
            @@edges += (kind -> degree), @@squared_degrees += (kind -> degree * degree)
        END;

    PRINT "ok" AS status, "read_world-01bb14aa371d" AS version, @@vertices AS vertices,
      @@edges AS edges, @@account_types AS account_types, @@payment_rails AS payment_rails,
      @@external_accounts AS external_accounts, @@seconds AS seconds, @@cents AS cents,
      @@squared_degrees AS squared_degrees, @@first_joined_ms AS first_joined_ms,
      @@first_event_ms AS first_event_ms, @@last_event_ms AS last_event_ms;
}

USE GRAPH Mule_Pattern_Learner
CREATE OR REPLACE QUERY read_world() FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {

    /* Vertex and edge types, each a set so that one pattern serves transactions and transfers */
    SetAccum<STRING> @@target_vertex_type; // An account, a token, a device or an IP
    SetAccum<STRING> @@customer_to_target_edge_type; // Party -> the accounts it owns, the tokens, devices and IPs it uses
    SetAccum<STRING> @@token_to_account_edge_type; // Token -> the account it is bound to
    SetAccum<STRING> @@payment_to_target_edge_type; // Payment -> its accounts, tokens, devices and IPs
    @@target_vertex_type += "Account";
    @@target_vertex_type += "Token";
    @@target_vertex_type += "Device";
    @@target_vertex_type += "IP";
    @@customer_to_target_edge_type += "Party_Owns_Account";
    @@customer_to_target_edge_type += "Party_Uses_Token";
    @@customer_to_target_edge_type += "Party_Uses_Device";
    @@customer_to_target_edge_type += "Party_Uses_IP";
    @@token_to_account_edge_type += "Token_Bound_To_Account";
    @@payment_to_target_edge_type += "Transaction_From_Account";
    @@payment_to_target_edge_type += "Transaction_To_Account";
    @@payment_to_target_edge_type += "Transaction_Used_Device";
    @@payment_to_target_edge_type += "Transaction_Used_IP";
    @@payment_to_target_edge_type += "Transfer_From_Account";
    @@payment_to_target_edge_type += "Transfer_To_Account";
    @@payment_to_target_edge_type += "Transfer_From_Token";
    @@payment_to_target_edge_type += "Transfer_To_Token";
    @@payment_to_target_edge_type += "Transfer_Used_Device";
    @@payment_to_target_edge_type += "Transfer_Used_IP";

    /* Accumulators */
    MapAccum<STRING, SumAccum<INT>> @out_degree, @in_degree; // A vertex's edges out and in, per edge type
    MapAccum<STRING, SumAccum<INT>> @@vertices; // Vertex type -> how many
    MapAccum<STRING, SumAccum<INT>> @@edges; // Edge type -> how many
    MapAccum<STRING, SumAccum<INT>> @@account_types; // account_type -> how many accounts
    MapAccum<STRING, SumAccum<INT>> @@payment_rails; // payment_rail -> how many transactions
    SumAccum<INT> @@external_accounts; // How many accounts are external
    MapAccum<STRING, SumAccum<INT>> @@seconds; // "<type>.<attribute>" -> its times summed in whole seconds
    MapAccum<STRING, SumAccum<INT>> @@cents; // Payment type -> its amounts summed in cents
    MapAccum<STRING, SumAccum<INT>> @@squared_degrees; // Edge type -> its sources' squared degrees, summed
    MapAccum<STRING, SumAccum<INT>> @@squared_target_degrees; // Edge type -> its targets' squared degrees, summed
    MapAccum<STRING, SumAccum<INT>> @@degree_products; // Edge type -> both ends' degrees multiplied, summed over its edges
    MinAccum<UINT> @@first_joined_ms, @@first_event_ms; // The first join, the first payment
    MaxAccum<UINT> @@last_event_ms; // The last payment

    /* Count the parties, with their join times */
    customers = SELECT q
        FROM Party:q
        POST-ACCUM
            @@vertices += ( "Party" -> 1 ),
            @@seconds += ( "Party.joined_ms" -> floor(q.joined_ms / 1000) ),
            @@first_joined_ms += q.joined_ms
    ;

    /* Count the accounts, with their types, the external ones, and their opening and closing times */
    accounts = SELECT a
        FROM Account:a
        POST-ACCUM
            @@vertices += ( "Account" -> 1 ),
            @@account_types += ( a.account_type -> 1 ),
            IF a.is_external THEN
                @@external_accounts += 1
            END,
            @@seconds += ( "Account.opened_ms" -> floor(a.opened_ms / 1000) ),
            @@seconds += ( "Account.closed_ms" -> floor(a.closed_ms / 1000) )
    ;

    /* Count the tokens, devices and IPs */
    tokens = SELECT k
        FROM Token:k
        POST-ACCUM
            @@vertices += ( k.type -> 1 )
    ;
    devices = SELECT d
        FROM Device:d
        POST-ACCUM
            @@vertices += ( d.type -> 1 )
    ;
    ips = SELECT i
        FROM IP:i
        POST-ACCUM
            @@vertices += ( i.type -> 1 )
    ;

    /* Count the transactions, with their rails, times and cents */
    transactions = SELECT p
        FROM Payment_Transaction:p
        POST-ACCUM
            @@vertices += ( "Payment_Transaction" -> 1 ),
            @@payment_rails += ( p.payment_rail -> 1 ),
            @@seconds += ( "Payment_Transaction.event_ts_ms" -> floor(p.event_ts_ms / 1000) ),
            @@cents += ( "Payment_Transaction" -> floor(p.amount * 100 + 0.5) ),
            @@first_event_ms += p.event_ts_ms,
            @@last_event_ms += p.event_ts_ms
    ;

    /* Count the transfers, with their times and cents */
    transfers = SELECT p
        FROM Zelle_Transfer:p
        POST-ACCUM
            @@vertices += ( "Zelle_Transfer" -> 1 ),
            @@seconds += ( "Zelle_Transfer.event_ts_ms" -> floor(p.event_ts_ms / 1000) ),
            @@cents += ( "Zelle_Transfer" -> floor(p.amount * 100 + 0.5) ),
            @@first_event_ms += p.event_ts_ms,
            @@last_event_ms += p.event_ts_ms
    ;

    payments = transactions UNION transfers;

    /* Traverse: Party -> its accounts, tokens, devices and IPs, counting degrees and summing each link's start and end */
    customer_targets = SELECT x
        FROM customers:q - (@@customer_to_target_edge_type>:e) - @@target_vertex_type:x
        ACCUM
            q.@out_degree += ( e.type -> 1 ),
            x.@in_degree += ( e.type -> 1 ),
            @@seconds += ( e.type + ".valid_from_ms" -> floor(e.valid_from_ms / 1000) ),
            @@seconds += ( e.type + ".valid_to_ms" -> floor(e.valid_to_ms / 1000) )
    ;

    /* Traverse: Token -> its account, counting degrees and summing each link's start and end */
    token_targets = SELECT x
        FROM tokens:k - (@@token_to_account_edge_type>:e) - Account:x
        ACCUM
            k.@out_degree += ( e.type -> 1 ),
            x.@in_degree += ( e.type -> 1 ),
            @@seconds += ( e.type + ".valid_from_ms" -> floor(e.valid_from_ms / 1000) ),
            @@seconds += ( e.type + ".valid_to_ms" -> floor(e.valid_to_ms / 1000) )
    ;

    /* Traverse: Payment -> its accounts, tokens, devices and IPs, counting degrees */
    payment_targets = SELECT x
        FROM payments:p - (@@payment_to_target_edge_type>:e) - @@target_vertex_type:x
        ACCUM
            p.@out_degree += ( e.type -> 1 ),
            x.@in_degree += ( e.type -> 1 )
    ;

    sources = customers UNION tokens UNION payments;
    targets = accounts UNION tokens UNION devices UNION ips;

    /* Sum each edge type's edges and its sources' squared degrees */
    source_degrees = SELECT v
        FROM sources:v
        POST-ACCUM
            FOREACH (kind, degree) IN v.@out_degree DO
                @@edges += ( kind -> degree ),
                @@squared_degrees += ( kind -> degree * degree )
            END
    ;

    /* Sum each edge type's targets' squared degrees */
    target_degrees = SELECT v
        FROM targets:v
        POST-ACCUM
            FOREACH (kind, degree) IN v.@in_degree DO
                @@squared_target_degrees += ( kind -> degree * degree )
            END
    ;

    /* Traverse: Party -> its accounts, tokens, devices and IPs, multiplying both ends' degrees */
    customer_products = SELECT x
        FROM customers:q - (@@customer_to_target_edge_type>:e) - @@target_vertex_type:x
        ACCUM
            @@degree_products += ( e.type -> q.@out_degree.get(e.type) * x.@in_degree.get(e.type) )
    ;

    /* Traverse: Token -> its account, multiplying both ends' degrees */
    token_products = SELECT x
        FROM tokens:k - (@@token_to_account_edge_type>:e) - Account:x
        ACCUM
            @@degree_products += ( e.type -> k.@out_degree.get(e.type) * x.@in_degree.get(e.type) )
    ;

    /* Traverse: Payment -> its accounts, tokens, devices and IPs, multiplying both ends' degrees */
    payment_products = SELECT x
        FROM payments:p - (@@payment_to_target_edge_type>:e) - @@target_vertex_type:x
        ACCUM
            @@degree_products += ( e.type -> p.@out_degree.get(e.type) * x.@in_degree.get(e.type) )
    ;

    /* Printing the world's counts and sums */
    PRINT "ok" AS status,
        @@vertices AS vertices,
        @@edges AS edges,
        @@account_types AS account_types,
        @@payment_rails AS payment_rails,
        @@external_accounts AS external_accounts,
        @@seconds AS seconds,
        @@cents AS cents,
        @@squared_degrees AS squared_degrees,
        @@squared_target_degrees AS squared_target_degrees,
        @@degree_products AS degree_products,
        @@first_joined_ms AS first_joined_ms,
        @@first_event_ms AS first_event_ms,
        @@last_event_ms AS last_event_ms;

}

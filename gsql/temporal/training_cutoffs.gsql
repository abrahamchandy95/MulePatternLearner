USE GRAPH Mule_Pattern_Learner

/* Resolve calendar cutoffs once when preparing a dataset, never per batch.
   A full scan is intentional; unknown association timestamps are not invented.
   Associations after the last witnessed sequence remain conservatively hidden. */
CREATE OR REPLACE QUERY temporal_training_cutoffs(LIST<UINT> cutoff_times)
FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
  ListAccum<UINT> @@times;
  MapAccum<UINT, MaxAccum<UINT>> @@sequences;
  @@times = cutoff_times;
  IF @@times.size() < 1 OR @@times.size() > 24 THEN
    PRINT "invalid_cutoffs" AS status; RETURN;
  END;
  Events = {Zelle_Transfer.*, Payment_Transaction.*};
  ScanEvents = SELECT t FROM Events:t
    ACCUM FOREACH cutoff IN @@times DO
      IF t.event_ts_ms <= cutoff THEN @@sequences += (cutoff -> t.event_seq) END
    END;
  Entities = {Account.*, Token.*, Party.*, Device.*, IP.*, Address.*};
  ScanEntities = SELECT t FROM Entities:t
    ACCUM FOREACH cutoff IN @@times DO
      IF t.first_seen_ts_ms <= cutoff THEN @@sequences += (cutoff -> t.first_seen_seq) END
    END;
  PRINT "ok" AS status, @@sequences AS last_visible_seqs;
}

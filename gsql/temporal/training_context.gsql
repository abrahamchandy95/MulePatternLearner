              ACCUM @@recipient_count += 1, @@recipient_id += a.id,
                @@invalid += (e.event_seq != item.seq OR e.event_ts_ms != item.ts
                  OR a.first_seen_seq > item.seq OR a.first_seen_ts_ms > item.ts);
            Role_Transfer_To_Token = SELECT a FROM Event:t -(Transfer_To_Token>:e)- Token:a
              ACCUM @@token_count += 1, @@token_id += a.token_id,
                @@invalid += (e.event_seq != item.seq OR e.event_ts_ms != item.ts
                  OR a.first_seen_seq > item.seq OR a.first_seen_ts_ms > item.ts);
          END;
      IF item.event_type == "Payment_Transaction" THEN
        Role_Transaction_From_Account = SELECT a FROM Event:t -(Transaction_From_Account>:e)- Account:a
              ACCUM @@sender_count += 1, @@sender_id += a.id, @@sender_vertices += a,
                @@invalid += (e.event_seq != item.seq OR e.event_ts_ms != item.ts
                  OR a.first_seen_seq > item.seq OR a.first_seen_ts_ms > item.ts);
            Role_Transaction_To_Account = SELECT a FROM Event:t -(Transaction_To_Account>:e)- Account:a
              ACCUM @@recipient_count += 1, @@recipient_id += a.id,
                @@invalid += (e.event_seq != item.seq OR e.event_ts_ms != item.ts
                  OR a.first_seen_seq > item.seq OR a.first_seen_ts_ms > item.ts);
            Role_Transaction_To_Token = SELECT a FROM Event:t -(Transaction_To_Token>:e)- Token:a
              ACCUM @@token_count += 1, @@token_id += a.token_id,
                @@invalid += (e.event_seq != item.seq OR e.event_ts_ms != item.ts
                  OR a.first_seen_seq > item.seq OR a.first_seen_ts_ms > item.ts);
          END;
      IF @@invalid OR @@sender_count != 1 OR @@recipient_count > 1 OR @@token_count > 1
         OR (@@recipient_count == 0 AND @@token_count == 0) THEN
        PRINT "invalid_event_roles" AS status, i AS request_index;
        RETURN;
      END;
      recipient_type = "Account"; recipient_id = @@recipient_id;
      IF @@recipient_count == 0 THEN recipient_type = "Token"; recipient_id = @@token_id; END;
      peer_type = recipient_type; peer_id = recipient_id;
      IF item.relation == "zelle_in" OR item.relation == "payment_in" THEN
        peer_type = "Account"; peer_id = @@sender_id;
      END;
      @@previous_ts = 0; @@previous_seq = 0;
      @@pair_1h = 0; @@pair_1d = 0; @@pair_7d = 0;
      Senders = {@@sender_vertices};
      IF item.event_type == "Zelle_Transfer" THEN
            PriorCandidates = SELECT t FROM Senders:s -(Account_Sent_Zelle_Transfer>:e)- Zelle_Transfer:t
              WHERE t.event_seq < item.seq AND t.event_ts_ms <= item.ts
                AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms;
        IF scope_id != "" THEN
      Endpoints_prior_Transfer = SELECT a FROM PriorCandidates:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_prior_Transfer = SELECT v FROM Endpoints_prior_Transfer:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_prior_Transfer = SELECT t FROM PriorCandidates:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Prior = SELECT t FROM PriorCandidates:t WHERE NOT t.@scope_blocked;
        IF recipient_type == "Account" THEN
              Pair_Transfer_Account = SELECT t FROM Prior:t -(Transfer_To_Account>:e)- Account:a
                WHERE a.id == recipient_id
                  AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
                ACCUM @@previous_ts += t.event_ts_ms, @@previous_seq += t.event_seq,
                  IF item.ts - t.event_ts_ms < 3600000 THEN @@pair_1h += 1 END,
                  IF item.ts - t.event_ts_ms < 86400000 THEN @@pair_1d += 1 END,
                  IF item.ts - t.event_ts_ms < 604800000 THEN @@pair_7d += 1 END;
            END;
            IF recipient_type == "Token" THEN
              Pair_Transfer_Token = SELECT t FROM Prior:t -(Transfer_To_Token>:e)- Token:a
                WHERE a.token_id == recipient_id AND t.outdegree("Transfer_To_Account") == 0
                  AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
                ACCUM @@previous_ts += t.event_ts_ms, @@previous_seq += t.event_seq,
                  IF item.ts - t.event_ts_ms < 3600000 THEN @@pair_1h += 1 END,
                  IF item.ts - t.event_ts_ms < 86400000 THEN @@pair_1d += 1 END,
                  IF item.ts - t.event_ts_ms < 604800000 THEN @@pair_7d += 1 END;
            END;
          END;
      IF item.event_type == "Payment_Transaction" THEN
            PriorCandidates = SELECT t FROM Senders:s -(Account_Initiated_Transaction>:e)- Payment_Transaction:t
              WHERE t.event_seq < item.seq AND t.event_ts_ms <= item.ts
                AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.payment_rail == item.rail;
        IF scope_id != "" THEN
      Endpoints_prior_Transaction = SELECT a FROM PriorCandidates:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_prior_Transaction = SELECT v FROM Endpoints_prior_Transaction:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_prior_Transaction = SELECT t FROM PriorCandidates:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Prior = SELECT t FROM PriorCandidates:t WHERE NOT t.@scope_blocked;
        IF recipient_type == "Account" THEN
              Pair_Transaction_Account = SELECT t FROM Prior:t -(Transaction_To_Account>:e)- Account:a
                WHERE a.id == recipient_id
                  AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
                ACCUM @@previous_ts += t.event_ts_ms, @@previous_seq += t.event_seq,
                  IF item.ts - t.event_ts_ms < 3600000 THEN @@pair_1h += 1 END,
                  IF item.ts - t.event_ts_ms < 86400000 THEN @@pair_1d += 1 END,
                  IF item.ts - t.event_ts_ms < 604800000 THEN @@pair_7d += 1 END;
            END;
            IF recipient_type == "Token" THEN
              Pair_Transaction_Token = SELECT t FROM Prior:t -(Transaction_To_Token>:e)- Token:a
                WHERE a.token_id == recipient_id AND t.outdegree("Transaction_To_Account") == 0
                  AND e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
                ACCUM @@previous_ts += t.event_ts_ms, @@previous_seq += t.event_seq,
                  IF item.ts - t.event_ts_ms < 3600000 THEN @@pair_1h += 1 END,
                  IF item.ts - t.event_ts_ms < 86400000 THEN @@pair_1d += 1 END,
                  IF item.ts - t.event_ts_ms < 604800000 THEN @@pair_7d += 1 END;
            END;
          END;
      gap_ms = 0;
      age_ms = seed_ts_ms - item.ts;
      event_key = item.relation + ":" + item.event_id;
      @@age_encoding += (event_key -> temporal_fourier64_values(age_ms));
      IF @@previous_seq > 0 THEN
        gap_ms = item.ts - @@previous_ts;
        @@gap_encoding += (event_key -> temporal_fourier64_values(gap_ms));
      END;
      @@peer_first_ms = 0; @@peer_external = FALSE; @@peer_deposit = FALSE;
      peer_vertex = to_vertex(peer_id, peer_type);
      Peer = {peer_vertex};
      PeerMeta = SELECT p FROM Peer:p
        ACCUM @@peer_first_ms += p.getAttr("first_seen_ts_ms", "UINT");
      IF peer_type == "Account" THEN
        PeerAccount = SELECT p FROM Peer:p
          ACCUM @@peer_external += p.getAttr("is_external", "BOOL"),
            @@peer_deposit += (p.getAttr("account_type", "STRING") == "deposit");
      END;
      @@messages += MessageRow(peer_type, peer_id, item.relation, item.rail,
        item.event_id, item.seq, item.ts,
        item.amount, item.amount_present,
        age_ms, gap_ms, @@previous_seq > 0, @@pair_1h, @@pair_1d, @@pair_7d,
        @@peer_first_ms, @@peer_external, @@peer_deposit);
    END;
    PRINT "ok" AS status, i AS request_index,
      @@request_types.get(i) AS node_type, @@request_ids.get(i) AS node_id,
      seed_seq AS cutoff_seq, seed_ts_ms AS cutoff_ms,
      scope_id AS scope_id, visibility_phase AS visibility_phase,
      "log1p_s_400d_32x_sincos_v1" AS basis_id,
      @@features AS features, @@messages AS messages,
      @@age_encoding AS age_encoding, @@gap_encoding AS gap_encoding;
  END;
}

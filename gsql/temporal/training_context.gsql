USE GRAPH Mule_Pattern_Learner

/* Generated by scripts/temporal/render_training_queries.py. Read-only.
   Each request has independent clocks. Labels and persisted feature caches
   are deliberately absent. Bounded response; adjacency scans are not indexed
   by time and may still be expensive for high-degree entities. */
CREATE OR REPLACE QUERY temporal_training_context(
  LIST<STRING> node_types, LIST<STRING> node_ids,
  LIST<UINT> cutoff_seqs, LIST<UINT> cutoff_times,
  INT per_relation = 2, STRING scope_id = "", INT visibility_phase = 3
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
  TYPEDEF TUPLE<UINT seq, UINT ts, STRING event_id, STRING event_type,
                STRING relation, STRING rail, DOUBLE amount, BOOL amount_present> EventRow;
  TYPEDEF TUPLE<STRING node_type, STRING node_id, STRING relation,
                STRING rail, STRING event_id, UINT event_seq, UINT event_ts_ms,
                DOUBLE amount, BOOL amount_present, UINT age_ms,
                UINT gap_ms, BOOL gap_present, INT pair_count_1h,
                INT pair_count_1d, INT pair_count_7d, UINT peer_first_ms,
                BOOL peer_external, BOOL peer_deposit> MessageRow;
  TYPEDEF TUPLE<UINT seq, STRING node_id, UINT first_ms, BOOL external, BOOL deposit> AssociationRow;
  HeapAccum<EventRow>(8, seq DESC, event_id ASC) @@zelle_out, @@zelle_in,
    @@payment_out, @@payment_in;
  HeapAccum<AssociationRow>(8, seq DESC, node_id ASC) @@association;
  ListAccum<EventRow> @@events;
  ListAccum<MessageRow> @@messages;
  MapAccum<STRING, SumAccum<DOUBLE>> @@features;
  MapAccum<STRING, SetAccum<STRING>> @@distinct;
  MapAccum<STRING, ListAccum<DOUBLE>> @@age_encoding, @@gap_encoding;
  MaxAccum<UINT> @@out_last, @@in_last, @@previous_ts, @@previous_seq;
  SumAccum<INT> @@sender_count, @@recipient_count, @@token_count;
  MaxAccum<STRING> @@sender_id, @@recipient_id, @@token_id;
  SetAccum<VERTEX> @@sender_vertices;
  OrAccum @@invalid;
  OrAccum @scope_allowed, @scope_blocked;
  SumAccum<INT> @@pair_1h, @@pair_1d, @@pair_7d;
  ListAccum<STRING> @@request_types, @@request_ids;
  ListAccum<UINT> @@request_seqs, @@request_times;
  ListAccum<AssociationRow> @@associations;
  MaxAccum<UINT> @@peer_first_ms;
  OrAccum @@peer_external, @@peer_deposit;
  VERTEX root;
  VERTEX event_vertex;
  VERTEX peer_vertex;
  UINT seed_seq = 0;
  UINT seed_ts_ms = 0;
  UINT state_seq = 0;
  UINT age_ms = 0;
  UINT gap_ms = 0;
  DOUBLE incoming_amount = 0.0;
  DOUBLE outgoing_amount = 0.0;
  DOUBLE amount_ratio = 0.0;
  STRING recipient_type = "";
  STRING recipient_id = "";
  STRING peer_type = "";
  STRING peer_id = "";
  STRING event_key = "";
  INT taken = 0;

  @@request_ids = node_ids;
  @@request_types = node_types;
  @@request_seqs = cutoff_seqs;
  @@request_times = cutoff_times;
  IF @@request_ids.size() < 1 OR @@request_ids.size() > 16 OR
     @@request_types.size() != @@request_ids.size() OR @@request_seqs.size() != @@request_ids.size()
     OR @@request_times.size() != @@request_ids.size() OR per_relation < 1 OR per_relation > 8 THEN
    PRINT "invalid_parameters" AS status;
    RETURN;
  END;
  IF visibility_phase < 1 OR visibility_phase > 3 THEN
    PRINT "invalid_visibility_phase" AS status; RETURN;
  END;
  IF scope_id != "" THEN
    ScopeCatalog = {Temporal_Training_Scope.*};
    RequestedScope = SELECT r FROM ScopeCatalog:r WHERE r.scope_id == scope_id AND r.ready;
    IF RequestedScope.size() != 1 THEN PRINT "scope_not_ready" AS status; RETURN; END;
  END;
  FOREACH i IN RANGE[0, @@request_ids.size()-1] DO
    IF @@request_seqs.get(i) == 0 OR @@request_times.get(i) == 0 OR
       (@@request_types.get(i) != "Account" AND @@request_types.get(i) != "Token" AND
        @@request_types.get(i) != "Party" AND @@request_types.get(i) != "Device" AND
        @@request_types.get(i) != "IP" AND @@request_types.get(i) != "Address") THEN
      PRINT "invalid_request" AS status, i AS request_index;
      RETURN;
    END;
    root = to_vertex(@@request_ids.get(i), @@request_types.get(i));
    seed_seq = @@request_seqs.get(i);
    state_seq = seed_seq - 1;
    seed_ts_ms = @@request_times.get(i);
    @@features.clear(); @@distinct.clear(); @@messages.clear(); @@events.clear();
    @@age_encoding.clear(); @@gap_encoding.clear();
    @@out_last = 0; @@in_last = 0; @@invalid = FALSE;
    @@zelle_out.clear(); @@zelle_in.clear();
    @@payment_out.clear(); @@payment_in.clear();
    Roots = {root};
    IF scope_id != "" THEN
      RootScope = SELECT s FROM Roots:s -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM s.@scope_allowed += TRUE;
    END;
    Visible = SELECT s FROM Roots:s
      WHERE s.getAttr("first_seen_seq", "UINT") <= seed_seq
        AND s.getAttr("first_seen_ts_ms", "UINT") <= seed_ts_ms
        AND (scope_id == "" OR (@@request_types.get(i) != "Account" AND @@request_types.get(i) != "Party") OR s.@scope_allowed);
    IF Visible.size() == 0 THEN
      PRINT "invisible_entity" AS status, i AS request_index;
      RETURN;
    END;
    Metadata = SELECT s FROM Visible:s
      ACCUM @@features += ("age_days" ->
        (seed_ts_ms - s.getAttr("first_seen_ts_ms", "UINT")) / 86400000.0);
    IF @@request_types.get(i) == "Account" THEN
      MetaAccount = SELECT s FROM Visible:s
        ACCUM IF s.getAttr("is_external", "BOOL") THEN @@features += ("is_external" -> 1) END,
          IF s.getAttr("account_type", "STRING") == "deposit" THEN @@features += ("is_deposit" -> 1) END;
    END;
    Candidates_zelle_out = SELECT t FROM Visible:s -((Account_Sent_Zelle_Transfer>|Token_Sent_Transfer>):e)- Zelle_Transfer:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms;
    IF scope_id != "" THEN
      Endpoints_zelle_out = SELECT a FROM Candidates_zelle_out:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_zelle_out = SELECT v FROM Endpoints_zelle_out:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_zelle_out = SELECT t FROM Candidates_zelle_out:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Events_zelle_out = SELECT t FROM Visible:s -((Account_Sent_Zelle_Transfer>|Token_Sent_Transfer>):e)- Zelle_Transfer:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
            AND NOT t.@scope_blocked
            ACCUM @@invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0) OR t.currency != "USD"),
            @@zelle_out += EventRow(t.event_seq, t.event_ts_ms, t.transfer_id, "Zelle_Transfer",
                   "zelle_out", "zelle", t.amount, t.amount_present),
            @@out_last += t.event_ts_ms,
            IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_out_count" -> 1),
              @@features += ("1h_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_out_missing" -> 1) END,
              @@features += ("1h_out_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_out_count" -> 1),
              @@features += ("1d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_out_missing" -> 1) END,
              @@features += ("1d_out_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_out_count" -> 1),
              @@features += ("7d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_out_missing" -> 1) END,
              @@features += ("7d_out_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_out_count" -> 1),
              @@features += ("30d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_out_missing" -> 1) END,
              @@features += ("30d_out_zelle" -> 1)
            END;
    Unique_zelle_out_Account = SELECT t FROM Events_zelle_out:t -(Transfer_To_Account>:e)- Account:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_out_unique" -> "Account:" + p.id) END;
    Unique_zelle_out_Token = SELECT t FROM Events_zelle_out:t -(Transfer_To_Token>:e)- Token:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transfer_To_Account") == 0
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_out_unique" -> "Token:" + p.token_id) END;
    taken = 0;
        WHILE @@zelle_out.size() > 0 AND taken < per_relation DO
          @@events += @@zelle_out.pop();
          taken = taken + 1;
        END;
        Candidates_zelle_in = SELECT t FROM Visible:s -((Account_Received_Zelle_Transfer>|Token_Received_Transfer>):e)- Zelle_Transfer:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms;
    IF scope_id != "" THEN
      Endpoints_zelle_in = SELECT a FROM Candidates_zelle_in:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_zelle_in = SELECT v FROM Endpoints_zelle_in:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_zelle_in = SELECT t FROM Candidates_zelle_in:t -((Transfer_From_Account>|Transfer_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Events_zelle_in = SELECT t FROM Visible:s -((Account_Received_Zelle_Transfer>|Token_Received_Transfer>):e)- Zelle_Transfer:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
            AND NOT t.@scope_blocked
            ACCUM @@invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0) OR t.currency != "USD"),
            @@zelle_in += EventRow(t.event_seq, t.event_ts_ms, t.transfer_id, "Zelle_Transfer",
                   "zelle_in", "zelle", t.amount, t.amount_present),
            @@in_last += t.event_ts_ms,
            IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_in_count" -> 1),
              @@features += ("1h_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_in_missing" -> 1) END,
              @@features += ("1h_in_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_in_count" -> 1),
              @@features += ("1d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_in_missing" -> 1) END,
              @@features += ("1d_in_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_in_count" -> 1),
              @@features += ("7d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_in_missing" -> 1) END,
              @@features += ("7d_in_zelle" -> 1)
            END,
            IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_in_count" -> 1),
              @@features += ("30d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_in_missing" -> 1) END,
              @@features += ("30d_in_zelle" -> 1)
            END;
    Unique_zelle_in_Account = SELECT t FROM Events_zelle_in:t -(Transfer_From_Account>:e)- Account:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_in_unique" -> "Account:" + p.id) END;
    Unique_zelle_in_Token = SELECT t FROM Events_zelle_in:t -(Transfer_From_Token>:e)- Token:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transfer_From_Account") == 0
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_in_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_in_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_in_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_in_unique" -> "Token:" + p.token_id) END;
    taken = 0;
        WHILE @@zelle_in.size() > 0 AND taken < per_relation DO
          @@events += @@zelle_in.pop();
          taken = taken + 1;
        END;
        Candidates_payment_out = SELECT t FROM Visible:s -((Account_Initiated_Transaction>|Token_Sent_Transaction>):e)- Payment_Transaction:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms;
    IF scope_id != "" THEN
      Endpoints_payment_out = SELECT a FROM Candidates_payment_out:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_payment_out = SELECT v FROM Endpoints_payment_out:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_payment_out = SELECT t FROM Candidates_payment_out:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Events_payment_out = SELECT t FROM Visible:s -((Account_Initiated_Transaction>|Token_Sent_Transaction>):e)- Payment_Transaction:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
            AND NOT t.@scope_blocked
            ACCUM @@invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0) OR t.currency != "USD"),
            @@payment_out += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
                   "payment_out", t.payment_rail, t.amount, t.amount_present),
            @@out_last += t.event_ts_ms,
            IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_out_count" -> 1),
              @@features += ("1h_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_out_missing" -> 1) END,
              @@features += ("1h_out_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_out_count" -> 1),
              @@features += ("1d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_out_missing" -> 1) END,
              @@features += ("1d_out_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_out_count" -> 1),
              @@features += ("7d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_out_missing" -> 1) END,
              @@features += ("7d_out_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_out_count" -> 1),
              @@features += ("30d_out_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_out_missing" -> 1) END,
              @@features += ("30d_out_zelle" -> 0)
            END;
    Unique_payment_out_Account = SELECT t FROM Events_payment_out:t -(Transaction_To_Account>:e)- Account:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_out_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_out_unique" -> "Account:" + p.id) END;
    Unique_payment_out_Token = SELECT t FROM Events_payment_out:t -(Transaction_To_Token>:e)- Token:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transaction_To_Account") == 0
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_out_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_out_unique" -> "Token:" + p.token_id) END;
    taken = 0;
        WHILE @@payment_out.size() > 0 AND taken < per_relation DO
          @@events += @@payment_out.pop();
          taken = taken + 1;
        END;
        Candidates_payment_in = SELECT t FROM Visible:s -((Account_Received_Transaction>|Token_Received_Transaction>):e)- Payment_Transaction:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms;
    IF scope_id != "" THEN
      Endpoints_payment_in = SELECT a FROM Candidates_payment_in:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a;
    IF scope_id != "" THEN
      Scope_payment_in = SELECT v FROM Endpoints_payment_in:v -(Entity_In_Training_Scope>:membership)- Temporal_Training_Scope:r
        WHERE r.scope_id == scope_id AND r.ready AND membership.partition >= 1
          AND membership.partition <= visibility_phase
        ACCUM v.@scope_allowed += TRUE;
    END;
      Blocked_payment_in = SELECT t FROM Candidates_payment_in:t -((Transaction_From_Account>|Transaction_To_Account>):role)- Account:a
        WHERE NOT a.@scope_allowed ACCUM t.@scope_blocked += TRUE;
    END;
    Events_payment_in = SELECT t FROM Visible:s -((Account_Received_Transaction>|Token_Received_Transaction>):e)- Payment_Transaction:t
          WHERE t.event_seq < seed_seq AND t.event_ts_ms <= seed_ts_ms
            AND NOT t.@scope_blocked
            ACCUM @@invalid += (e.event_seq != t.event_seq OR e.event_ts_ms != t.event_ts_ms
              OR t.event_seq == 0 OR t.event_ts_ms == 0 OR t.amount < 0
              OR (NOT t.amount_present AND t.amount != 0) OR t.currency != "USD"),
            @@payment_in += EventRow(t.event_seq, t.event_ts_ms, t.transaction_id, "Payment_Transaction",
                   "payment_in", t.payment_rail, t.amount, t.amount_present),
            @@in_last += t.event_ts_ms,
            IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
              @@features += ("1h_in_count" -> 1),
              @@features += ("1h_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1h_in_missing" -> 1) END,
              @@features += ("1h_in_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
              @@features += ("1d_in_count" -> 1),
              @@features += ("1d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("1d_in_missing" -> 1) END,
              @@features += ("1d_in_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
              @@features += ("7d_in_count" -> 1),
              @@features += ("7d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("7d_in_missing" -> 1) END,
              @@features += ("7d_in_zelle" -> 0)
            END,
            IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
              @@features += ("30d_in_count" -> 1),
              @@features += ("30d_in_amount" -> t.amount),
              IF NOT t.amount_present THEN @@features += ("30d_in_missing" -> 1) END,
              @@features += ("30d_in_zelle" -> 0)
            END;
    Unique_payment_in_Account = SELECT t FROM Events_payment_in:t -(Transaction_From_Account>:e)- Account:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_in_unique" -> "Account:" + p.id) END,
 IF seed_ts_ms - t.event_ts_ms < 2592000000 THEN
            @@distinct += ("30d_in_unique" -> "Account:" + p.id) END;
    Unique_payment_in_Token = SELECT t FROM Events_payment_in:t -(Transaction_From_Token>:e)- Token:p
          WHERE e.event_seq == t.event_seq AND e.event_ts_ms == t.event_ts_ms AND t.outdegree("Transaction_From_Account") == 0
          ACCUM IF seed_ts_ms - t.event_ts_ms < 3600000 THEN
            @@distinct += ("1h_in_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 86400000 THEN
            @@distinct += ("1d_in_unique" -> "Token:" + p.token_id) END,
 IF seed_ts_ms - t.event_ts_ms < 604800000 THEN
            @@distinct += ("7d_in_unique" -> "Token:" + p.token_id) END,

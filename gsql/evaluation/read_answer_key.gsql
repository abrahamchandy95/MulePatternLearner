USE GRAPH Mule_Pattern_Learner

/* read_answer_key: the truth about every internal account, for evaluation only.

   Inputs: after_id and page, to read the accounts a page at a time by increasing id, 1 to
   10,000 a page.
   Prints: accounts, for the internal accounts with an id above after_id, at most page of
   them: is_mule (1 or 0); mule_ring_id, the ring of its first landing payment or the ring that
   recruited it, -1 for none; its activity period, mule_onset_ms and mule_last_ms; opened_ms;
   account_type; and owned, whether it has an ownership link at all.
   Refuses: invalid_parameters, for a page out of range.

   Evaluation builds its groups and early warning from every mule, identified or hidden, so it
   needs every mule's dates; opened_ms gives the group of accounts opened within 90 days of t,
   and owned the population check (docs/design.md, "read_answer_key"). The fetch executor
   refuses to run this query, and only evaluation and testing import its parser. */
CREATE OR REPLACE QUERY read_answer_key(
    STRING after_id,
    INT page
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    OrAccum @owned;

    IF page < 1 OR page > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Page = SELECT a FROM Account:a
      WHERE a.id > after_id AND NOT a.is_external
      ORDER BY a.id ASC
      LIMIT page;
    Owned = SELECT a FROM Page:a -(Account_Owned_By_Party>:o)- Party:q
      ACCUM a.@owned += TRUE;
    PRINT "ok" AS status;
    PRINT Page[Page.id AS account_id, Page.is_mule AS is_mule, Page.mule_ring_id AS mule_ring_id,
      Page.mule_onset_ms AS mule_onset_ms, Page.mule_last_ms AS mule_last_ms,
      Page.opened_ms AS opened_ms, Page.account_type AS account_type,
      Page.@owned AS owned] AS accounts;
}

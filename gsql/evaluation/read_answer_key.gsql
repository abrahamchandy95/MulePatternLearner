USE GRAPH Mule_Pattern_Learner

/* The answer key, for evaluation only, a page at a time by strictly increasing id
   (docs/design.md, "read_answer_key"): every internal account's truth (is_mule, 1 or 0),
   the ring of its first landing payment or the ring that recruited it (mule_ring_id, -1 for
   none) and its activity period (mule_onset_ms, mule_last_ms), whether or not the bank
   identified it, since evaluation builds its groups and early warning from every mule; and
   its opened_ms (for the group of accounts opened within 90 days of t), its account_type and
   whether it has an ownership link at all (owned, for the population check).

   The fetch executor refuses to run it, and only evaluation and testing import its parser.
   A page holds 1 to 10,000 accounts. */
CREATE OR REPLACE QUERY read_answer_key(
    STRING after_id,
    INT page
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    OrAccum @owned;

    IF page < 1 OR page > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Page = SELECT a FROM Account:a
      WHERE a.id > after_id AND NOT a.is_external
      ORDER BY a.id ASC
      LIMIT page;
    Owned = SELECT a FROM Page:a -(Account_Owned_By_Party>:o)- Party:q
      ACCUM a.@owned += TRUE;
    PRINT "ok" AS status, "read_answer_key-3d5467c23b01" AS version;
    PRINT Page[Page.id AS account_id, Page.is_mule AS is_mule, Page.mule_ring_id AS mule_ring_id,
      Page.mule_onset_ms AS mule_onset_ms, Page.mule_last_ms AS mule_last_ms,
      Page.opened_ms AS opened_ms, Page.account_type AS account_type,
      Page.@owned AS owned] AS accounts;
}

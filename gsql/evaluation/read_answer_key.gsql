USE GRAPH Mule_Pattern_Learner

/* The answer key, for evaluation only, a page at a time by id: each account's truth from
   PhantomLedger. is_mule is 1, 0, or -1 when unknown (an external account). */
CREATE OR REPLACE QUERY read_answer_key(
    STRING after_id,
    INT batch_size
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
    IF batch_size < 1 OR batch_size > 10000 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    Page = SELECT a FROM Account:a
      WHERE a.id > after_id
      ORDER BY a.id ASC
      LIMIT batch_size;
    PRINT "ok" AS status;
    PRINT Page[Page.id AS account_id, Page.is_mule AS is_mule,
      Page.mule_ring_id AS mule_ring_id, Page.mule_layer AS mule_layer,
      Page.mule_flow AS mule_flow, Page.mule_onset_ms AS mule_onset_ms,
      Page.mule_last_ms AS mule_last_ms, Page.discovered_ms AS discovered_ms] AS accounts;
}

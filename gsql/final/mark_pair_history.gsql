USE GRAPH Mule_Pattern_Learner
CREATE OR REPLACE QUERY mark_pair_history() FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {

    /* Constants */
    UINT LOOKBACK_MS = 7776000000; // 90 days

    /* Vertex and edge types, each a set so that one pattern serves transactions and transfers */
    SetAccum<STRING> @@payment_vertex_type; // A transaction or a transfer
    SetAccum<STRING> @@payment_to_sender_edge_type; // Payment -> the account that sent it
    SetAccum<STRING> @@payment_to_receiver_edge_type; // Payment -> the account that received it
    @@payment_vertex_type += "Payment_Transaction";
    @@payment_vertex_type += "Zelle_Transfer";
    @@payment_to_sender_edge_type += "Transaction_From_Account";
    @@payment_to_sender_edge_type += "Transfer_From_Account";
    @@payment_to_receiver_edge_type += "Transaction_To_Account";
    @@payment_to_receiver_edge_type += "Transfer_To_Account";

    /* Accumulators */
    MinAccum<VERTEX> @receiver; // On a payment: its receiver (a payment has one)
    MapAccum<VERTEX, ListAccum<UINT>> @times_paid; // On a sender: for each receiver, the times it paid that receiver
    SumAccum<INT> @prior_count; // On a payment: how many of those times are earlier and at most 90 days earlier
    MaxAccum<UINT> @prior_latest; // On a payment: the latest of them
    MinAccum<UINT> @prior_earliest; // On a payment: the earliest of them

    payments = {@@payment_vertex_type};

    /* Traverse: Payment -> its receiver, remembered on the payment */
    received = SELECT p
        FROM payments:p - (@@payment_to_receiver_edge_type>:g) - Account:b
        ACCUM
            p.@receiver += b
    ;

    /* Traverse: Payment -> its sender, which notes when it paid that receiver; self-payments aside */
    senders = SELECT a
        FROM received:p - (@@payment_to_sender_edge_type>:f) - Account:a
        WHERE a != p.@receiver
        ACCUM
            a.@times_paid += ( p.@receiver -> p.event_ts_ms )
    ;

    /* Traverse: Payment -> its sender, counting the times it paid the same receiver in the 90 days before */
    counted = SELECT p
        FROM received:p - (@@payment_to_sender_edge_type>:f) - Account:a
        WHERE a != p.@receiver
        ACCUM
            FOREACH ts IN a.@times_paid.get(p.@receiver) DO
                IF ts < p.event_ts_ms AND p.event_ts_ms - ts <= LOOKBACK_MS THEN
                    p.@prior_count += 1,
                    p.@prior_latest += ts,
                    p.@prior_earliest += ts
                END
            END
    ;

    /* Stamp every payment: the count, and the time since the latest and since the earliest */
    marked = SELECT p
        FROM payments:p
        POST-ACCUM
            p.pair_prior_count = p.@prior_count,
            p.pair_gap_ms = CASE WHEN p.@prior_count > 0 THEN p.event_ts_ms - p.@prior_latest ELSE 0 END,
            p.pair_age_ms = CASE WHEN p.@prior_count > 0 THEN p.event_ts_ms - p.@prior_earliest ELSE 0 END,
            p.pair_marked = TRUE
    ;

    /* Printing how many payments were marked */
    PRINT "ok" AS status, marked.size() AS marked;

}

USE GRAPH Mule_Pattern_Learner
CREATE OR REPLACE QUERY read_community_devices(
    UINT t_ms, // The scoring time after the first 90 days
    LIST<STRING> customer_ids // The ids of the customers to read
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {

    /* Tuples */
    TYPEDEF TUPLE<STRING node_id, UINT since_start_ms> Shared;

    /* Constants */
    UINT LOOKBACK_MS = 7776000000; // 90 days
    UINT MONTH_MS = 2592000000; // 30 days

    /* Vertex and edge types, each a set so that one pattern serves devices and IPs, transactions and transfers */
    SetAccum<STRING> @@node_vertex_type; // A device or an IP
    SetAccum<STRING> @@customer_to_node_edge_type; // Customer -> the devices and IPs it registered
    SetAccum<STRING> @@customer_to_account_edge_type; // Customer -> the accounts it owns
    SetAccum<STRING> @@sender_to_payment_edge_type; // Account -> the payments it sent
    SetAccum<STRING> @@payment_to_receiver_edge_type; // Payment -> the account that received it
    SetAccum<STRING> @@payment_to_node_edge_type; // Payment -> the devices and IPs it was seen on
    @@node_vertex_type += "Device";
    @@node_vertex_type += "IP";
    @@customer_to_node_edge_type += "Party_Uses_Device";
    @@customer_to_node_edge_type += "Party_Uses_IP";
    @@customer_to_account_edge_type += "Party_Owns_Account";
    @@sender_to_payment_edge_type += "Account_Initiated_Transaction";
    @@sender_to_payment_edge_type += "Account_Sent_Zelle_Transfer";
    @@payment_to_receiver_edge_type += "Transaction_To_Account";
    @@payment_to_receiver_edge_type += "Transfer_To_Account";
    @@payment_to_node_edge_type += "Transaction_Used_Device";
    @@payment_to_node_edge_type += "Transaction_Used_IP";
    @@payment_to_node_edge_type += "Transfer_Used_Device";
    @@payment_to_node_edge_type += "Transfer_Used_IP";

    /* Accumulators */
    SetAccum<Shared> @shared; // On a customer: the devices and IPs it shares, each with how long ago it began
    MaxAccum<STRING> @owner_id; // On a payment: the customer who sent it
    OrAccum @deposit_sender; // On a payment: it was sent from a deposit account
    SetAccum<STRING> @seen_on; // On a payment: the devices and IPs it was seen on
    MapAccum<STRING, SetAccum<STRING>> @@used; // Customer -> the devices and IPs, crowds aside, it used in the 30 days
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@first_start; // Customer -> device or IP -> its first registration or deposit payment on it
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@first_unseen; // Customer -> device or IP -> its first own payment not seen on it
    SetAccum<STRING> @@ids; // The customer ids, each once
    SumAccum<INT> @@given; // How many customer ids were given

    IF t_ms <= LOOKBACK_MS OR t_ms % 1000 != 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    FOREACH customer_id IN customer_ids DO
        @@ids += customer_id;
        @@given += 1;
    END;
    IF @@given == 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF @@ids.size() != @@given THEN
        PRINT "duplicate_customer" AS status;
        RETURN;
    END;
    customers = to_vertex_set(@@ids, "Party");
    IF customers.size() != @@ids.size() THEN
        PRINT "unknown_customer" AS status;
        RETURN;
    END;

    /* Traverse: Customer -> Device or IP, through a registration visible at t; it uses those still registered in the 30 days */
    registered = SELECT n
        FROM customers:q - (@@customer_to_node_edge_type>:l) - @@node_vertex_type:n
        WHERE l.valid_from_ms < t_ms
            AND ( l.valid_to_ms == 0 OR l.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            @@first_start += (q.id -> (n.id -> l.valid_from_ms)),
            IF ( l.valid_to_ms == 0 OR l.valid_to_ms > t_ms - MONTH_MS ) AND n.crowd_at_ms != t_ms THEN
                @@used += (q.id -> n.id)
            END
    ;

    /* Traverse: Customer -> Account -> Payment -> its receiver, its own payments of the 90 days, self-payments aside */
    own_sent = SELECT p
        FROM customers:q - (@@customer_to_account_edge_type>:w) - Account:b
            - (@@sender_to_payment_edge_type>:e) - _:p
            - (@@payment_to_receiver_edge_type>:f) - Account:r
        WHERE w.valid_from_ms < t_ms
            AND ( w.valid_to_ms == 0 OR w.valid_to_ms > t_ms - LOOKBACK_MS )
            AND b.opened_ms < t_ms
            AND p.event_ts_ms >= t_ms - LOOKBACK_MS AND p.event_ts_ms < t_ms AND r != b
        ACCUM
            p.@owner_id += q.id,
            p.@deposit_sender += b.account_type == "deposit"
    ;

    /* Traverse: Payment -> the devices and IPs it was seen on; it uses those its deposit payments were seen on in the 30 days */
    seen = SELECT n
        FROM own_sent:p - (@@payment_to_node_edge_type>:u) - @@node_vertex_type:n
        ACCUM
            p.@seen_on += n.id,
            IF p.@deposit_sender THEN
                @@first_start += (p.@owner_id -> (n.id -> p.event_ts_ms)),
                IF p.event_ts_ms >= t_ms - MONTH_MS AND n.crowd_at_ms != t_ms THEN
                    @@used += (p.@owner_id -> n.id)
                END
            END
    ;

    /* Each customer's first own payment not seen on each device and IP it uses */
    unseen = SELECT p
        FROM own_sent:p
        POST-ACCUM
            FOREACH n IN @@used.get(p.@owner_id) DO
                IF NOT p.@seen_on.contains(n) THEN
                    @@first_unseen += (p.@owner_id -> (n -> p.event_ts_ms))
                END
            END
    ;

    /* When each customer began sharing each device and IP: its first start when known, else the lookback's start, 90 days ago */
    listed = SELECT q
        FROM customers:q
        POST-ACCUM
            UINT start_ms = 0,
            BOOL known = FALSE,
            FOREACH n IN @@used.get(q.id) DO
                start_ms = @@first_start.get(q.id).get(n),
                known = start_ms > t_ms - LOOKBACK_MS
                    AND start_ms > q.joined_ms
                    AND @@first_unseen.get(q.id).containsKey(n)
                    AND @@first_unseen.get(q.id).get(n) < start_ms,
                IF known THEN
                    q.@shared += Shared(n, t_ms - start_ms)
                ELSE
                    q.@shared += Shared(n, LOOKBACK_MS)
                END
            END
    ;

    /* Refuse unless the crowd stamps on the graph are this t's */
    current_marks = SELECT m FROM Mark:m WHERE m.id == "crowds" AND m.at_ms == t_ms;
    IF current_marks.size() != 1 THEN
        PRINT "unmarked_time" AS status;
        RETURN;
    END;

    /* Printing the customers */
    PRINT "ok" AS status;
    PRINT customers[
        customers.id AS customer_id,
        customers.@shared AS shared
    ] AS customers;

}

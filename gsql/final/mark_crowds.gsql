USE GRAPH Mule_Pattern_Learner
CREATE OR REPLACE QUERY mark_crowds(
    UINT t_ms // The scoring time after the first 90 days
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {

    /* Constants */
    UINT LOOKBACK_MS = 7776000000; // 90 days
    INT CROWD_THRESHOLD = 8; // More customers than this make a device or IP a crowd
    INT HUB_THRESHOLD = 200; // More customers than this make it a hub

    /* Vertex and edge types, each a set so that one pattern serves devices and IPs, transactions and transfers */
    SetAccum<STRING> @@payment_vertex_type; // A transaction or a transfer
    SetAccum<STRING> @@node_vertex_type; // A device or an IP
    SetAccum<STRING> @@node_to_customer_edge_type; // Device or IP -> the customers who registered it
    SetAccum<STRING> @@node_to_payment_edge_type; // Device or IP -> the payments seen on it
    SetAccum<STRING> @@payment_to_node_edge_type; // Payment -> the devices and IPs it was seen on
    SetAccum<STRING> @@payment_to_sender_edge_type; // Payment -> the account that sent it
    SetAccum<STRING> @@account_to_owner_edge_type; // Account -> its owner
    @@payment_vertex_type += "Payment_Transaction";
    @@payment_vertex_type += "Zelle_Transfer";
    @@node_vertex_type += "Device";
    @@node_vertex_type += "IP";
    @@node_to_customer_edge_type += "Device_Used_By_Party";
    @@node_to_customer_edge_type += "IP_Used_By_Party";
    @@node_to_payment_edge_type += "Device_Used_By_Transaction";
    @@node_to_payment_edge_type += "Device_Used_By_Transfer";
    @@node_to_payment_edge_type += "IP_Observed_In_Transaction";
    @@node_to_payment_edge_type += "IP_Used_By_Transfer";
    @@payment_to_node_edge_type += "Transaction_Used_Device";
    @@payment_to_node_edge_type += "Transaction_Used_IP";
    @@payment_to_node_edge_type += "Transfer_Used_Device";
    @@payment_to_node_edge_type += "Transfer_Used_IP";
    @@payment_to_sender_edge_type += "Transaction_From_Account";
    @@payment_to_sender_edge_type += "Transfer_From_Account";
    @@account_to_owner_edge_type += "Account_Owned_By_Party";

    /* Accumulators */
    SetAccum<VERTEX<Party>> @customers; // A device's or IP's customers
    SetAccum<VERTEX<Party>> @registered; // Those of them who registered it
    SetAccum<VERTEX<Party>> @owner; // An account's owner; a payment's sender's owner
    SumAccum<INT> @customers_90d;
    OrAccum @observed_only, @hub;

    IF t_ms <= LOOKBACK_MS OR t_ms % 1000 != 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;

    nodes = {@@node_vertex_type};

    /* Traverse: Device or IP -> Party, through a registration visible at t */
    registered = SELECT n
        FROM nodes:n - (@@node_to_customer_edge_type>:l) - Party:q
        WHERE l.valid_from_ms < t_ms
            AND ( l.valid_to_ms == 0 OR l.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            n.@customers += q,
            n.@registered += q
    ;

    /* Traverse: Device or IP -> Payment, seen in the 90 days before t (the edge holds the time) */
    payments = SELECT p
        FROM nodes:n - (@@node_to_payment_edge_type>:u) - @@payment_vertex_type:p
        WHERE u.event_ts_ms >= t_ms - LOOKBACK_MS AND u.event_ts_ms < t_ms
    ;

    /* Traverse: Payment -> the deposit account that sent it, open by t */
    senders = SELECT a
        FROM payments:p - (@@payment_to_sender_edge_type>:f) - Account:a
        WHERE a.account_type == "deposit" AND a.opened_ms < t_ms
    ;

    /* Traverse: Account -> its owner, through an ownership visible at t */
    owners = SELECT q
        FROM senders:a - (@@account_to_owner_edge_type>:o) - Party:q
        WHERE o.valid_from_ms < t_ms
            AND ( o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            a.@owner += q
    ;

    /* Traverse back: Payment <- its sender's owner */
    payments = SELECT p
        FROM payments:p - (@@payment_to_sender_edge_type>:f) - Account:a
        ACCUM
            p.@owner += a.@owner
    ;

    /* Traverse back: Device or IP <- the owners of the payments seen on it */
    seen = SELECT n
        FROM payments:p - (@@payment_to_node_edge_type>:u) - @@node_vertex_type:n
        ACCUM
            n.@customers += p.@owner
    ;

    /* Clear the stamps an earlier run left at this t, so that only this run's crowds carry it */
    cleared = SELECT n FROM nodes:n WHERE n.crowd_at_ms == t_ms POST-ACCUM n.crowd_at_ms = 0;

    /* Stamp the crowds */
    crowds = SELECT n
        FROM nodes:n
        WHERE n.@customers.size() > CROWD_THRESHOLD
        POST-ACCUM
            n.crowd_at_ms = t_ms,
            n.@customers_90d += n.@customers.size(),
            n.@observed_only += n.@registered.size() == 0,
            n.@hub += n.@customers.size() > HUB_THRESHOLD
    ;
    device_crowds = SELECT n FROM crowds:n WHERE n.type == "Device";
    ip_crowds = SELECT n FROM crowds:n WHERE n.type == "IP";

    /* Record that the crowd stamps are t's */
    INSERT INTO Mark VALUES ("crowds", t_ms);

    /* Printing the crowds */
    PRINT "ok" AS status;
    PRINT device_crowds[
        device_crowds.id AS node_id,
        device_crowds.@customers_90d AS customers_90d,
        device_crowds.@observed_only AS observed_only,
        device_crowds.@hub AS hub
    ] AS devices;
    PRINT ip_crowds[
        ip_crowds.id AS node_id,
        ip_crowds.@customers_90d AS customers_90d,
        ip_crowds.@observed_only AS observed_only,
        ip_crowds.@hub AS hub
    ] AS ips;

}

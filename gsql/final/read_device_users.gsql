USE GRAPH Mule_Pattern_Learner
CREATE OR REPLACE QUERY read_device_users(
    UINT t_ms, // The scoring time after the first 90 days
    LIST<STRING> node_ids // The ids of the devices and IPs to read
) FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {

    /* Tuples */
    TYPEDEF TUPLE<
        STRING customer_id,
        BOOL linked,
        BOOL since_start_present,
        UINT since_start_ms,
        BOOL since_last_seen_present,
        UINT since_last_seen_ms,
        UINT since_evidence_ms
    > User;
    TYPEDEF TUPLE<
        STRING account_id,
        STRING customer_id,
        BOOL deposit,
        INT uses_90d,
        BOOL since_first_use_present,
        UINT since_first_use_ms,
        UINT since_last_use_ms
    > Sender;

    /* Constants */
    UINT LOOKBACK_MS = 7776000000; // 90 days

    /* Vertex and edge types, each a set so that one pattern serves devices and IPs, transactions and transfers */
    SetAccum<STRING> @@node_vertex_type; // A device or an IP
    SetAccum<STRING> @@node_to_customer_edge_type; // Device or IP -> the customers who registered it
    SetAccum<STRING> @@node_to_payment_edge_type; // Device or IP -> the payments seen on it
    SetAccum<STRING> @@payment_to_node_edge_type; // Payment -> the devices and IPs it was seen on
    SetAccum<STRING> @@payment_to_sender_edge_type; // Payment -> the account that sent it
    SetAccum<STRING> @@payment_to_receiver_edge_type; // Payment -> the account that received it
    SetAccum<STRING> @@account_to_owner_edge_type; // Account -> its owner
    SetAccum<STRING> @@owner_to_account_edge_type; // Customer -> the accounts it owns
    SetAccum<STRING> @@sender_to_payment_edge_type; // Account -> the payments it sent
    @@node_vertex_type += "Device";
    @@node_vertex_type += "IP";
    @@node_to_customer_edge_type += "Device_Used_By_Party";
    @@node_to_customer_edge_type += "IP_Used_By_Party";
    @@node_to_payment_edge_type += "Device_Used_By_Transaction";
    @@node_to_payment_edge_type += "Device_Used_By_Transfer";
    @@node_to_payment_edge_type += "IP_Observed_In_Transaction";
    @@node_to_payment_edge_type += "IP_Used_By_Transfer";
    @@payment_to_node_edge_type += "Transaction_Used_Device";
    @@payment_to_node_edge_type += "Transaction_Used_IP";
    @@payment_to_node_edge_type += "Transfer_Used_Device";
    @@payment_to_node_edge_type += "Transfer_Used_IP";
    @@payment_to_sender_edge_type += "Transaction_From_Account";
    @@payment_to_sender_edge_type += "Transfer_From_Account";
    @@payment_to_receiver_edge_type += "Transaction_To_Account";
    @@payment_to_receiver_edge_type += "Transfer_To_Account";
    @@account_to_owner_edge_type += "Account_Owned_By_Party";
    @@owner_to_account_edge_type += "Party_Owns_Account";
    @@sender_to_payment_edge_type += "Account_Initiated_Transaction";
    @@sender_to_payment_edge_type += "Account_Sent_Zelle_Transfer";

    /* Accumulators */
    SetAccum<User> @users; // A device's or IP's customers
    SetAccum<Sender> @accounts; // A device's or IP's sending accounts
    MaxAccum<STRING> @receiver_id; // A payment's receiver
    MaxAccum<STRING> @owner_id; // A payment's sender's owner
    OrAccum @deposit_sender; // A customer's payment sent from a deposit account
    SetAccum<STRING> @seen_on; // The devices and IPs a payment was seen on
    MapAccum<STRING, SetAccum<STRING>> @@node_users; // Each node's customers
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@link_start; // Each link's earliest start
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@known_link_start; // The known link starts
    MapAccum<STRING, SetAccum<STRING>> @@node_senders; // Each node's sending accounts
    MapAccum<STRING, SetAccum<STRING>> @@first_use_known; // An account's nodes of known first use
    MapAccum<STRING, MapAccum<STRING, SumAccum<INT>>> @@uses; // An account's payments on each node
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@first_use; // Its first payment on each
    MapAccum<STRING, MapAccum<STRING, MaxAccum<UINT>>> @@last_use; // Its last payment on each
    MapAccum<STRING, MaxAccum<STRING>> @@owner_of; // An account's owner
    SetAccum<STRING> @@seen_account_ids; // The accounts that paid from a node
    SetAccum<STRING> @@deposit_senders; // Those of them that are deposit accounts
    MapAccum<STRING, MinAccum<UINT>> @@first_own; // A customer's first own payment
    MapAccum<STRING, SetAccum<STRING>> @@own_seen; // The nodes its own payments were seen on
    MapAccum<STRING, MapAccum<STRING, MaxAccum<UINT>>> @@last_seen; // Its last own payment on each
    MapAccum<STRING, MapAccum<STRING, MaxAccum<UINT>>> @@deposit_last_use; // Same, deposits alone
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@deposit_first_use; // First deposit use
    MapAccum<STRING, MapAccum<STRING, MinAccum<UINT>>> @@first_unseen; // First payment not seen there
    SetAccum<STRING> @@ids; // The node ids, each once
    SumAccum<INT> @@given; // How many node ids were given

    IF t_ms <= LOOKBACK_MS OR t_ms % 1000 != 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    FOREACH node_id IN node_ids DO
        @@ids += node_id;
        @@given += 1;
    END;
    IF @@given == 0 THEN
        PRINT "invalid_parameters" AS status;
        RETURN;
    END;
    IF @@ids.size() != @@given THEN
        PRINT "duplicate_node" AS status;
        RETURN;
    END;
    devices_listed = to_vertex_set(@@ids, "Device");
    ips_listed = to_vertex_set(@@ids, "IP");
    nodes_listed = devices_listed UNION ips_listed;
    IF nodes_listed.size() != @@ids.size() THEN
        PRINT "unknown_node" AS status;
        RETURN;
    END;

    /* Keep the devices and IPs that are not crowds at t */
    open_nodes = SELECT d FROM nodes_listed:d WHERE d.crowd_at_ms != t_ms;

    /* Traverse: Device or IP -> Payment -> Account, the receivers of its payments of the 90 days */
    open_receivers = SELECT p
        FROM open_nodes:d - (@@node_to_payment_edge_type>:u) - _:p
            - (@@payment_to_receiver_edge_type>:f) - Account:r
        WHERE d.crowd_at_ms != t_ms
            AND p.event_ts_ms >= t_ms - LOOKBACK_MS AND p.event_ts_ms < t_ms
        ACCUM
            p.@receiver_id += r.id
    ;

    /* Traverse: Device or IP -> Party, through a registration visible at t */
    link_users = SELECT q
        FROM open_nodes:d - (@@node_to_customer_edge_type>:l) - Party:q
        WHERE d.crowd_at_ms != t_ms AND l.valid_from_ms < t_ms
            AND ( l.valid_to_ms == 0 OR l.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            @@link_start += (q.id -> (d.id -> l.valid_from_ms)),
            @@node_users += (d.id -> q.id)
    ;

    /* Traverse: Device or IP -> Payment -> Account -> Party, the owners of its payments' senders */
    seen_users = SELECT q
        FROM open_nodes:d - (@@node_to_payment_edge_type>:u) - _:p
            - (@@payment_to_sender_edge_type>:f) - Account:b
            - (@@account_to_owner_edge_type>:o) - Party:q
        WHERE d.crowd_at_ms != t_ms
            AND p.event_ts_ms >= t_ms - LOOKBACK_MS AND p.event_ts_ms < t_ms
            AND b.opened_ms < t_ms AND b.id != p.@receiver_id
            AND o.valid_from_ms < t_ms
            AND ( o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            @@owner_of += (b.id -> q.id),
            IF b.account_type == "deposit" THEN @@node_users += (d.id -> q.id) END
    ;

    /* Traverse: Device or IP -> Payment -> Account, the senders of its payments of the 90 days */
    open_activity = SELECT d
        FROM open_nodes:d - (@@node_to_payment_edge_type>:u) - _:p
            - (@@payment_to_sender_edge_type>:f) - Account:b
        WHERE d.crowd_at_ms != t_ms
            AND p.event_ts_ms >= t_ms - LOOKBACK_MS AND p.event_ts_ms < t_ms
            AND b.id != p.@receiver_id
        ACCUM
            @@uses += (b.id -> (d.id -> 1)),
            @@first_use += (b.id -> (d.id -> p.event_ts_ms)),
            @@last_use += (b.id -> (d.id -> p.event_ts_ms)),
            @@node_senders += (d.id -> b.id),
            @@seen_account_ids += b.id,
            IF b.account_type == "deposit" THEN @@deposit_senders += b.id END
    ;

    /* Traverse: Party -> Account -> Payment -> Account, own payments of the 90 days, self-payments aside */
    customers = link_users UNION seen_users;
    owner_sent = SELECT p
        FROM customers:q - (@@owner_to_account_edge_type>:w) - Account:b
            - (@@sender_to_payment_edge_type>:e) - _:p
            - (@@payment_to_receiver_edge_type>:f) - Account:r
        WHERE w.valid_from_ms < t_ms
            AND ( w.valid_to_ms == 0 OR w.valid_to_ms > t_ms - LOOKBACK_MS )
            AND b.opened_ms < t_ms
            AND p.event_ts_ms >= t_ms - LOOKBACK_MS AND p.event_ts_ms < t_ms AND r != b
        ACCUM
            p.@owner_id += q.id,
            p.@deposit_sender += b.account_type == "deposit",
            @@first_own += (q.id -> p.event_ts_ms)
    ;

    /* Traverse: Payment -> the devices and IPs it was seen on */
    owner_seen = SELECT n
        FROM owner_sent:p - (@@payment_to_node_edge_type>:u) - @@node_vertex_type:n
        ACCUM
            p.@seen_on += n.id,
            @@own_seen += (p.@owner_id -> n.id),
            @@last_seen += (p.@owner_id -> (n.id -> p.event_ts_ms)),
            IF p.@deposit_sender THEN
                @@deposit_first_use += (p.@owner_id -> (n.id -> p.event_ts_ms)),
                @@deposit_last_use += (p.@owner_id -> (n.id -> p.event_ts_ms))
            END
    ;

    /* Find each customer's first own payment not seen on each of its nodes */
    owner_unseen = SELECT p
        FROM owner_sent:p
        POST-ACCUM
            FOREACH n IN @@own_seen.get(p.@owner_id) DO
                IF NOT p.@seen_on.contains(n) THEN
                    @@first_unseen += (p.@owner_id -> (n -> p.event_ts_ms))
                END
            END
    ;

    /* Keep the link starts that are known */
    owner_starts = SELECT q
        FROM customers:q
        POST-ACCUM
            UINT unseen_ms = 0,
            BOOL found = FALSE,
            FOREACH (n, start_ms) IN @@link_start.get(q.id) DO
                IF @@own_seen.get(q.id).contains(n) THEN
                    found = @@first_unseen.get(q.id).containsKey(n),
                    unseen_ms = @@first_unseen.get(q.id).get(n)
                ELSE
                    found = @@first_own.containsKey(q.id),
                    unseen_ms = @@first_own.get(q.id)
                END,
                IF start_ms > t_ms - LOOKBACK_MS AND start_ms > q.joined_ms
                    AND found AND unseen_ms < start_ms THEN
                    @@known_link_start += (q.id -> (n -> start_ms))
                END
            END
    ;

    /* Traverse: Account -> Party, through an ownership visible at t, keeping known first uses */
    seen_accounts = to_vertex_set(@@seen_account_ids, "Account");
    first_uses = SELECT a
        FROM seen_accounts:a - (@@account_to_owner_edge_type>:o) - Party:q
        WHERE a.opened_ms < t_ms AND o.valid_from_ms < t_ms
            AND ( o.valid_to_ms == 0 OR o.valid_to_ms > t_ms - LOOKBACK_MS )
        ACCUM
            UINT unseen_ms = 0,
            BOOL found = FALSE,
            FOREACH (n, start_ms) IN @@first_use.get(a.id) DO
                IF @@own_seen.get(q.id).contains(n) THEN
                    found = @@first_unseen.get(q.id).containsKey(n),
                    unseen_ms = @@first_unseen.get(q.id).get(n)
                ELSE
                    found = @@first_own.containsKey(q.id),
                    unseen_ms = @@first_own.get(q.id)
                END,
                IF start_ms > t_ms - LOOKBACK_MS AND start_ms > q.joined_ms
                    AND found AND unseen_ms < start_ms THEN
                    @@first_use_known += (a.id -> n)
                END
            END
    ;

    /* List each device's or IP's customers */
    user_rows = SELECT d
        FROM open_nodes:d
        POST-ACCUM
            BOOL start_present = FALSE,
            UINT start_ms = 0,
            BOOL seen_present = FALSE,
            UINT seen_ms = 0,
            UINT evidence = 0,
            FOREACH c IN @@node_users.get(d.id) DO
                start_present = @@known_link_start.get(c).containsKey(d.id),
                start_ms = 0,
                IF start_present THEN start_ms = t_ms - @@known_link_start.get(c).get(d.id) END,
                seen_present = @@last_seen.get(c).containsKey(d.id),
                seen_ms = 0,
                IF seen_present THEN seen_ms = t_ms - @@last_seen.get(c).get(d.id) END,
                evidence = t_ms - LOOKBACK_MS,
                IF @@known_link_start.get(c).containsKey(d.id)
                    AND @@known_link_start.get(c).get(d.id) > evidence THEN
                    evidence = @@known_link_start.get(c).get(d.id)
                END,
                IF @@deposit_last_use.get(c).containsKey(d.id)
                    AND @@deposit_last_use.get(c).get(d.id) > evidence THEN
                    evidence = @@deposit_last_use.get(c).get(d.id)
                END,
                d.@users += User(c, @@link_start.get(c).containsKey(d.id), start_present, start_ms,
                    seen_present, seen_ms, t_ms - evidence)
            END
    ;

    /* List each device's or IP's sending accounts */
    sender_rows = SELECT d
        FROM open_nodes:d
        POST-ACCUM
            BOOL first_present = FALSE,
            UINT first_ms = 0,
            FOREACH b IN @@node_senders.get(d.id) DO
                first_present = @@first_use_known.get(b).contains(d.id),
                first_ms = 0,
                IF first_present THEN first_ms = t_ms - @@first_use.get(b).get(d.id) END,
                d.@accounts += Sender(b, @@owner_of.get(b), @@deposit_senders.contains(b),
                    @@uses.get(b).get(d.id), first_present, first_ms,
                    t_ms - @@last_use.get(b).get(d.id))
            END
    ;

    /* Refuse unless the crowd stamps on the graph are this t's */
    current_marks = SELECT m FROM Mark:m WHERE m.id == "crowds" AND m.at_ms == t_ms;
    IF current_marks.size() != 1 THEN
        PRINT "unmarked_time" AS status;
        RETURN;
    END;

    /* Printing the devices and IPs */
    PRINT "ok" AS status;
    PRINT nodes_listed[
        nodes_listed.id AS node_id,
        nodes_listed.@users AS users,
        nodes_listed.@accounts AS accounts
    ] AS nodes;

}

USE GRAPH Mule_Pattern_Learner

/* Fixed, non-learned temporal features. Units: milliseconds in, seconds inside.
   u = log(1 + dt_seconds) / log(1 + 400 days in seconds), without clipping.
   f_i = 0.125 * 16^(i/31) cycles per unit u, i=0..31.
   Output order: sin(f_0*2*pi*u), cos(f_0*2*pi*u), ..., sin_31, cos_31.
   Sequential append is intentional: concurrent ACCUM appends scramble axes.
*/
CREATE OR REPLACE QUERY temporal_fourier64_values(UINT delta_t_ms)
FOR GRAPH Mule_Pattern_Learner RETURNS (ListAccum<DOUBLE>) SYNTAX V2 {
  ListAccum<DOUBLE> @@encoding;
  DOUBLE elapsed_seconds = delta_t_ms / 1000.0;
  DOUBLE u = log(1.0 + elapsed_seconds) / log(1.0 + 34560000.0);
  DOUBLE frequency = 0.0;
  DOUBLE angle = 0.0;
  FOREACH i IN RANGE[0, 31] DO
    frequency = 0.125 * pow(16.0, i / 31.0);
    angle = 6.283185307179586 * frequency * u;
    @@encoding += sin(angle);
    @@encoding += cos(angle);
  END;
  RETURN @@encoding;
}

CREATE OR REPLACE QUERY temporal_fourier64(INT delta_t_ms = 0)
FOR GRAPH Mule_Pattern_Learner SYNTAX V2 {
  ListAccum<DOUBLE> @@encoding;
  IF delta_t_ms < 0 THEN
    PRINT "invalid_delta_t" AS status;
    RETURN;
  END;
  @@encoding = temporal_fourier64_values(delta_t_ms);
  PRINT "ok" AS status,
        "log1p_s_400d_32x_sincos_v1" AS basis_id,
        delta_t_ms AS delta_t_ms,
        @@encoding.size() AS dimensions,
        @@encoding AS time_encoding;
}
